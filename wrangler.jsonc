{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "healing-the-heart",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "healing-the-heart",
      "database_id": "a2069127-6d50-4cc1-9759-db630c38c29f"
    }
  ],
  "vars": {
    "SITE_URL": "https://healingtheheart.ca",
    "FROM_EMAIL": "Healing the Heart <healingtheheart.ca@gmail.com>",
    "CONTACT_EMAIL": "healingtheheart.ca@gmail.com",
    "MONERIS_STORE_ID": "store1",
    "MONERIS_CHECKOUT_ID": "chkt6TAH6tore1",
    "MONERIS_ENV": "qa"
  }
}
