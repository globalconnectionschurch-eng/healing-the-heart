---
import BaseLayout from '../../layouts/BaseLayout.astro';
const classId = String(Astro.params.id ?? '');
---
<BaseLayout title="Private Class Student List | Healing the Heart">
  <main class="roster-page" data-class-id={classId}>
    <link rel="stylesheet" href="/roster-redesign.css" />
    <section class="roster-card" id="gate">
      <div class="heart-mark" aria-hidden="true">♡</div>
      <p class="eyebrow">Private class page</p>
      <h1>Welcome to the class roster</h1>
      <p>Enter the password provided by the Healing the Heart team to view the current registered students.</p>
      <form id="access-form">
        <label>Password<input id="password" type="password" autocomplete="current-password" required /></label>
        <button class="button primary" type="submit">View student list</button>
        <p id="access-error" class="error"></p>
      </form>
    </section>
    <section class="roster-content" id="roster" hidden>
      <div class="roster-header">
        <div>
          <p class="eyebrow">Private roster</p>
          <h1 id="class-title"></h1>
          <p id="class-meta"></p>
        </div>
        <button class="button outline" id="refresh" type="button">Refresh list</button>
      </div>
      <p class="privacy-note"><strong>Private information</strong><br />This page contains registration details. Please share the link and password only with people who need access.</p>
      <div class="participants-heading">
        <div><p class="eyebrow">Participants</p><h2>Registered students</h2></div>
        <p class="muted" id="participant-count"></p>
      </div>
      <p class="roster-hint">Select a name to view their registration details.</p>
      <div id="student-cards"></div>
    </section>
  </main>
  <style>
    .roster-page{max-width:1100px;margin:0 auto;padding:5rem 1.5rem 7rem}.roster-card{max-width:560px;margin:5rem auto;padding:2.75rem;border:1px solid var(--line,#ddd);border-radius:28px;background:#fff;box-shadow:0 20px 60px rgba(0,0,0,.06)}.heart-mark{width:48px;height:48px;display:grid;place-items:center;border-radius:50%;background:#f5f0eb;font-size:1.8rem;margin-bottom:1.5rem}.roster-card h1,.roster-header h1{margin:.25rem 0 1rem}.roster-card form{display:grid;gap:1rem;margin-top:2rem}.roster-card input{width:100%;box-sizing:border-box;margin-top:.4rem;padding:.9rem 1rem;border:1px solid #ccc;border-radius:10px}.error{color:#9b2c2c;min-height:1.3rem}.roster-header{display:flex;justify-content:space-between;gap:2rem;align-items:flex-end;margin-bottom:1.5rem}.privacy-note{padding:1.1rem 1.3rem;border-radius:14px;background:#f5f3ef;margin-bottom:2.5rem;line-height:1.55}.participants-heading{display:flex;justify-content:space-between;align-items:end;gap:1rem}.participants-heading h2{margin:.2rem 0 0}.roster-hint{margin:.4rem 0 1.25rem;color:#777}.student-card{border:1px solid #ddd;border-radius:18px;margin-bottom:.8rem;background:#fff;overflow:hidden;transition:box-shadow .2s,border-color .2s}.student-card:hover{border-color:#c8c0b8;box-shadow:0 8px 25px rgba(0,0,0,.05)}.student-card summary{cursor:pointer;list-style:none;padding:1.2rem 1.35rem;font-size:1.08rem;font-weight:650;display:flex;align-items:center;justify-content:space-between;gap:1rem}.student-card summary::-webkit-details-marker{display:none}.student-card summary::after{content:'+';width:28px;height:28px;display:grid;place-items:center;border:1px solid #ddd;border-radius:50%;font-size:1.1rem;font-weight:400;opacity:.7;flex:0 0 auto}.student-card[open]{border-color:#c8c0b8;box-shadow:0 10px 30px rgba(0,0,0,.06)}.student-card[open] summary{border-bottom:1px solid #eee}.student-card[open] summary::after{content:'−'}.student-details{padding:1.35rem}.student-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.student-field{line-height:1.5;padding:.85rem 1rem;border-radius:12px;background:#faf9f7}.student-field small{display:block;text-transform:uppercase;letter-spacing:.08em;font-size:.68rem;opacity:.6;margin-bottom:.2rem}.student-wide{grid-column:1/-1}.empty{padding:2rem;border:1px dashed #ccc;border-radius:16px}.muted{opacity:.7}@media(max-width:700px){.roster-page{padding-top:3rem}.roster-card{margin:2rem auto;padding:1.6rem}.roster-header{align-items:flex-start;flex-direction:column}.participants-heading{align-items:flex-start;flex-direction:column}.student-grid{grid-template-columns:1fr}.student-wide{grid-column:auto}}
  </style>
  <script is:inline>
    const page=document.querySelector('.roster-page');const classId=page?.getAttribute('data-class-id')||'';const gate=document.querySelector('#gate');const roster=document.querySelector('#roster');const form=document.querySelector('#access-form');const error=document.querySelector('#access-error');const cards=document.querySelector('#student-cards');const count=document.querySelector('#participant-count');const esc=(v)=>String(v??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',"'":'&#39;'}[c]));const fields=[['email','Email'],['phone','Phone'],['address','Address'],['date_of_birth','Date of birth'],['marital_status','Marital status'],['church','Church'],['sr_pastor','Senior pastor'],['how_heard','How they heard about HTH'],['goals','What they hope to gain'],['smoking_drinking','Smoking / drinking concern'],['anything_else','Additional information'],['payment_status','Payment status'],['registered_at','Registered']];
    async function load(){const r=await fetch('/api/class-students/'+encodeURIComponent(classId));if(!r.ok){gate.hidden=false;roster.hidden=true;error.textContent='Your access has expired. Please enter the password again.';return}const d=await r.json();document.querySelector('#class-title').textContent=d.class?.title||'Class roster';document.querySelector('#class-meta').textContent=[d.class?.startDate&&`${d.class.startDate} – ${d.class.endDate}`,d.class?.schedule,d.class?.locationName,d.class?.locationAddress].filter(Boolean).join(' · ');const students=d.students||[];count.textContent=`${students.length} ${students.length===1?'participant':'participants'}`;cards.innerHTML=students.length?students.map(s=>`<details class="student-card"><summary><span>${esc(s.name)}</span></summary><div class="student-details"><div class="student-grid">${fields.map(([key,label])=>`<div class="student-field ${['goals','anything_else'].includes(key)?'student-wide':''}"><small>${label}</small><div>${esc(s[key]||'—')}</div></div>`).join('')}</div></div></details>`).join(''):'<div class="empty">No registered students yet.</div>'}
    form?.addEventListener('submit',async e=>{e.preventDefault();error.textContent='Checking…';try{const r=await fetch('/api/class-students/'+encodeURIComponent(classId)+'/access',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({password:document.querySelector('#password').value})});const d=await r.json().catch(()=>({}));if(!r.ok){error.textContent=d.error||'Unable to verify password.';return}error.textContent='';gate.hidden=true;roster.hidden=false;await load()}catch{error.textContent='Unable to connect. Please try again.'}});document.querySelector('#refresh')?.addEventListener('click',load);
  </script>
</BaseLayout>