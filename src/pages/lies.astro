---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Lie → Need Tool | Healing the Heart" description="A guided Healing the Heart reflection tool to help identify what may have been touched, possible lies, unmet emotional needs, and next steps.">
  <section class="page-hero lies-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">Healing tool</p>
      <h1>What got touched?</h1>
      <p>Start with one lie, thought, trigger, or brief situation. This tool helps you slow it down, identify what may be underneath it, and move toward truth.</p>
    </div>
  </section>

  <section class="section lies-section">
    <div class="lie-tool">
      <div class="tool-intro">
        <div>
          <p class="eyebrow">Lie → Need</p>
          <h2>Put words to what happened.</h2>
          <p>Keep it short and focused. You can enter a lie you are believing or describe a moment that stirred a strong reaction.</p>
        </div>
        <div class="tool-note"><span>01</span><p>One trigger at a time usually gives the clearest result.</p></div>
      </div>

      <div class="input-card">
        <label for="mainText">What are you believing, thinking, or reacting to?</label>
        <textarea id="mainText" rows="5" maxlength="250" placeholder='Examples: "I am unseen" or "I cleaned up and nobody thanked me"'></textarea>
        <div class="input-footer">
          <span class="input-hint">Press Enter to analyze • Shift + Enter for a new line</span>
          <span id="charCounter">0 / 250</span>
        </div>
        <div class="tool-actions">
          <button id="analyzeBtn" class="button primary" type="button">Analyze this</button>
          <button id="clearBtn" class="button outline" type="button">Clear</button>
        </div>
        <div id="status" class="status" aria-live="polite" hidden></div>
      </div>

      <div id="results" class="results" hidden>
        <div class="results-heading">
          <div>
            <p class="eyebrow">Your reflection</p>
            <h2>Look at the heart beneath the reaction.</h2>
          </div>
          <div id="needPills" class="need-pills" aria-label="Likely emotional needs"></div>
        </div>

        <section class="result-card result-card-main">
          <div class="result-number">01</div>
          <div class="result-body">
            <p class="result-kicker">What may have been touched</p>
            <h3 id="touchedText">—</h3>
            <div class="result-subsection">
              <span class="sub-label">Possible feelings</span>
              <div id="feelings" class="chip-row"></div>
            </div>
            <div class="result-subsection">
              <span class="sub-label">Possible lies</span>
              <div id="liesList" class="lie-list"></div>
            </div>
          </div>
        </section>

        <section class="result-card">
          <div class="result-number">02</div>
          <div class="result-body">
            <p class="result-kicker">Suggested next step</p>
            <h3>Work through what surfaced.</h3>
            <ol id="stepsList" class="steps-list"></ol>
          </div>
        </section>

        <section class="result-card truth-card">
          <div class="result-number">03</div>
          <div class="result-body">
            <p class="result-kicker">Truth for this area</p>
            <h3>Bring truth to the need underneath it.</h3>
            <div id="resources" class="resource-grid"></div>
          </div>
        </section>

        <div class="email-card">
          <div>
            <p class="eyebrow">Keep a copy</p>
            <h3>Email this reflection to yourself.</h3>
            <p>Send the result so you can return to it later for prayer, journaling, or conversation with a facilitator.</p>
          </div>
          <div class="email-controls">
            <input id="resultEmail" type="email" inputmode="email" autocomplete="email" placeholder="name@example.com" aria-label="Email address" />
            <button id="emailBtn" class="button primary" type="button">Email my results</button>
          </div>
          <p id="emailStatus" class="email-status" aria-live="polite" hidden></p>
        </div>

        <p class="disclaimer">This tool is a guide for reflection and prayer, not a diagnosis. Hold the suggestions lightly and process them with God and safe people.</p>
      </div>
    </div>
  </section>

  <script is:inline>
    const MAX_INPUT_LENGTH = 250;
    let currentResult = null;

    const input = document.querySelector('#mainText');
    const counter = document.querySelector('#charCounter');
    const analyzeBtn = document.querySelector('#analyzeBtn');
    const clearBtn = document.querySelector('#clearBtn');
    const status = document.querySelector('#status');
    const results = document.querySelector('#results');
    const needPills = document.querySelector('#needPills');
    const touchedText = document.querySelector('#touchedText');
    const feelings = document.querySelector('#feelings');
    const liesList = document.querySelector('#liesList');
    const stepsList = document.querySelector('#stepsList');
    const resources = document.querySelector('#resources');
    const resultEmail = document.querySelector('#resultEmail');
    const emailBtn = document.querySelector('#emailBtn');
    const emailStatus = document.querySelector('#emailStatus');

    const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
      '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'
    }[char]));

    const list = (value) => Array.isArray(value) ? value.filter(Boolean) : [];

    function updateCounter() {
      if (input.value.length > MAX_INPUT_LENGTH) input.value = input.value.slice(0, MAX_INPUT_LENGTH);
      counter.textContent = `${input.value.length} / ${MAX_INPUT_LENGTH}`;
    }

    function showStatus(message, kind = 'neutral') {
      status.textContent = message;
      status.dataset.kind = kind;
      status.hidden = !message;
    }

    function renderResult(result) {
      const needs = list(result.needs);
      const possibleFeelings = list(result.possible_feelings);
      const possibleLies = list(result.possible_lies);
      const steps = list(result.suggested_steps);
      const resourceRows = list(result.resources);

      needPills.innerHTML = needs.length
        ? needs.map((need) => `<span>${esc(need)}</span>`).join('')
        : '<span>Reflection</span>';

      touchedText.textContent = result.what_got_touched || 'This may have touched a deeper place in the heart.';

      feelings.innerHTML = possibleFeelings.length
        ? possibleFeelings.map((feeling) => `<span class="chip">${esc(feeling)}</span>`).join('')
        : '<span class="muted-note">No feelings suggested.</span>';

      liesList.innerHTML = possibleLies.length
        ? possibleLies.map((lie) => `<div class="lie-item"><span></span><p>${esc(lie)}</p></div>`).join('')
        : '<p class="muted-note">No possible lies returned.</p>';

      stepsList.innerHTML = steps.length
        ? steps.map((step) => `<li><span>${esc(step)}</span></li>`).join('')
        : '<li><span>No next steps returned.</span></li>';

      resources.innerHTML = resourceRows.length
        ? resourceRows.map((resource) => {
            const scriptures = list(resource.scriptures);
            const practices = list(resource.recommended_practices);
            return `
              <article class="resource-card">
                <div class="resource-head">
                  <span class="need-label">Emotional need</span>
                  <h4>${esc(resource.need || 'This area')}</h4>
                  ${resource.description ? `<p>${esc(resource.description)}</p>` : ''}
                </div>
                <div class="resource-columns">
                  <div>
                    <span class="sub-label">Suggested Scriptures</span>
                    ${scriptures.length ? `<ul>${scriptures.map((item) => `<li>${esc(item)}</li>`).join('')}</ul>` : '<p class="muted-note">No scriptures found.</p>'}
                  </div>
                  <div>
                    <span class="sub-label">Recommended Practice</span>
                    ${practices.length ? `<ul>${practices.map((item) => `<li>${esc(item).replace(/\n/g, '<br>')}</li>`).join('')}</ul>` : '<p class="muted-note">No practice found.</p>'}
                  </div>
                </div>
              </article>
            `;
          }).join('')
        : '<p class="muted-note">No spreadsheet resources were returned.</p>';

      results.hidden = false;
      results.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }

    async function analyze() {
      const text = input.value.trim();
      currentResult = null;
      results.hidden = true;
      emailStatus.hidden = true;

      if (!text) {
        showStatus('Type a lie, thought, trigger, or brief situation first.', 'error');
        input.focus();
        return;
      }

      analyzeBtn.disabled = true;
      analyzeBtn.textContent = 'Analyzing…';
      showStatus('Looking at what may have been touched…', 'loading');

      try {
        const response = await fetch('/api/lies/analyze', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ text })
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'Something went wrong. Please try again.');

        currentResult = data;
        showStatus('', 'neutral');
        renderResult(data);
      } catch (error) {
        showStatus(error instanceof Error ? error.message : 'Something went wrong. Please try again.', 'error');
      } finally {
        analyzeBtn.disabled = false;
        analyzeBtn.textContent = 'Analyze this';
      }
    }

    function clearTool() {
      input.value = '';
      currentResult = null;
      results.hidden = true;
      showStatus('', 'neutral');
      emailStatus.hidden = true;
      resultEmail.value = '';
      updateCounter();
      input.focus();
    }

    async function emailResult() {
      const email = resultEmail.value.trim();
      if (!currentResult) {
        emailStatus.textContent = 'Analyze something first.';
        emailStatus.hidden = false;
        return;
      }
      if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
        emailStatus.textContent = 'Enter a valid email address.';
        emailStatus.hidden = false;
        resultEmail.focus();
        return;
      }

      emailBtn.disabled = true;
      emailBtn.textContent = 'Sending…';
      emailStatus.hidden = true;

      try {
        const response = await fetch('/api/lies/email', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ email, result: currentResult })
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data.error || 'Email could not be sent.');
        emailStatus.textContent = 'Sent. Check your inbox.';
        emailStatus.hidden = false;
      } catch (error) {
        emailStatus.textContent = error instanceof Error ? error.message : 'Email could not be sent.';
        emailStatus.hidden = false;
      } finally {
        emailBtn.disabled = false;
        emailBtn.textContent = 'Email my results';
      }
    }

    input.addEventListener('input', updateCounter);
    input.addEventListener('keydown', (event) => {
      if (event.key === 'Enter' && !event.shiftKey) {
        event.preventDefault();
        analyze();
      }
    });
    analyzeBtn.addEventListener('click', analyze);
    clearBtn.addEventListener('click', clearTool);
    emailBtn.addEventListener('click', emailResult);
    updateCounter();
  </script>

  <style is="global">
    .lies-hero{background:
      radial-gradient(circle at 78% 20%,rgba(244,189,82,.34),transparent 27%),
      linear-gradient(125deg,#243833 0%,#394d46 52%,#b2693b 130%);
      color:#fff
    }
    .lies-hero .eyebrow{color:#f2c56e}
    .lies-hero p:last-child{color:rgba(255,255,255,.78)}
    .lies-section{padding-top:4rem;background:linear-gradient(180deg,#f4efe6 0%,#fbf8f2 40%,#f4efe6 100%)}
    .lie-tool{max-width:1050px;margin:0 auto}
    .tool-intro{display:grid;grid-template-columns:1.4fr .6fr;gap:2rem;align-items:end;margin-bottom:1.5rem}
    .tool-intro h2{font-size:clamp(2.3rem,5vw,4rem);margin:.2rem 0 .8rem}
    .tool-intro>div:first-child>p:last-child{max-width:700px;color:var(--muted)}
    .tool-note{padding:1.1rem 1.2rem;border-top:1px solid rgba(32,37,34,.17);display:flex;gap:.8rem;align-items:flex-start}
    .tool-note span{font-size:.7rem;font-weight:800;color:var(--ember)}
    .tool-note p{margin:0;color:var(--muted);font-size:.9rem;line-height:1.5}
    .input-card{padding:clamp(1.25rem,3vw,2.2rem);border:1px solid rgba(32,37,34,.1);border-radius:28px;background:rgba(255,253,248,.94);box-shadow:0 22px 60px rgba(62,43,27,.08)}
    .input-card label{display:block;margin-bottom:.65rem;font-weight:800;font-size:.9rem;color:var(--deep)}
    .input-card textarea{width:100%;min-height:145px;resize:vertical;padding:1.15rem 1.2rem;border:1px solid rgba(32,37,34,.16);border-radius:18px;background:#fff;font:400 1.05rem/1.6 var(--sans);color:var(--ink);outline:none;transition:border-color .2s,box-shadow .2s}
    .input-card textarea:focus{border-color:rgba(214,107,50,.65);box-shadow:0 0 0 4px rgba(214,107,50,.08)}
    .input-footer{display:flex;justify-content:space-between;gap:1rem;margin:.55rem .2rem 0;color:var(--muted);font-size:.72rem}
    .tool-actions{display:flex;gap:.75rem;flex-wrap:wrap;margin-top:1.25rem}
    .input-card .button{font:800 .82rem var(--sans)}
    .status{margin-top:1rem;padding:.85rem 1rem;border-radius:12px;background:#f2eee7;color:#685f55;font-size:.85rem}
    .status[data-kind="error"]{background:#f7e8e4;color:#8b493d}
    .status[data-kind="loading"]{background:#edf1ed;color:#4d655b}
    .results{margin-top:4rem;scroll-margin-top:100px}
    .results-heading{display:flex;justify-content:space-between;gap:2rem;align-items:end;margin-bottom:1.5rem}
    .results-heading h2{font-size:clamp(2.2rem,4.5vw,3.6rem);margin:.15rem 0 0}
    .need-pills{display:flex;justify-content:flex-end;gap:.5rem;flex-wrap:wrap}
    .need-pills span{padding:.6rem .9rem;border-radius:999px;background:#263732;color:#fff;font-size:.72rem;font-weight:800;letter-spacing:.04em}
    .result-card{display:grid;grid-template-columns:85px 1fr;gap:1.2rem;margin-bottom:1rem;padding:clamp(1.2rem,3vw,2rem);border:1px solid rgba(32,37,34,.1);border-radius:24px;background:#fffdf8}
    .result-card-main{background:linear-gradient(145deg,#fffdf8 0%,#fbf4e8 100%)}
    .result-number{display:grid;place-items:center;width:52px;height:52px;border-radius:50%;background:#f1e4d1;color:#8a5b33;font-size:.74rem;font-weight:900}
    .result-kicker{margin:0 0 .4rem;text-transform:uppercase;letter-spacing:.14em;font-size:.68rem;font-weight:900;color:#9a6b44}
    .result-body h3{font-size:clamp(1.65rem,3vw,2.35rem);margin:0 0 1.2rem;max-width:850px}
    .result-subsection{padding-top:1.1rem;margin-top:1rem;border-top:1px solid rgba(32,37,34,.09)}
    .sub-label,.need-label{display:block;margin-bottom:.65rem;text-transform:uppercase;letter-spacing:.11em;font-size:.64rem;font-weight:900;color:#756c62}
    .chip-row{display:flex;gap:.5rem;flex-wrap:wrap}
    .chip{padding:.45rem .72rem;border-radius:999px;background:#edf1ed;color:#40584d;font-size:.78rem;font-weight:700}
    .lie-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.65rem}
    .lie-item{display:flex;gap:.75rem;align-items:flex-start;padding:.85rem 1rem;border:1px solid rgba(32,37,34,.09);border-radius:14px;background:#fff}
    .lie-item>span{width:8px;height:8px;margin-top:.5rem;border-radius:50%;background:#d66b32;flex:0 0 auto}
    .lie-item p{margin:0;line-height:1.45;font-size:.9rem}
    .steps-list{margin:0;padding:0;list-style:none;counter-reset:steps;display:grid;gap:.8rem}
    .steps-list li{counter-increment:steps;display:grid;grid-template-columns:36px 1fr;gap:.8rem;align-items:start;padding:.85rem 0;border-bottom:1px solid rgba(32,37,34,.08)}
    .steps-list li:last-child{border-bottom:0}
    .steps-list li::before{content:counter(steps);display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#eef0eb;color:#51635a;font-size:.68rem;font-weight:900}
    .steps-list span{padding-top:.2rem;line-height:1.55}
    .truth-card{background:#263732;color:#fff;border-color:#263732}
    .truth-card .result-number{background:rgba(255,255,255,.12);color:#f5c473}
    .truth-card .result-kicker,.truth-card .sub-label,.truth-card .need-label{color:#e6b867}
    .resource-grid{display:grid;gap:1rem}
    .resource-card{padding:1.35rem;border:1px solid rgba(255,255,255,.14);border-radius:18px;background:rgba(255,255,255,.055)}
    .resource-head h4{margin:.15rem 0 .45rem;font:400 1.85rem/1.1 var(--serif);color:#fff}
    .resource-head p{max-width:780px;margin:0;color:rgba(255,255,255,.7);font-size:.9rem}
    .resource-columns{display:grid;grid-template-columns:1fr 1fr;gap:1.5rem;margin-top:1.2rem;padding-top:1.2rem;border-top:1px solid rgba(255,255,255,.12)}
    .resource-columns ul{margin:0;padding-left:1.1rem;color:rgba(255,255,255,.88)}
    .resource-columns li{margin:.45rem 0;line-height:1.55;font-size:.88rem}
    .muted-note{color:var(--muted);font-size:.85rem}
    .truth-card .muted-note{color:rgba(255,255,255,.62)}
    .email-card{display:grid;grid-template-columns:1fr .9fr;gap:2rem;align-items:center;margin-top:1.2rem;padding:clamp(1.25rem,3vw,2rem);border:1px solid rgba(32,37,34,.1);border-radius:24px;background:#fff}
    .email-card h3{font-size:clamp(1.5rem,3vw,2rem);margin:.1rem 0 .5rem}
    .email-card>div:first-child>p:last-child{margin:0;color:var(--muted);font-size:.9rem}
    .email-controls{display:flex;gap:.6rem;align-items:center}
    .email-controls input{min-width:0;flex:1;padding:.82rem .95rem;border:1px solid rgba(32,37,34,.16);border-radius:12px;font:inherit}
    .email-controls .button{white-space:nowrap}
    .email-status{grid-column:1/-1;margin:0;padding:.75rem .9rem;border-radius:10px;background:#edf1ed;color:#445a50;font-size:.82rem}
    .disclaimer{max-width:820px;margin:1.2rem auto 0;text-align:center;color:#7c756e;font-size:.75rem}
    @media(max-width:800px){
      .tool-intro,.email-card{grid-template-columns:1fr}
      .results-heading{align-items:flex-start;flex-direction:column}
      .need-pills{justify-content:flex-start}
      .result-card{grid-template-columns:1fr}
      .result-number{width:42px;height:42px}
      .lie-list,.resource-columns{grid-template-columns:1fr}
      .email-controls{align-items:stretch;flex-direction:column}
      .email-controls .button{width:100%}
    }
    @media(max-width:520px){
      .lies-section{padding-left:4.5vw;padding-right:4.5vw}
      .input-card,.result-card,.email-card{border-radius:19px}
      .input-footer{align-items:flex-end;flex-direction:column;gap:.2rem}
      .input-hint{align-self:flex-start}
      .tool-actions .button{flex:1}
    }
  </style>
</BaseLayout>
