---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Classes & Upcoming Dates | Healing the Heart">
<section class="page-hero"><div class="page-hero-inner"><p class="eyebrow">Take the next step</p><h1>Classes &amp; upcoming dates</h1><p>When a class is ready, you'll find the current details here. Choose the opportunity that feels right for your next step.</p></div></section>
<section class="section"><div class="rich-section">
  <div id="live-classes" class="class-list"><div class="placeholder">Loading current classes…</div></div>
  <div id="no-classes" class="placeholder" hidden><strong>No upcoming classes are open right now.</strong><br />Please check back soon or contact us if you would like to hear about the next opportunity.</div>
  <h2 style="margin-top:4rem">Different people, different steps.</h2>
  <p>Offerings may include the eight-week Healing &amp; Restoring the Heart class, retreats, and additional healing opportunities. Dates, prices, schedules, and program details shown above are the current confirmed offerings.</p>
</div></section>
<section class="dark-section section"><div class="rich-section"><p class="eyebrow light">Not sure where to begin?</p><h2>We're happy to help.</h2><p>You don't have to figure out the right class on your own.</p><a class="button primary" href="/contact">Contact us</a></div></section>
<script>
  const target = document.querySelector('#live-classes'); const empty = document.querySelector('#no-classes');
  const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (c) => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
  const labels = {'eight-week-in-person':'8-week in person','three-day-retreat':'3-day retreat','pastors-only-retreat':'Pastors only retreat','adoptive-parents':'Adoptive parents','one-on-one-intensive-weekend':'1x1 intensive weekend','marriage-retreat':'Marriage retreat','marriage-retreats':'Marriage retreat','womens-only':'Women’s only','mens-retreat':'Men’s retreat'};
  const money = (cents) => Number(cents || 0) === 0 ? 'Free' : `$${(Number(cents) / 100).toFixed(2)}`;
  async function loadClasses() { try { const response=await fetch('/api/classes'); const data=await response.json(); const classes=data.classes||[]; if(!classes.length){target.hidden=true;empty.hidden=false;return;} target.innerHTML=classes.map(c=>`<article class="class-card"><p class="eyebrow">${esc(labels[c.type_id]||c.type_id)}</p><h2>${esc(c.title)}</h2><p>${esc(c.description||'')}</p><div class="class-meta"><strong>${esc(c.start_date)}${c.end_date&&c.end_date!==c.start_date?` – ${esc(c.end_date)}`:''}</strong><span>${esc(c.schedule||'')}</span><span>${esc(c.location_name||'')}${c.location_address?` · ${esc(c.location_address)}`:''}</span><span>${money(c.price_cents)}${c.capacity?` · ${esc(c.capacity)} spots`:''}</span></div><a class="button primary" href="/register?classId=${encodeURIComponent(c.id)}">Register for this class</a></article>`).join(''); } catch { target.innerHTML='<div class="placeholder">We could not load the current schedule. Please contact us for upcoming dates.</div>'; } }
  loadClasses();
</script>
</BaseLayout>
