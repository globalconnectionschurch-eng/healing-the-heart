---
import BaseLayout from '../layouts/BaseLayout.astro';
import { classTypePresets } from '../data/class-types';

const presetData = Object.fromEntries(classTypePresets.map((item) => [item.id, item]));
---
<BaseLayout title="Classes & Upcoming Dates | Healing the Heart">
  <section class="page-hero">
    <div class="page-hero-inner">
      <p class="eyebrow">Take the next step</p>
      <h1>Classes &amp; upcoming dates</h1>
      <p>Every offering has a different purpose. Explore what each one is designed for, then choose an upcoming date when one is available.</p>
    </div>
  </section>

  <section class="section classes-section">
    <div class="rich-section">
      <div class="classes-intro">
        <p class="eyebrow">What we offer</p>
        <h2>There is a place to begin.</h2>
        <p>Our classes and retreats create a safe and supportive environment to address deep struggles, uncover root causes, and learn how to continually walk out healing.</p>
      </div>

      <div id="class-offerings" class="offerings-grid">
        {classTypePresets.map((preset) => (
          <article class="offering-card" data-type={preset.id}>
            <div class="offering-top">
              <span class="offering-number">{String(classTypePresets.indexOf(preset) + 1).padStart(2, '0')}</span>
              <div>
                <p class="eyebrow">{preset.defaultDurationLabel}</p>
                <h2>{preset.name}</h2>
              </div>
            </div>
            {preset.prerequisite && (
              <div class="prerequisite"><strong>Prerequisite</strong><span>{preset.prerequisite}</span></div>
            )}
            <p class="offering-description">{preset.description}</p>
            <details class="assessment">
              <summary>Quick self-assessment</summary>
              <ul>
                {(preset.assessment ?? []).map((question) => <li>{question}</li>)}
              </ul>
            </details>
            <div class="offering-dates" data-dates>
              <div class="date-placeholder">Date to be determined</div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="statement-band">
    <p>It’s not just healing—it’s heart transformation.</p>
  </section>

  <section class="section">
    <div class="rich-section process-section">
      <p class="eyebrow">The process</p>
      <h2>Recognize the trigger. Trace the root. Remove the stones. Do the work. Grow new fruit.</h2>
      <p>Old pain, lies, and defenses can shape the way we live. Healing the Heart makes room to understand those patterns, bring them into the light, and continually walk out learned healing.</p>
      <div class="process-steps">
        <div><strong>01</strong><span>Recognize the trigger</span></div>
        <div><strong>02</strong><span>Trace the root</span></div>
        <div><strong>03</strong><span>Remove the stones</span></div>
        <div><strong>04</strong><span>Do the work</span></div>
        <div><strong>05</strong><span>Grow new fruit</span></div>
      </div>
    </div>
  </section>

  <section class="dark-section section">
    <div class="rich-section">
      <p class="eyebrow light">Not sure where to begin?</p>
      <h2>We’re happy to help.</h2>
      <p>You don’t have to figure out the right class on your own.</p>
      <a class="button primary" href="/contact">Contact us</a>
    </div>
  </section>

  <script is:inline define:vars={{ presetData }}>
    const offerings = document.querySelectorAll('[data-type]');
    const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (c) => ({ '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;', "'":'&#39;' })[c]);
    const money = (cents) => Number(cents || 0) === 0 ? 'Free' : `$${(Number(cents) / 100).toFixed(2)}`;
    const formatDate = (value) => {
      const date = new Date(`${value}T12:00:00Z`);
      return Number.isNaN(date.getTime()) ? value : new Intl.DateTimeFormat('en-US', { month: 'long', day: 'numeric', year: 'numeric', timeZone: 'America/Edmonton' }).format(date);
    };

    async function loadClasses() {
      try {
        const response = await fetch('/api/classes');
        const data = await response.json();
        const classes = data.classes || [];

        offerings.forEach((card) => {
          const typeId = card.dataset.type;
          const preset = presetData[typeId];
          const dates = card.querySelector('[data-dates]');
          const matches = classes.filter((item) => item.type_id === typeId);

          if (typeId === 'one-on-one-intensive-weekend' && !matches.length) {
            dates.innerHTML = '<div class="date-placeholder">Dates and accommodations are arranged individually during a confidential consultation.</div><a class="button outline" href="/contact">Contact us about the intensive</a>';
            return;
          }

          if (!matches.length) {
            const price = preset?.defaultPriceCents == null ? '' : `<span>${money(preset.defaultPriceCents)}</span>`;
            dates.innerHTML = `<div class="date-placeholder"><strong>Date to be determined</strong>${price}</div><span class="availability-note">We’ll post the next opportunity here when a date is confirmed.</span>`;
            return;
          }

          dates.innerHTML = matches.map((item) => {
            const dateRange = item.end_date && item.end_date !== item.start_date ? `${formatDate(item.start_date)} – ${formatDate(item.end_date)}` : formatDate(item.start_date);
            const details = [dateRange, item.schedule, item.location_name, item.price_cents != null ? money(item.price_cents) : ''].filter(Boolean);
            return `<div class="class-option"><div><strong>${esc(item.title)}</strong><span>${details.map(esc).join(' · ')}</span></div><a class="button primary" href="/register?classId=${encodeURIComponent(item.id)}">Register</a></div>`;
          }).join('');
        });
      } catch {
        offerings.forEach((card) => {
          const dates = card.querySelector('[data-dates]');
          dates.innerHTML = '<div class="date-placeholder">Dates to be determined</div>';
        });
      }
    }

    loadClasses();
  </script>

  <style is="global">
    .classes-section { padding-top: 4.5rem; }
    .classes-intro { max-width: 760px; margin-bottom: 2.5rem; }
    .classes-intro h2 { margin: .2rem 0 .7rem; }
    .classes-intro p:last-child { margin-bottom: 0; }
    .offerings-grid { display: grid; gap: 1.25rem; }
    .offering-card { background: #fff; border: 1px solid rgba(40,30,20,.09); border-radius: 24px; padding: 1.6rem; box-shadow: 0 16px 45px rgba(45,32,18,.055); }
    .offering-top { display: flex; gap: 1rem; align-items: flex-start; }
    .offering-number { width: 44px; height: 44px; flex: 0 0 44px; border-radius: 50%; display: grid; place-items: center; background: #f1e7d9; color: #705943; font-weight: 800; font-size: .78rem; letter-spacing: .08em; }
    .offering-top .eyebrow { margin: 0 0 .2rem; }
    .offering-card h2 { margin: 0; font-size: clamp(1.35rem, 2.4vw, 1.8rem); }
    .offering-description { max-width: 920px; line-height: 1.75; color: rgba(30,25,20,.74); margin: 1.25rem 0; }
    .prerequisite { display: grid; gap: .2rem; margin-top: 1rem; padding: .9rem 1rem; border-radius: 14px; background: #f7f3ed; border: 1px solid rgba(90,70,45,.1); }
    .prerequisite strong { font-size: .75rem; text-transform: uppercase; letter-spacing: .08em; color: #705943; }
    .prerequisite span { line-height: 1.55; }
    .assessment { border-top: 1px solid rgba(40,30,20,.09); padding-top: .85rem; }
    .assessment summary { cursor: pointer; font-weight: 700; color: #51483f; }
    .assessment ul { margin: .85rem 0 .25rem; padding-left: 1.2rem; display: grid; gap: .5rem; color: rgba(30,25,20,.68); line-height: 1.55; }
    .offering-dates { margin-top: 1.15rem; padding-top: 1rem; border-top: 1px solid rgba(40,30,20,.09); display: grid; gap: .65rem; }
    .date-placeholder { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .9rem 1rem; border-radius: 14px; background: #faf8f5; color: rgba(30,25,20,.64); }
    .date-placeholder span { font-weight: 700; color: #51483f; }
    .availability-note { font-size: .82rem; color: rgba(30,25,20,.52); }
    .class-option { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 1rem; border-radius: 16px; background: #faf8f5; border: 1px solid rgba(40,30,20,.08); }
    .class-option > div { min-width: 0; display: grid; gap: .25rem; }
    .class-option strong { font-size: 1rem; }
    .class-option span { color: rgba(30,25,20,.62); font-size: .86rem; line-height: 1.45; }
    .process-section h2 { max-width: 920px; }
    .process-steps { display: grid; grid-template-columns: repeat(5, 1fr); gap: .75rem; margin-top: 2rem; }
    .process-steps div { padding: 1rem; border: 1px solid rgba(40,30,20,.09); border-radius: 16px; background: #fff; display: grid; gap: .5rem; }
    .process-steps strong { font-size: .72rem; color: #8a7057; }
    .process-steps span { font-weight: 700; line-height: 1.3; }
    @media (max-width: 800px) { .process-steps { grid-template-columns: 1fr 1fr; } }
    @media (max-width: 600px) { .offering-card { padding: 1.15rem; border-radius: 19px; } .class-option { align-items: flex-start; flex-direction: column; } .class-option .button { width: 100%; } .date-placeholder { align-items: flex-start; flex-direction: column; } .process-steps { grid-template-columns: 1fr; } }
  </style>
</BaseLayout>
