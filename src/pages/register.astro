---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Registration | Healing the Heart">
  <section class="page-hero"><div class="page-hero-inner"><p class="eyebrow">Take your next step</p><h1>Registration</h1><p>You’re taking a powerful step toward healing, and we’re excited to walk this journey with you. Fill out the form below, and a facilitator will reach out with next steps.</p></div></section>
  <section class="section">
    <form id="registration-form" class="registration-form" method="post" action="/api/register">
      <input type="text" name="website" tabindex="-1" autocomplete="off" style="position:absolute;left:-9999px" aria-hidden="true" />
      <label>Name<input name="name" required autocomplete="name" /></label>
      <label>Selected Your Course/Class<select id="class-select" name="classId" required><option value="">Loading current classes…</option></select></label>
      <label>Email Address<input type="email" name="email" required autocomplete="email" placeholder="We’ll contact you here for class/course info." /></label>
      <label>Phone<input type="tel" name="phone" autocomplete="tel" placeholder="Calls for urgent matters (class changes ETC)" /></label>
      <label>Address<input name="address" autocomplete="street-address" placeholder="Address (for sending reports and course material)" /></label>
      <label>Date of birth<input type="date" name="dateOfBirth" /></label>
      <label>Marital status<select name="maritalStatus"><option value="">Select an option</option><option>Single</option><option>Married</option><option>Separated</option><option>Divorced</option><option>Widowed</option><option>Prefer not to say</option></select></label>
      <label>What Church Do You Attend/Serve At?<input name="church" /></label>
      <label>SR. Pastor Only<input name="srPastor" placeholder="Please Enter Your Clergy #" /></label>
      <label>How did you hear about Favored Father/HTH?<input name="howHeard" placeholder="How did you hear about us" /></label>
      <label>What do you hope to gain from this course?<textarea name="goals" placeholder="Sharing this helps us support you better."></textarea></label>
      <label>Do you have any smoking or drinking concern? (Our facilities are smoke and alcohol free)<textarea name="smokingDrinking" placeholder="Sharing this helps us support you better."></textarea></label>
      <label>Anything else you'd like to share to help up support your healing journey?<textarea name="anythingElse" placeholder="Share anything that helps us support you."></textarea></label>
      <label>Verification Code <span class="field-note">(For those who were gifted this class or prepaid)</span><input name="verificationCode" placeholder="Please enter your Verification Code" /></label>
      <p class="form-note">After submitting your form, we’ll email you instructions for completing your course payment. Your facilitator may also contact you if anything needs clarification.</p>
      <button class="button primary" type="submit">Submit Registration</button>
    </form>

    <div id="registration-success" class="registration-result" hidden>
      <p class="eyebrow">Registration received</p>
      <h2>You’re registered for the next step.</h2>
      <p id="success-message">Thank you. Your registration has been successfully submitted.</p>
      <div id="payment-next-step" hidden>
        <p><strong>Your registration is saved.</strong> When you're ready, proceed to the payment page to complete your registration.</p>
        <a id="payment-link" class="button primary" href="#">Proceed to payment</a>
      </div>
      <p id="paid-next-step" hidden>Payment has already been recorded for this registration. Your class information will be sent by email.</p>
    </div>

    <div id="registration-error" class="registration-result error" hidden>
      <p class="eyebrow">We need to try that again</p>
      <h2>Your registration was not completed.</h2>
      <p id="error-message">Please check your information and try again.</p>
      <button id="try-again" class="button outline" type="button">Return to registration</button>
    </div>
  </section>
  <script is:inline>
    const form = document.querySelector('#registration-form');
    const select = document.querySelector('#class-select');
    const success = document.querySelector('#registration-success');
    const errorBox = document.querySelector('#registration-error');
    const errorMessage = document.querySelector('#error-message');
    const paymentNext = document.querySelector('#payment-next-step');
    const paymentLink = document.querySelector('#payment-link');
    const paidNext = document.querySelector('#paid-next-step');
    const successMessage = document.querySelector('#success-message');

    const loadClasses = async () => {
      try {
        const response = await fetch('/api/classes');
        const data = await response.json();
        select.innerHTML = '<option value="">Select a current class</option>';
        for (const item of data.classes ?? []) {
          const option = document.createElement('option');
          option.value = item.id;
          const price = Number(item.price_cents || 0) ? ` · $${(Number(item.price_cents) / 100).toFixed(2)}` : '';
          option.textContent = `${item.title} · ${item.start_date} – ${item.end_date}${price}`;
          select.appendChild(option);
        }
        if (!(data.classes ?? []).length) select.innerHTML = '<option value="">No classes are currently open</option>';
        const requestedClass = new URLSearchParams(location.search).get('classId');
        if (requestedClass && [...select.options].some((option) => option.value === requestedClass)) select.value = requestedClass;
      } catch {
        select.innerHTML = '<option value="">Classes are temporarily unavailable</option>';
      }
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const button = form.querySelector('button[type="submit"]');
      button.disabled = true;
      button.textContent = 'Submitting…';
      success.hidden = true;
      errorBox.hidden = true;
      try {
        const response = await fetch(form.action, { method: 'POST', body: new FormData(form), credentials: 'same-origin' });
        if (!response.ok) {
          let message = 'We could not complete your registration. Please try again.';
          try { const data = await response.json(); message = data.error || message; } catch {}
          throw new Error(message);
        }
        const destination = response.url || '';
        const paymentMatch = destination.match(/\/payment\?registration=([^&]+)/);
        const successMatch = destination.includes('/register?success=1');
        if (paymentMatch) {
          paymentLink.href = `/payment?registration=${paymentMatch[1]}`;
          paymentNext.hidden = false;
          paidNext.hidden = true;
          successMessage.textContent = 'Thank you. Your registration has been successfully submitted.';
        } else if (successMatch) {
          paymentNext.hidden = true;
          paidNext.hidden = true;
          successMessage.textContent = 'Thank you. Your registration has been successfully submitted.';
        }
        form.hidden = true;
        success.hidden = false;
        window.scrollTo({ top: success.offsetTop - 80, behavior: 'smooth' });
      } catch (error) {
        errorMessage.textContent = error instanceof Error ? error.message : 'We could not complete your registration. Please try again.';
        errorBox.hidden = false;
        button.disabled = false;
        button.textContent = 'Submit Registration';
        window.scrollTo({ top: errorBox.offsetTop - 80, behavior: 'smooth' });
      }
    });

    document.querySelector('#try-again').addEventListener('click', () => {
      errorBox.hidden = true;
      form.hidden = false;
      form.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    loadClasses();
  </script>
  <style>
    .registration-result{max-width:760px;margin:2rem auto 0;padding:2.5rem;border:1px solid var(--line,#ddd);border-radius:24px;background:var(--surface,#fff);box-shadow:0 16px 50px rgba(0,0,0,.06)}
    .registration-result h2{margin:.25rem 0 1rem}.registration-result p{max-width:620px}.registration-result.error{border-color:#d9a0a0}.registration-result .button{margin-top:1rem}
  </style>
</BaseLayout>
