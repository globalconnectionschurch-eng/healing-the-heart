---
import BaseLayout from '../layouts/BaseLayout.astro';
const registrationId = Astro.url.searchParams.get('registration') ?? '';
---
<BaseLayout title="Complete Payment | Healing the Heart">
  <section class="page-hero"><div class="page-hero-inner"><p class="eyebrow">One more step</p><h1>Complete your payment</h1><p>Your registration has been saved. Complete your payment securely through Moneris to confirm your place.</p></div></section>
  <section class="section payment-section">
    <div class="payment-card">
      <div id="loading"><p>Preparing secure payment…</p></div>
      <div id="checkout-wrap" hidden>
        <div class="payment-summary"><p class="eyebrow">Healing the Heart</p><h2 id="class-title">Class payment</h2><p id="student-name"></p><p id="original-amount" class="original-amount" hidden></p><strong id="amount"></strong><p id="discount-message" class="discount-message" hidden></p></div>
        <p class="code-note">Your registration discount code, if entered, has already been applied.</p>
        <div id="monerisCheckout"></div>
      </div>
      <div id="success" class="payment-message" hidden><h2>Payment received.</h2><p>Your registration is confirmed. We’ve received your payment and will send your class information by email.</p><a class="button primary" href="/">Return to Healing the Heart</a></div>
      <div id="error" class="payment-message error" hidden><h2>We couldn't complete that payment.</h2><p id="error-text"></p><details id="diagnostic-wrap" hidden><summary>Technical details</summary><pre id="diagnostic"></pre></details><a class="button outline" href="/contact">Contact us</a></div>
    </div>
  </section>
  <style>.payment-section{padding-top:3rem}.payment-card{max-width:760px;margin:0 auto;padding:2rem;border:1px solid var(--line,#ddd);border-radius:24px;background:var(--surface,#fff);box-shadow:0 16px 50px rgba(0,0,0,.06)}.payment-summary{margin-bottom:1rem}.payment-summary h2{margin:.25rem 0}.payment-summary strong{font-size:1.7rem}.original-amount{text-decoration:line-through;color:#777;margin:.25rem 0}.discount-message{color:#47704d;font-size:.95rem;margin:.6rem 0 0}.code-note{margin:1rem 0 1.5rem;color:#68706a;font-size:.92rem}.payment-message{padding:1rem 0}.payment-message.error{color:#8a2525}.payment-message details{margin:1rem 0}.payment-message pre{white-space:pre-wrap;overflow-wrap:anywhere;font-size:.8rem;background:#f6f6f6;padding:1rem;border-radius:10px;color:#333}</style>
  <script is:inline define:vars={{ registrationId }}>
    const loading=document.querySelector('#loading'),wrap=document.querySelector('#checkout-wrap'),success=document.querySelector('#success'),errorBox=document.querySelector('#error'),errorText=document.querySelector('#error-text'),diagnosticWrap=document.querySelector('#diagnostic-wrap'),diagnostic=document.querySelector('#diagnostic'),originalAmount=document.querySelector('#original-amount'),amount=document.querySelector('#amount'),discountMessage=document.querySelector('#discount-message');
    const showError=(message,details)=>{loading.hidden=true;wrap.hidden=true;errorBox.hidden=false;errorText.textContent=message;if(details){diagnostic.textContent=details;diagnosticWrap.hidden=false;}};
    const renderSummary=(data)=>{document.querySelector('#class-title').textContent=data.classTitle||'Class payment';document.querySelector('#student-name').textContent=data.name?`Registration for ${data.name}`:'';amount.textContent=`$${data.amount} CAD`;if(Number(data.discountPercent)>0){originalAmount.hidden=false;originalAmount.textContent=`Original price: $${data.originalAmount} CAD`;discountMessage.hidden=false;discountMessage.textContent=`${data.discountPercent}% discount applied. You save $${data.discountAmount} CAD.`;}};
    const startCheckout=(data)=>{const existing=document.querySelector('#monerisCheckout');existing.innerHTML='';const script=document.createElement('script');script.src=data.environment==='prod'?'https://gateway.moneris.com/chktv2/js/chkt_v3.00.js':'https://gatewayt.moneris.com/chktv2/js/chkt_v3.00.js';script.onload=()=>{const checkout=new window.monerisCheckout();checkout.setMode(data.environment);checkout.setCheckoutDiv('monerisCheckout');checkout.setCallback('cancel_transaction',()=>checkout.closeCheckout());checkout.setCallback('error_event',raw=>{try{const result=typeof raw==='string'?JSON.parse(raw):raw;showError(result?.message||'Moneris reported a payment error.');}catch{showError('Moneris reported a payment error.');}});checkout.setCallback('payment_complete',async raw=>{let callback=raw;try{callback=typeof raw==='string'?JSON.parse(raw):raw;}catch{}const ticket=callback?.ticket||data.ticket;checkout.closeCheckout();const confirm=await fetch('/api/payment/complete',{method:'POST',headers:{'content-type':'application/json'},credentials:'same-origin',body:JSON.stringify({registrationId,ticket})});const result=await confirm.json();if(!confirm.ok||!result.paid)return showError(result.error||'We could not confirm the payment. Please contact us before trying again.');loading.hidden=true;wrap.hidden=true;success.hidden=false;});checkout.startCheckout(data.ticket);};script.onerror=()=>showError('The Moneris payment service could not be loaded. Please try again.');document.head.appendChild(script);};
    const start=async()=>{if(!registrationId)return showError('This payment link is missing its registration. Please return to the registration page and try again.');try{const response=await fetch('/api/payment/initiate',{method:'POST',headers:{'content-type':'application/json'},credentials:'same-origin',body:JSON.stringify({registrationId})});const data=await response.json();if(!response.ok)return showError(data.error||'Unable to start payment.',data.diagnostic);if(data.alreadyPaid){loading.hidden=true;success.hidden=false;return;}renderSummary(data);startCheckout(data);loading.hidden=true;wrap.hidden=false;}catch{showError('Unable to connect to the payment service. Please try again.');}};
    start();
  </script>
</BaseLayout>