---
import BaseLayout from '../layouts/BaseLayout.astro';
const registrationId = Astro.url.searchParams.get('registration') ?? '';
---
<BaseLayout title="Complete Payment | Healing the Heart">
  <section class="page-hero"><div class="page-hero-inner"><p class="eyebrow">One more step</p><h1>Complete your payment</h1><p>Your registration has been saved. Complete your payment securely through Moneris to confirm your place.</p></div></section>
  <section class="section payment-section">
    <div class="payment-card">
      <div id="loading"><p>Preparing secure payment…</p></div>
      <div id="checkout-wrap" hidden>
        <div class="payment-summary"><p class="eyebrow">Healing the Heart</p><h2 id="class-title">Class payment</h2><p id="student-name"></p><strong id="amount"></strong></div>
        <div id="monerisCheckout"></div>
      </div>
      <div id="success" class="payment-message" hidden><h2>Payment received.</h2><p>Your registration is confirmed. We’ve received your payment and will send your class information by email.</p><a class="button primary" href="/">Return to Healing the Heart</a></div>
      <div id="error" class="payment-message error" hidden><h2>We couldn't complete that payment.</h2><p id="error-text"></p><a class="button outline" href="/contact">Contact us</a></div>
    </div>
  </section>
  <style>
    .payment-section{padding-top:3rem}.payment-card{max-width:760px;margin:0 auto;padding:2rem;border:1px solid var(--line,#ddd);border-radius:24px;background:var(--surface,#fff);box-shadow:0 16px 50px rgba(0,0,0,.06)}.payment-summary{margin-bottom:1.5rem}.payment-summary h2{margin:.25rem 0}.payment-summary strong{font-size:1.7rem}.payment-message{padding:1rem 0}.payment-message.error{color:#8a2525}
  </style>
  <script is:inline define:vars={{ registrationId }}>
    const loading = document.querySelector('#loading');
    const wrap = document.querySelector('#checkout-wrap');
    const success = document.querySelector('#success');
    const errorBox = document.querySelector('#error');
    const errorText = document.querySelector('#error-text');
    const showError = (message) => { loading.hidden = true; wrap.hidden = true; errorBox.hidden = false; errorText.textContent = message; };
    const start = async () => {
      if (!registrationId) return showError('This payment link is missing its registration. Please return to the registration page and try again.');
      try {
        const response = await fetch('/api/payment/initiate', { method:'POST', headers:{'content-type':'application/json'}, credentials:'same-origin', body:JSON.stringify({registrationId}) });
        const data = await response.json();
        if (!response.ok) return showError(data.error || 'Unable to start payment.');
        if (data.alreadyPaid) { loading.hidden = true; success.hidden = false; return; }
        document.querySelector('#class-title').textContent = data.classTitle || 'Class payment';
        document.querySelector('#student-name').textContent = data.name ? `Registration for ${data.name}` : '';
        document.querySelector('#amount').textContent = `$${data.amount} CAD`;
        const script = document.createElement('script');
        script.src = data.environment === 'prod' ? 'https://gateway.moneris.com/chktv2/js/chkt_v3.00.js' : 'https://gatewayt.moneris.com/chktv2/js/chkt_v3.00.js';
        script.onload = () => {
          const checkout = new window.monerisCheckout();
          checkout.setMode(data.environment);
          checkout.setCheckoutDiv('monerisCheckout');
          checkout.setCallback('cancel_transaction', () => checkout.closeCheckout());
          checkout.setCallback('error_event', (raw) => { try { const result = typeof raw === 'string' ? JSON.parse(raw) : raw; showError(result?.message || 'Moneris reported a payment error.'); } catch { showError('Moneris reported a payment error.'); } });
          checkout.setCallback('payment_complete', async (raw) => {
            let callback = raw;
            try { callback = typeof raw === 'string' ? JSON.parse(raw) : raw; } catch {}
            const ticket = callback?.ticket || data.ticket;
            checkout.closeCheckout();
            const confirm = await fetch('/api/payment/complete', { method:'POST', headers:{'content-type':'application/json'}, credentials:'same-origin', body:JSON.stringify({registrationId,ticket}) });
            const result = await confirm.json();
            if (!confirm.ok || !result.paid) return showError(result.error || 'We could not confirm the payment. Please contact us before trying again.');
            loading.hidden = true; wrap.hidden = true; success.hidden = false;
          });
          checkout.startCheckout(data.ticket);
          loading.hidden = true; wrap.hidden = false;
        };
        script.onerror = () => showError('The Moneris payment service could not be loaded. Please try again.');
        document.head.appendChild(script);
      } catch { showError('Unable to connect to the payment service. Please try again.'); }
    };
    start();
  </script>
</BaseLayout>
