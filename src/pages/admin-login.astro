---
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Admin Login | Healing the Heart</title>
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body class="admin-shell">
    <main class="login-wrap">
      <section class="login-card">
        <div class="admin-mark">♥</div>
        <p class="admin-kicker">Healing the Heart</p>
        <h1>Admin sign in</h1>
        <p class="admin-muted">Manage classes, registrations, students, and class communication.</p>
        <form class="admin-form" action="/admin-dashboard">
          <label>Email<input type="email" name="email" autocomplete="email" required /></label>
          <label>Password<input type="password" name="password" autocomplete="current-password" required /></label>
          <button class="admin-button" type="submit">Sign in</button>
        </form>
        <a class="back-link" href="/">← Back to Healing the Heart</a>
      </section>
    </main>
  </body>
</html>
