---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { classTypePresets } from '../../data/class-types';
import { isAdminRequest } from '../../lib/server';
if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
const presetData = Object.fromEntries(classTypePresets.map((type) => [type.id, type]));
---
<BaseLayout title="Classes | Healing the Heart Admin">
  <section class="admin-shell" id="classes-admin" data-presets={JSON.stringify(presetData)}>
    <div class="admin-header"><div><p class="eyebrow">Admin · Classes</p><h1>Classes</h1><p>Create upcoming classes, manage private rosters, and keep past classes available in the archive.</p></div><a class="button outline" href="/admin">← Dashboard</a></div>
    <nav class="admin-menu" aria-label="Admin menu"><a href="/admin">Dashboard</a><a href="/admin/classes" aria-current="page">Classes</a><a href="/admin/registrations">Registrations</a><a href="/admin/attendees">Attendee Directory</a><a href="/admin/blast-email">Blast Email</a><a href="/admin/templates">Email Templates</a><a href="/admin/email-history">Email History</a></nav>
    <div class="admin-page-grid">
      <section class="admin-section"><div class="admin-section-title"><div><p class="eyebrow">Live</p><h2>Upcoming classes</h2></div></div><div id="upcoming" class="admin-table"><div class="admin-empty">Loading…</div></div></section>
      <section class="admin-section"><div class="admin-section-title"><div><p class="eyebrow">History</p><h2>Archived classes</h2><p>Past events remain available for rosters and registration history.</p></div></div><div id="archived" class="admin-table"><div class="admin-empty">Loading…</div></div></section>
      <details class="admin-section admin-collapsible" open><summary><div><p class="eyebrow">New class</p><h2>Create a class</h2><p>Choose a class type to pre-fill its standard details.</p></div><span class="collapsible-icon">＋</span></summary>
        <form id="class-form" class="admin-form"><label>Class type<select id="typeId" required><option value="">Choose a class type</option>{classTypePresets.map(t=><option value={t.id}>{t.name}</option>)}</select></label><div class="form-grid"><label>Class name<input id="title" required></label><label>Price<input id="price" type="number" min="0" step="0.01"></label><label>Start date<input id="startDate" type="date" required></label><label>End date<input id="endDate" type="date" required></label><label>Schedule<input id="schedule" placeholder="e.g. Thursdays, 7:30 PM – 9:30 PM"></label><label>Capacity<input id="capacity" type="number" min="1"></label></div><div class="form-grid"><label>Location name<input id="locationName"></label><label>Location address<input id="locationAddress"></label><label>Parking<input id="parking"></label><label>Where to go<input id="whereToGo"></label></div><label>Payment link <span class="field-note">Leave blank for classes that are contact-only.</span><input id="paymentUrl" type="url"></label><label>Description<textarea id="description" rows="4"></textarea></label><label>Admin notes<textarea id="notes" rows="3"></textarea></label><button class="button primary">Save class</button><p id="result" class="field-note"></p></form>
      </details>
    </div>
  </section>
  <style>.admin-page-grid{display:grid;gap:1.25rem}.admin-section-title{display:flex;justify-content:space-between;gap:1rem;align-items:flex-start}.class-row{display:grid;grid-template-columns:minmax(0,1.8fr) 1fr auto auto;gap:1rem;align-items:center;padding:1rem 1.1rem;border-bottom:1px solid rgba(0,0,0,.07)}.class-row:last-child{border-bottom:0}.class-row strong,.class-row small{display:block}.class-row small{margin-top:.25rem;opacity:.62}.class-actions{display:flex;gap:.5rem;flex-wrap:wrap}.class-actions .button{font-size:.8rem}.archive-label{opacity:.7}@media(max-width:750px){.class-row{grid-template-columns:1fr}.class-actions{justify-content:flex-start}}</style>
  <script is:inline>
    const root=document.querySelector('#classes-admin'); const presets=JSON.parse(root.dataset.presets||'{}'); const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]); let all=[];
    const load=async()=>{const r=await fetch('/api/admin/classes');if(r.status===401){location='/admin-login';return}const d=await r.json();all=d.classes||[];const today=new Date().toISOString().slice(0,10);const upcoming=all.filter(c=>c.end_date>=today);const archived=all.filter(c=>c.end_date<today).sort((a,b)=>b.end_date.localeCompare(a.end_date));const row=c=>`<div class="class-row"><div><strong>${esc(c.title)}</strong><small>${esc(c.type_id)}</small></div><span>${esc(c.start_date)} – ${esc(c.end_date)}</span><span>${c.student_count||0}${c.capacity?' / '+c.capacity:''} students</span><div class="class-actions"><a class="button outline" href="/class-students/${encodeURIComponent(c.id)}">Roster</a></div></div>`;document.querySelector('#upcoming').innerHTML=upcoming.length?upcoming.map(row).join(''):'<div class="admin-empty">No upcoming classes.</div>';document.querySelector('#archived').innerHTML=archived.length?archived.map(c=>row(c).replace('</div></div>','<span class="archive-label">Archived</span></div></div>')):'<div class="admin-empty">No archived classes yet.</div>'};
    document.querySelector('#typeId').addEventListener('change',e=>{const p=presets[e.target.value];document.querySelector('#title').value=p?.name||'';document.querySelector('#description').value=p?.description||'';document.querySelector('#notes').value=p?.notes||'';document.querySelector('#price').value=p?.defaultPriceCents!=null?(p.defaultPriceCents/100).toFixed(2):'';document.querySelector('#schedule').value=p?.schedule||'';document.querySelector('#locationName').value=p?.locationName||'';document.querySelector('#locationAddress').value=p?.locationAddress||'';});
    document.querySelector('#class-form').addEventListener('submit',async e=>{e.preventDefault();const body={typeId:typeId.value,title:title.value,startDate:startDate.value,endDate:endDate.value,price:price.value,schedule:schedule.value,capacity:capacity.value,locationName:locationName.value,locationAddress:locationAddress.value,parking:parking.value,whereToGo:whereToGo.value,paymentUrl:paymentUrl.value,description:description.value,notes:notes.value};const r=await fetch('/api/admin/classes',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(body)});const d=await r.json();result.textContent=r.ok?'Class created.':(d.error||'Unable to create class.');if(r.ok){e.target.reset();load()}});load();
  </script>
</BaseLayout>
