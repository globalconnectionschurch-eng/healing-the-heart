---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAdminRequest } from '../../lib/server';
if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
---
<BaseLayout title="Email History | Healing the Heart Admin">
<section class="admin-shell"><div class="admin-header"><div><p class="eyebrow">Admin</p><h1>Email history</h1><p>A record of emails sent and delivery failures.</p></div><a class="button outline" href="/admin">← Dashboard</a></div>
<section class="admin-section"><div class="admin-section-title"><div><p class="eyebrow">Communication log</p><h2>Recent emails</h2></div><select id="class-filter"><option value="">All classes</option></select></div><div id="email-list"><div class="admin-empty">Loading…</div></div></section></section>
<script is:inline>
const filter=document.querySelector('#class-filter'),list=document.querySelector('#email-list');const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
async function loadClasses(){const r=await fetch('/api/admin/classes');if(r.status===401)return location='/admin-login';const d=await r.json();filter.innerHTML='<option value="">All classes</option>'+(d.classes||[]).map(c=>`<option value="${esc(c.id)}">${esc(c.title)}</option>`).join('');}
async function loadLogs(){const q=filter.value?'?classId='+encodeURIComponent(filter.value):'';const r=await fetch('/api/admin/email-history'+q);if(r.status===401)return location='/admin-login';const d=await r.json();list.innerHTML=(d.logs||[]).map(x=>`<article class="log"><div><strong>${esc(x.student_name||'Broadcast')}</strong><small>${esc(x.class_title||'')}</small></div><div>${esc(x.recipient_email)}</div><div><strong>${esc(x.subject)}</strong></div><div><b class="${esc(x.status)}">${esc(x.status)}</b><small>${x.sent_at?esc(new Date(x.sent_at).toLocaleString()):''}</small></div>${x.error?`<p>${esc(x.error)}</p>`:''}</article>`).join('')||'<div class="admin-empty">No emails have been logged yet.</div>';}
filter.addEventListener('change',loadLogs);loadClasses().then(loadLogs);
</script><style>#email-list{display:grid;gap:.7rem}.log{display:grid;grid-template-columns:1.2fr 1.4fr 1.5fr .8fr;gap:1rem;padding:1rem;border:1px solid rgba(0,0,0,.1);border-radius:14px;background:#fff}.log small{display:block;opacity:.6;margin-top:.2rem}.log .sent{color:#28633d}.log .failed{color:#9b2c2c}.log p{grid-column:1/-1;margin:0;padding:.6rem;background:#fff5f5;border-radius:8px}@media(max-width:760px){.log{grid-template-columns:1fr 1fr}.log>div:nth-child(2),.log>div:nth-child(3){grid-column:1/-1}}</style>
</BaseLayout>
