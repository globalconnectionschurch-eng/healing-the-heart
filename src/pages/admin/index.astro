---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAdminRequest } from '../../lib/server';
if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
---
<BaseLayout title="Admin | Healing the Heart">
  <section class="admin-shell">
    <div class="admin-header"><div><p class="eyebrow">Healing the Heart</p><h1>Admin dashboard</h1><p>A simple home base for managing classes, registrations, people, giving, and communication.</p></div><div class="actions"><a class="button outline" href="/">View website</a><button class="button outline" id="logout">Sign out</button></div></div>
    <nav class="admin-menu" aria-label="Admin menu"><a href="/admin" aria-current="page">Dashboard</a><a href="/admin/classes">Classes</a><a href="/admin/registrations">Registrations</a><a href="/admin/attendees">Attendee Directory</a><a href="/admin/discounts">Personal Discounts</a><a href="/admin/giving">Giving</a><a href="/admin/giving-profile">Giving Profiles</a><a href="/admin/blast-email">Blast Email</a><a href="/admin/templates">Email Templates</a><a href="/admin/email-history">Email History</a></nav>
    <div class="admin-welcome"><div><p class="eyebrow">Welcome back</p><h2>What would you like to manage?</h2><p>Each area now has its own workspace so the dashboard stays focused and uncluttered.</p></div></div>
    <div class="admin-actions clean-actions">
      <a class="admin-action" href="/admin/classes"><span>＋</span><div><strong>Classes</strong><small>Create classes, manage dates and prices, and access private rosters.</small></div><b>→</b></a>
      <a class="admin-action" href="/admin/registrations"><span>◉</span><div><strong>Registrations</strong><small>View class registrations, add students, batch import, and send class emails.</small></div><b>→</b></a>
      <a class="admin-action" href="/admin/attendees"><span>◎</span><div><strong>Attendee Directory</strong><small>Manage the permanent student directory and individual profiles.</small></div><b>→</b></a>
      <a class="admin-action" href="/admin/discounts"><span>%</span><div><strong>Personal Discounts</strong><small>Assign private percentage discounts to individual attendee profiles.</small></div><b>→</b></a>
      <a class="admin-action" href="/admin/giving"><span>♥</span><div><strong>Giving</strong><small>Record terminal and other gifts, track transaction details, and connect gifts to people.</small></div><b>→</b></a>
      <a class="admin-action" href="/admin/giving-profile"><span>◌</span><div><strong>Giving Profiles</strong><small>Search any attendee and see their completed giving total and transaction history.</small></div><b>→</b></a>
      <a class="admin-action" href="/admin/blast-email"><span>✉</span><div><strong>Blast Email</strong><small>Send a message to students who have opted into mass email.</small></div><b>→</b></a>
      <a class="admin-action" href="/admin/templates"><span>✎</span><div><strong>Email Templates</strong><small>Edit saved messages or create new reusable templates.</small></div><b>→</b></a>
      <a class="admin-action" href="/admin/email-history"><span>↗</span><div><strong>Email History</strong><small>Review previous messages and delivery status.</small></div><b>→</b></a>
    </div>
  </section>
  <style>.admin-welcome{margin:1.5rem 0;padding:2rem;border:1px solid rgba(0,0,0,.08);border-radius:22px;background:linear-gradient(135deg,#faf9f6,#fff)}.admin-welcome h2{margin:.2rem 0 .4rem}.admin-welcome p:not(.eyebrow){margin:0;color:#68706a}.clean-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}.clean-actions .admin-action{position:relative;min-height:130px;padding:1.3rem 3.2rem 1.3rem 1.3rem}.clean-actions .admin-action b{position:absolute;right:1.2rem;top:50%;font-size:1.25rem;transform:translateY(-50%);opacity:.45}.clean-actions .admin-action:hover b{opacity:1;transform:translate(3px,-50%)}@media(max-width:700px){.clean-actions{grid-template-columns:1fr}.admin-welcome{padding:1.4rem}}</style>
  <script is:inline>document.querySelector('#logout')?.addEventListener('click',async()=>{await fetch('/api/auth/logout',{method:'POST'});location='/admin-login'});</script>
</BaseLayout>
