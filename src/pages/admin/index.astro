---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { classTypePresets } from '../../data/class-types';
---
<BaseLayout title="Admin | Healing the Heart">
  <section class="admin-shell">
    <div class="admin-header"><div><p class="eyebrow">Healing the Heart</p><h1>Admin dashboard</h1><p>Classes, registrations, students, and email communication will live here.</p></div><a class="button outline" href="/">View website</a></div>
    <div class="admin-actions"><a class="admin-action" href="#create-class"><span>＋</span><div><strong>Create a class</strong><small>Choose a class type and auto-fill its starting details.</small></div></a><a class="admin-action" href="#registrations"><span>◉</span><div><strong>Registrations</strong><small>See students registered for each class.</small></div></a><a class="admin-action" href="/admin/templates"><span>✉</span><div><strong>Email templates</strong><small>Edit saved messages or create new ones.</small></div></a></div>
    <section class="admin-section" id="registrations"><div class="admin-section-title"><div><p class="eyebrow">Classes</p><h2>Upcoming classes</h2></div><span class="status-pill">Auto-archive after end date</span></div><div class="admin-table"><div class="admin-row admin-row-head"><span>Class</span><span>Dates</span><span>Students</span><span>Status</span></div><div class="admin-empty">No classes have been added yet. Create the first class below.</div></div></section>
    <section class="admin-section" id="create-class"><div class="admin-section-title"><div><p class="eyebrow">New class</p><h2>Create a class</h2></div></div><form class="admin-form"><label>Class type<select><option value="">Choose a class type</option>{classTypePresets.map((type) => <option>{type.name}</option>)}</select></label><div class="form-grid"><label>Class name<input placeholder="Auto-filled from class type" /></label><label>Price<input type="number" min="0" step="0.01" placeholder="0.00" /></label><label>Start date<input type="date" /></label><label>End date<input type="date" /></label><label>Class/session time<input placeholder="e.g. Thursdays, 7:30 PM – 9:30 PM" /></label><label>Capacity<input type="number" min="1" placeholder="Optional" /></label></div><div class="form-grid"><label>Location name<input placeholder="e.g. Great Church" /></label><label>Location address<input placeholder="Street, City, Province" /></label></div><label>Admin notes<textarea placeholder="Schedule, parking, facilitator notes, or other class-specific details."></textarea></label><div class="actions left"><button class="button primary" type="button">Save class</button><button class="button outline" type="button">Save as draft</button></div><p class="field-note">The final backend will automatically move a class out of Upcoming when its end date has passed. Registrations remain attached to the archived class.</p></form></section>
    <section class="admin-section"><div class="admin-section-title"><div><p class="eyebrow">Students</p><h2>Manual student add</h2></div></div><form class="admin-form"><div class="form-grid"><label>Name<input /></label><label>Email<input type="email" /></label></div><label>Class<select><option>Select a class</option></select></label><div class="actions left"><button class="button primary" type="button">Add student</button><button class="button outline" type="button">Send registration email</button></div><p class="field-note">A manually added student will receive the saved registration-required email and must still complete the online registration form.</p></form></section>
    <section class="admin-section"><div class="admin-section-title"><div><p class="eyebrow">Class communication</p><h2>Send an email to a class</h2></div></div><form class="admin-form"><label>Class<select><option>Select an upcoming class</option></select></label><label>Email template<select><option>8-Week Class — Upcoming Details</option><option>8-Week Class — Day Before Reminder</option><option>Choose another saved template…</option></select></label><div class="actions left"><button class="button primary" type="button">Send to registered students</button></div><p class="field-note">Every send will be logged so the admin can see what was sent, when, and to which class.</p></form></section>
  </section>
</BaseLayout>
