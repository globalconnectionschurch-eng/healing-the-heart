---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { classTypePresets } from '../../data/class-types';
import { isAdminRequest } from '../../lib/server';

if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
const presetData = Object.fromEntries(classTypePresets.map((type) => [type.id, type]));
---
<BaseLayout title="Admin | Healing the Heart">
  <section class="admin-shell" id="admin-root" data-preset-data={JSON.stringify(presetData)}>
    <div class="admin-header"><div><p class="eyebrow">Healing the Heart</p><h1>Admin dashboard</h1><p>Classes, registrations, students, and email communication.</p></div><div class="actions"><a class="button outline" href="/">View website</a><button class="button outline" id="logout">Sign out</button></div></div>
    <div class="admin-actions"><a class="admin-action" href="#create-class"><span>＋</span><div><strong>Create a class</strong><small>Choose a class type and auto-fill its starting details.</small></div></a><a class="admin-action" href="#registrations"><span>◉</span><div><strong>Registrations</strong><small>See students registered for each class.</small></div></a><a class="admin-action" href="/admin/templates"><span>✉</span><div><strong>Email templates</strong><small>Edit saved messages or create new ones.</small></div></a></div>
    <section class="admin-section" id="registrations"><div class="admin-section-title"><div><p class="eyebrow">Classes</p><h2>Upcoming classes</h2></div><span class="status-pill">Past end dates are automatically archived</span></div><div id="class-list" class="admin-table"><div class="admin-empty">Loading…</div></div></section>
    <details class="admin-section admin-collapsible" id="create-class"><summary><div><p class="eyebrow">New class</p><h2>Create a class</h2><p>Choose a class type and open this section when you're ready to create it.</p></div><span class="collapsible-icon" aria-hidden="true">＋</span></summary>
      <form id="class-form" class="admin-form"><label>Class type<select id="class-type" name="typeId" required><option value="">Choose a class type</option>{classTypePresets.map((type) => <option value={type.id}>{type.name}</option>)}</select></label><div class="form-grid"><label>Class name<input id="class-name" name="title" required placeholder="Auto-filled from class type" /></label><label>Price<input name="price" type="number" min="0" step="0.01" placeholder="0.00" /></label><label>Start date<input id="start-date" name="startDate" type="date" required /></label><label>End date<input id="end-date" name="endDate" type="date" required /></label><label>Class/session time<input name="schedule" placeholder="e.g. Thursdays, 7:30 PM – 9:30 PM" /></label><label>Capacity<input name="capacity" type="number" min="1" placeholder="Optional" /></label></div><div class="form-grid"><label>Location name<input name="locationName" placeholder="e.g. Great Church" /></label><label>Location address<input name="locationAddress" placeholder="205 Main Street, Spruce Grove" /></label></div><div class="form-grid"><label>Parking<input name="parking" placeholder="Parking instructions" /></label><label>Where to go<input name="whereToGo" placeholder="Main auditorium, room, etc." /></label></div><label>Payment link <span class="field-note">Optional — add the checkout URL for this class.</span><input name="paymentUrl" type="url" placeholder="https://…" /></label><label>Class description<textarea id="class-description" name="description" rows="4"></textarea></label><label>Admin notes<textarea id="class-notes" name="notes" rows="3"></textarea></label><div class="actions left"><button class="button primary" type="submit">Save class</button></div><p id="class-result" class="field-note"></p></form>
    </details>
    <section class="admin-section" id="student-management"><div class="admin-section-title"><div><p class="eyebrow">Students</p><h2>Registrations</h2></div></div><label>Class<select id="student-class"><option value="">Select a class</option></select></label><div id="student-list" class="admin-table" style="margin-top:1rem"></div><h3 style="margin-top:2rem">Manually add a student</h3><form id="student-form" class="admin-form"><div class="form-grid"><label>Name<input name="name" required /></label><label>Email<input name="email" type="email" required /></label></div><label>Class<select name="classId" id="manual-class" required><option value="">Select a class</option></select></label><button class="button primary" type="submit">Add student + send registration email</button><p id="student-result" class="field-note"></p></form></section>
    <section class="admin-section" id="emails"><div class="admin-section-title"><div><p class="eyebrow">Class communication</p><h2>Send an email to a class</h2></div></div><form id="email-form" class="admin-form"><label>Class<select name="classId" id="email-class" required><option value="">Select an upcoming class</option></select></label><label>Email template<select name="templateId" id="email-template" required><option value="">Loading templates…</option></select></label><button class="button primary" type="submit">Send to registered students</button><p id="email-result" class="field-note"></p></form></section>
  </section>
  <style>
    .admin-collapsible>summary{list-style:none;cursor:pointer;display:flex;align-items:center;justify-content:space-between;gap:1rem}.admin-collapsible>summary::-webkit-details-marker{display:none}.admin-collapsible>summary h2{margin:.15rem 0}.admin-collapsible>summary p:not(.eyebrow){margin:0;opacity:.7}.collapsible-icon{font-size:1.5rem;line-height:1;transition:transform .2s}.admin-collapsible[open] .collapsible-icon{transform:rotate(45deg)}
    .private-roster{grid-column:1/-1;border-top:1px solid rgba(0,0,0,.08);padding-top:1rem;margin-top:.25rem;display:flex;align-items:center;gap:.6rem;flex-wrap:wrap}.private-roster input{width:180px;padding:.55rem .7rem;border:1px solid #ccc;border-radius:8px}.private-roster .button{padding:.55rem .8rem;font-size:.82rem}.private-note{font-size:.8rem;opacity:.7}.registration-card{border:1px solid rgba(0,0,0,.12);border-radius:16px;margin-bottom:.8rem;background:#fff;overflow:hidden}.registration-details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.8rem 1.2rem;padding:1.2rem;border-top:1px solid rgba(0,0,0,.08);background:#faf9f6}.registration-detail{display:grid;gap:.2rem}.registration-detail strong{font-size:.72rem;text-transform:uppercase;letter-spacing:.07em;opacity:.6}.registration-detail span{white-space:pre-wrap;line-height:1.45}.registration-detail:nth-child(9),.registration-detail:nth-child(10),.registration-detail:nth-child(11){grid-column:1/-1}@media(max-width:700px){.registration-details{grid-template-columns:1fr}.registration-detail:nth-child(9),.registration-detail:nth-child(10),.registration-detail:nth-child(11){grid-column:auto}}
  </style>
  <script>
    const root=document.querySelector('#admin-root');const presetData=JSON.parse(root?.getAttribute('data-preset-data')||'{}');const classList=document.querySelector('#class-list');const selects=[document.querySelector('#student-class'),document.querySelector('#manual-class'),document.querySelector('#email-class')];let classes=[];const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);
    async function loadClasses(){const response=await fetch('/api/admin/classes');if(response.status===401)return location.href='/admin-login';const data=await response.json();classes=data.classes||[];classList.innerHTML=classes.length?classes.map(c=>`<div class="admin-row"><span><strong>${esc(c.title)}</strong><small>${esc(c.type_id)}</small></span><span>${esc(c.start_date)} – ${esc(c.end_date)}</span><span>${c.student_count||0}${c.capacity?` / ${c.capacity}`:''}</span><span class="status-pill">${new Date(c.end_date+'T23:59:59')>=new Date()?'Upcoming':'Archived'}</span><div class="private-roster"><strong>Private student list</strong>${c.student_link_password_hash?`<a class="button outline" href="/class-students/${encodeURIComponent(c.id)}" target="_blank">Open student list</a><span class="private-note">Share this link with the password. The list refreshes with new registrations.</span>`:'<span class="private-note">Set a password to create a private shareable roster.</span>'}<input class="student-link-password" type="password" minlength="6" placeholder="Password (6+ chars)" aria-label="Private student list password" /><button class="button outline set-student-link" data-id="${esc(c.id)}" type="button">${c.student_link_password_hash?'Change password':'Set password'}</button><span class="private-note password-result"></span></div></div>`).join(''):'<div class="admin-empty">No classes yet. Create the first one below.</div>';selects.forEach(select=>{if(select)select.innerHTML='<option value="">Select a class</option>'+classes.filter(c=>new Date(c.end_date+'T23:59:59')>=new Date()).map(c=>`<option value="${esc(c.id)}">${esc(c.title)} · ${esc(c.start_date)}</option>`).join('')});}
    async function loadTemplates(){const response=await fetch('/api/admin/templates');if(response.status!==200)return;const data=await response.json();document.querySelector('#email-template').innerHTML='<option value="">Select a template</option>'+(data.templates||[]).map(t=>`<option value="${esc(t.id)}">${esc(t.name)}</option>`).join('');}
    document.querySelector('#class-type').addEventListener('change',e=>{const p=presetData[e.target.value];document.querySelector('#class-name').value=p?.name||'';document.querySelector('#class-description').value=p?.description||'';document.querySelector('#class-notes').value=p?.notes||'';if(e.target.value==='eight-week-in-person')document.querySelector('[name="schedule"]').value='Thursdays, 7:30 PM – 9:30 PM';});
    document.querySelector('#start-date').addEventListener('change',e=>{if(document.querySelector('#class-type').value!=='eight-week-in-person')return;const start=new Date(`${e.target.value}T12:00:00`);if(Number.isNaN(start.getTime()))return;start.setDate(start.getDate()+55);document.querySelector('#end-date').value=start.toISOString().slice(0,10);});
    document.querySelector('#class-form').addEventListener('submit',async e=>{e.preventDefault();const result=document.querySelector('#class-result');result.textContent='Saving…';const response=await fetch('/api/admin/classes',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});const data=await response.json();result.textContent=response.ok?'Class saved.':(data.error||'Unable to save class.');if(response.ok){e.target.reset();loadClasses();}});
    classList.addEventListener('click',async e=>{const button=e.target.closest('.set-student-link');if(!button)return;const row=button.closest('.admin-row');const input=row.querySelector('.student-link-password');const result=row.querySelector('.password-result');if(input.value.length<6){result.textContent='Use at least 6 characters.';return;}button.disabled=true;result.textContent='Saving…';const response=await fetch('/api/admin/classes',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({action:'set-student-link-password',classId:button.dataset.id,password:input.value})});const data=await response.json();result.textContent=response.ok?'Password saved.':(data.error||'Unable to save.');button.disabled=false;if(response.ok){input.value='';loadClasses();}});
    document.querySelector('#student-class').addEventListener('change',async e=>{const target=document.querySelector('#student-list');if(!e.target.value){target.innerHTML='';return;}const response=await fetch('/api/admin/students?classId='+encodeURIComponent(e.target.value));const data=await response.json();target.innerHTML=(data.students||[]).map((s,index)=>`<div class="registration-card"><div class="admin-row"><span><strong>${esc(s.name)}</strong><small>${esc(s.email)}</small></span><span>${esc(s.phone||'')}</span><span>${esc(s.source)}</span><span>${esc(s.payment_status)}</span><button type="button" class="button outline details-toggle" data-index="${index}">View details</button></div><div class="registration-details" id="registration-details-${index}" hidden>${[['Name',s.name],['Email',s.email],['Phone',s.phone],['Address',s.address],['Date of birth',s.date_of_birth],['Marital status',s.marital_status],['Church',s.church],['Senior pastor',s.sr_pastor],['How they heard about us',s.how_heard],['What they hope to gain',s.goals],['Smoking/drinking concern',s.smoking_drinking],['Anything else they shared',s.anything_else],['Verification code',s.verification_code],['Payment status',s.payment_status],['Registration source',s.source],['Registered at',s.registered_at]].map(([label,value])=>`<div class="registration-detail"><strong>${esc(label)}</strong><span>${esc(value||'—')}</span></div>`).join('')}</div></div>`).join('')||'<div class="admin-empty">No registrations yet.</div>';target.querySelectorAll('.details-toggle').forEach(button=>button.addEventListener('click',()=>{const panel=document.querySelector('#registration-details-'+button.dataset.index);panel.hidden=!panel.hidden;button.textContent=panel.hidden?'View details':'Hide details';}));});
    document.querySelector('#student-form').addEventListener('submit',async e=>{e.preventDefault();const result=document.querySelector('#student-result');result.textContent='Adding…';const response=await fetch('/api/admin/students',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});const data=await response.json();result.textContent=response.ok?`Student added. Verification code: ${data.verificationCode}`:(data.error||'Unable to add student.');if(response.ok){e.target.reset();loadClasses();}});
    document.querySelector('#email-form').addEventListener('submit',async e=>{e.preventDefault();if(!confirm('Send this email to everyone registered for this class?'))return;const resultEl=document.querySelector('#email-result');resultEl.textContent='Sending…';const response=await fetch('/api/admin/send-email',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(Object.fromEntries(new FormData(e.target)))});const result=await response.json();resultEl.textContent=response.ok?`Sent: ${result.sentCount}. Failed: ${result.failedCount}.`:(result.error||'Unable to send.');});
    document.querySelector('#logout').addEventListener('click',async()=>{await fetch('/api/admin-login',{method:'DELETE'});location.href='/admin-login'});loadClasses();loadTemplates();
  </script>
</BaseLayout>
