---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { classTypePresets } from '../../data/class-types';
import { isAdminRequest } from '../../lib/server';
if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
const presetNames = Object.fromEntries(classTypePresets.map((type) => [type.id, type.name]));
---
<BaseLayout title="Admin | Healing the Heart">
  <section class="admin-shell">
    <div class="admin-header"><div><p class="eyebrow">Healing the Heart</p><h1>Admin dashboard</h1><p>Classes, registrations, students, and email communication.</p></div><div class="actions"><a class="button outline" href="/">View website</a><button class="button outline" id="logout">Sign out</button></div></div>
    <div class="admin-actions"><a class="admin-action" href="#create-class"><span>＋</span><div><strong>Create a class</strong><small>Choose a class type and auto-fill its starting details.</small></div></a><a class="admin-action" href="#registrations"><span>◉</span><div><strong>Registrations</strong><small>See students registered for each class.</small></div></a><a class="admin-action" href="/admin/templates"><span>✉</span><div><strong>Email templates</strong><small>Edit saved messages or create new ones.</small></div></a></div>

    <section class="admin-section" id="registrations"><div class="admin-section-title"><div><p class="eyebrow">Classes</p><h2>Upcoming classes</h2></div><span class="status-pill">Past end dates are automatically archived</span></div><div id="class-list" class="admin-table"><div class="admin-empty">Loading…</div></div></section>

    <section class="admin-section" id="create-class"><div class="admin-section-title"><div><p class="eyebrow">New class</p><h2>Create a class</h2></div></div>
      <form id="class-form" class="admin-form"><label>Class type<select id="class-type" name="typeId" required><option value="">Choose a class type</option>{classTypePresets.map((type) => <option value={type.id} data-name={type.name}>{type.name}</option>)}</select></label>
        <div class="form-grid"><label>Class name<input id="class-name" name="title" required placeholder="Auto-filled from class type" /></label><label>Price<input name="price" type="number" min="0" step="0.01" placeholder="0.00" /></label><label>Start date<input name="startDate" type="date" required /></label><label>End date<input name="endDate" type="date" required /></label><label>Class/session time<input name="schedule" placeholder="e.g. Thursdays, 7:30 PM – 9:30 PM" /></label><label>Capacity<input name="capacity" type="number" min="1" placeholder="Optional" /></label></div>
        <div class="form-grid"><label>Location name<input name="locationName" placeholder="e.g. Great Church" /></label><label>Location address<input name="locationAddress" placeholder="205 Main Street, Spruce Grove" /></label></div>
        <div class="form-grid"><label>Parking<input name="parking" placeholder="Parking instructions" /></label><label>Where to go<input name="whereToGo" placeholder="Main auditorium, room, etc." /></label></div>
        <label>Class description<textarea name="description" rows="4"></textarea></label><label>Admin notes<textarea name="notes" rows="3"></textarea></label>
        <div class="actions left"><button class="button primary" type="submit">Save class</button></div><p id="class-result" class="field-note"></p>
      </form>
    </section>

    <section class="admin-section" id="student-management"><div class="admin-section-title"><div><p class="eyebrow">Students</p><h2>Registrations</h2></div></div>
      <label>Class<select id="student-class"><option value="">Select a class</option></select></label><div id="student-list" class="admin-table" style="margin-top:1rem"></div>
      <h3 style="margin-top:2rem">Manually add a student</h3><form id="student-form" class="admin-form"><div class="form-grid"><label>Name<input name="name" required /></label><label>Email<input name="email" type="email" required /></label></div><label>Class<select name="classId" id="manual-class" required><option value="">Select a class</option></select></label><button class="button primary" type="submit">Add student + send registration email</button><p id="student-result" class="field-note"></p></form>
    </section>

    <section class="admin-section" id="emails"><div class="admin-section-title"><div><p class="eyebrow">Class communication</p><h2>Send an email to a class</h2></div></div><form id="email-form" class="admin-form"><label>Class<select name="classId" id="email-class" required><option value="">Select an upcoming class</option></select></label><label>Email template<select name="templateId" id="email-template" required><option value="">Loading templates…</option></select></label><button class="button primary" type="submit">Send to registered students</button><p id="email-result" class="field-note"></p></form></section>
  </section>
  <script is:inline define:vars={{ presetNames }}>
    const classList = document.querySelector('#class-list');
    const selects = [document.querySelector('#student-class'),document.querySelector('#manual-class'),document.querySelector('#email-class')];
    let classes=[];
    const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    async function loadClasses(){const r=await fetch('/api/admin/classes');if(r.status===401){location='/admin-login';return;}const data=await r.json();classes=data.classes||[];classList.innerHTML=classes.length?classes.map(c=>`<div class="admin-row"><span><strong>${esc(c.title)}</strong><small>${esc(c.type_id)}</small></span><span>${esc(c.start_date)} – ${esc(c.end_date)}</span><span>${c.student_count||0}${c.capacity?` / ${c.capacity}`:''}</span><span class="status-pill">${new Date(c.end_date+'T23:59:59')>=new Date()?'Upcoming':'Archived'}</span></div>`).join(''):'<div class="admin-empty">No classes yet. Create the first one below.</div>';selects.forEach(s=>{s.innerHTML='<option value="">Select a class</option>'+classes.filter(c=>new Date(c.end_date+'T23:59:59')>=new Date()).map(c=>`<option value="${c.id}">${esc(c.title)} · ${esc(c.start_date)}</option>`).join('')});}
    async function loadTemplates(){const r=await fetch('/api/admin/templates');if(r.status!==200)return;const data=await r.json();document.querySelector('#email-template').innerHTML='<option value="">Select a template</option>'+(data.templates||[]).map(t=>`<option value="${t.id}">${esc(t.name)}</option>`).join('');}
    document.querySelector('#class-type').addEventListener('change',e=>document.querySelector('#class-name').value=presetNames[e.target.value]||'');
    document.querySelector('#class-form').addEventListener('submit',async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(e.target));const r=await fetch('/api/admin/classes',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});document.querySelector('#class-result').textContent=r.ok?'Class saved.':'Unable to save class.';if(r.ok){e.target.reset();loadClasses();}});
    document.querySelector('#student-class').addEventListener('change',async e=>{const target=document.querySelector('#student-list');if(!e.target.value){target.innerHTML='';return;}const r=await fetch('/api/admin/students?classId='+encodeURIComponent(e.target.value));const data=await r.json();target.innerHTML=(data.students||[]).map(s=>`<div class="admin-row"><span><strong>${esc(s.name)}</strong><small>${esc(s.email)}</small></span><span>${esc(s.phone||'')}</span><span>${esc(s.source)}</span><span>${esc(s.payment_status)}</span></div>`).join('')||'<div class="admin-empty">No registrations yet.</div>';});
    document.querySelector('#student-form').addEventListener('submit',async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(e.target));const r=await fetch('/api/admin/students',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});document.querySelector('#student-result').textContent=r.ok?'Student added and registration email sent.':'Unable to add student.';if(r.ok){e.target.reset();loadClasses();}});
    document.querySelector('#email-form').addEventListener('submit',async e=>{e.preventDefault();if(!confirm('Send this email to everyone registered for this class?'))return;const data=Object.fromEntries(new FormData(e.target));const r=await fetch('/api/admin/send-email',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});const result=await r.json();document.querySelector('#email-result').textContent=r.ok?`Sent: ${result.sentCount}. Failed: ${result.failedCount}.`:(result.error||'Unable to send.');});
    document.querySelector('#logout').addEventListener('click',async()=>{await fetch('/api/admin-login',{method:'DELETE'});location='/admin-login';});
    loadClasses();loadTemplates();
  </script>
</BaseLayout>
