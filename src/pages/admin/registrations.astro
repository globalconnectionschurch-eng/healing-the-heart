---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAdminRequest } from '../../lib/server';
if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
---
<BaseLayout title="Registrations | Healing the Heart Admin">
  <section class="admin-shell" id="admin-root">
    <div class="admin-header"><div><p class="eyebrow">Admin · Registrations</p><h1>Registrations</h1><p>Manage class rosters, add students, and send class communication from one focused workspace.</p></div><a class="button outline" href="/admin">← Dashboard</a></div>
    <nav class="admin-menu" aria-label="Admin menu"><a href="/admin">Dashboard</a><a href="/admin/classes">Classes</a><a href="/admin/registrations" aria-current="page">Registrations</a><a href="/admin/attendees">Attendee Directory</a><a href="/admin/blast-email">Blast Email</a><a href="/admin/templates">Email Templates</a><a href="/admin/email-history">Email History</a></nav>
    <section class="admin-section"><div class="admin-section-title"><div><p class="eyebrow">Roster</p><h2>Select a class</h2></div><span id="count" class="status-pill">0 students</span></div><select id="class-select"><option value="">Select a class</option></select><div id="list" class="admin-table" style="margin-top:1rem"><div class="admin-empty">Select a class to view registrations.</div></div></section>
    <section class="admin-section" id="student-management"><div class="admin-section-title"><div><p class="eyebrow">Manual entry</p><h2>Add a student</h2><p>Add one person or use <strong>＋ Add batch</strong> for a pasted list.</p></div></div><form id="student-form" class="admin-form"><div class="form-grid"><label>Name<input name="name" required></label><label>Email<input name="email" type="email" required></label></div><label>Class<select name="classId" id="manual-class" required><option value="">Select a class</option></select></label><label>Email action<select name="emailAction"><option value="registration">Add student + send registration email</option><option value="custom">Add student + send customer email</option><option value="none">Add student with no other action</option></select></label><button class="button primary">Add student</button><p id="student-result" class="field-note"></p></form></section>
    <section class="admin-section"><div class="admin-section-title"><div><p class="eyebrow">Class communication</p><h2>Send an email to this class</h2></div></div><form id="email-form" class="admin-form"><label>Class<select id="email-class" required><option value="">Select a class</option></select></label><label>Template<select id="email-template" required><option value="">Loading templates…</option></select></label><button class="button primary">Send to registered students</button><p id="email-result" class="field-note"></p></form></section>
  </section>
  <style>.registration-card{margin:.65rem 0;border:1px solid rgba(0,0,0,.08);border-radius:14px;background:#fff;overflow:hidden}.registration-summary{display:grid;grid-template-columns:minmax(0,1.5fr) auto auto auto;gap:1rem;align-items:center;padding:1rem 1.1rem}.registration-summary strong,.registration-summary small{display:block}.registration-summary small{opacity:.6;margin-top:.2rem}.registration-summary .button{font-size:.8rem}.detail-panel{padding:1rem 1.1rem;background:#faf9f6;border-top:1px solid rgba(0,0,0,.07);display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:.75rem 1.2rem}.detail-panel div{display:grid;gap:.2rem}.detail-panel strong{font-size:.7rem;text-transform:uppercase;letter-spacing:.06em;opacity:.58}.detail-panel span{white-space:pre-wrap}@media(max-width:750px){.registration-summary{grid-template-columns:1fr}.detail-panel{grid-template-columns:1fr}}</style>
  <script is:inline>
    const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);let classes=[];const loadClasses=async()=>{const r=await fetch('/api/admin/classes');if(r.status===401){location='/admin-login';return}classes=(await r.json()).classes||[];const opts='<option value="">Select a class</option>'+classes.map(c=>`<option value="${esc(c.id)}">${esc(c.title)} · ${esc(c.start_date)}</option>`).join('');['class-select','manual-class','email-class'].forEach(id=>document.getElementById(id).innerHTML=opts)};const loadStudents=async id=>{if(!id){list.innerHTML='<div class="admin-empty">Select a class to view registrations.</div>';count.textContent='0 students';return}const r=await fetch('/api/class-students/'+encodeURIComponent(id));if(!r.ok){list.innerHTML='<div class="admin-empty">Unable to load registrations.</div>';return}const d=await r.json();const students=d.students||[];count.textContent=`${students.length} student${students.length===1?'':'s'}`;list.innerHTML=students.length?students.map((s,i)=>`<article class="registration-card"><div class="registration-summary"><div><strong>${esc(s.name)}</strong><small>${esc(s.email)}</small></div><span class="status-pill">${esc(s.status||'registered')}</span><span>${esc(s.payment_status||'pending')}</span><button type="button" class="button outline details" data-index="${i}">View details</button></div><div class="detail-panel" hidden>${[['Phone',s.phone],['Address',s.address],['Date of birth',s.date_of_birth],['Marital status',s.marital_status],['Church',s.church],['Sr. Pastor',s.sr_pastor],['How heard',s.how_heard],['Goals',s.goals],['Smoking / drinking concern',s.smoking_drinking],['Anything else',s.anything_else],['Verification code',s.verification_code]].map(([k,v])=>`<div><strong>${k}</strong><span>${esc(v||'—')}</span></div>`).join('')}</div></article>`).join(''):'<div class="admin-empty">No registrations for this class.</div>';list.querySelectorAll('.details').forEach(b=>b.addEventListener('click',()=>{const p=b.closest('.registration-card').querySelector('.detail-panel');p.hidden=!p.hidden;b.textContent=p.hidden?'View details':'Hide details'}))};document.getElementById('class-select').addEventListener('change',e=>{document.getElementById('manual-class').value=e.target.value;document.getElementById('email-class').value=e.target.value;loadStudents(e.target.value)});document.getElementById('student-form').addEventListener('submit',async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(e.target));const r=await fetch('/api/admin/students',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});const d=await r.json();document.getElementById('student-result').textContent=r.ok?'Student added.':(d.error||'Unable to add student.');if(r.ok){e.target.reset();loadStudents(document.getElementById('class-select').value)}});document.getElementById('email-form').addEventListener('submit',async e=>{e.preventDefault();const r=await fetch('/api/admin/send-email',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({classId:document.getElementById('email-class').value,templateId:document.getElementById('email-template').value})});const d=await r.json();document.getElementById('email-result').textContent=r.ok?`Sent ${d.sentCount||0} emails.`:(d.error||'Unable to send email.')});(async()=>{await loadClasses();const r=await fetch('/api/admin/templates');if(r.ok){const d=await r.json();document.getElementById('email-template').innerHTML='<option value="">Select a template</option>'+(d.templates||[]).map(t=>`<option value="${esc(t.id)}">${esc(t.name)}</option>`).join('')}})();
  </script>
</BaseLayout>
