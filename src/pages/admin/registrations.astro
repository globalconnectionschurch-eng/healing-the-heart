---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAdminRequest } from '../../lib/server';
if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
---
<BaseLayout title="Registrations | Healing the Heart Admin">
  <section class="admin-shell" id="admin-root">
    <div class="admin-header"><div><p class="eyebrow">Admin · Registrations</p><h1>Registrations</h1><p>Manage class rosters, add students, and send class communication from one focused workspace.</p></div><a class="button outline" href="/admin">← Dashboard</a></div>
    <nav class="admin-menu" aria-label="Admin menu"><a href="/admin">Dashboard</a><a href="/admin/classes">Classes</a><a href="/admin/registrations" aria-current="page">Registrations</a><a href="/admin/attendees">Attendee Directory</a><a href="/admin/blast-email">Blast Email</a><a href="/admin/templates">Email Templates</a><a href="/admin/email-history">Email History</a><a href="/admin/security">Security</a></nav>

    <section class="admin-section registration-picker-section">
      <div class="admin-section-title"><div><p class="eyebrow">Roster</p><h2>Select a class</h2><p>Choose the class you want to manage.</p></div><span id="count" class="status-pill">0 students</span></div>
      <div class="registration-class-picker"><select id="class-select" aria-label="Select a class"><option value="">Select a class</option></select></div>
    </section>

    <section class="admin-section registration-email">
      <details>
        <summary><div><p class="eyebrow">Class communication</p><strong>Send an email to this class</strong><span class="field-note">Send a saved template to everyone registered for the selected class.</span></div></summary>
        <div class="email-inner">
          <form id="email-form" class="admin-form">
            <div class="form-grid"><label>Class<select id="email-class" required><option value="">Select a class</option></select></label><label>Template<select id="email-template" required><option value="">Loading templates…</option></select></label></div>
            <button class="button primary">Send to registered students</button>
            <p id="email-result" class="field-note"></p>
          </form>
        </div>
      </details>
    </section>

    <section class="admin-section registration-students">
      <div class="admin-section-title"><div><p class="eyebrow">Roster</p><h2>Students in this class</h2></div><span id="list-count" class="section-count"></span></div>
      <p id="list-result" class="field-note" role="status" aria-live="polite"></p>
      <div id="list" class="student-grid"><div class="admin-empty">Select a class to view registrations.</div></div>
    </section>

    <section class="admin-section" id="student-management"><div class="admin-section-title"><div><p class="eyebrow">Manual entry</p><h2>Add a student</h2><p>Add one person or use <strong>＋ Add batch</strong> for a pasted list.</p></div></div><form id="student-form" class="admin-form"><div class="form-grid"><label>Name<input name="name" required></label><label>Email<input name="email" type="email" required></label></div><label>Class<select name="classId" id="manual-class" required><option value="">Select a class</option></select></label><label>Email action<select name="emailAction"><option value="registration">Add student + send registration email</option><option value="custom">Add student + send custom email</option><option value="none">Add student with no other action</option></select></label><button class="button primary">Add student</button><p id="student-result" class="field-note"></p></form></section>
  </section>
  <style is:global>
    .registration-students .student-actions{display:flex;align-items:center;justify-content:flex-end;flex-wrap:wrap;gap:.5rem}
    .registration-students .remove-class{color:#a13c32!important;border-color:#e0b8b3!important;background:#fff!important;white-space:nowrap}
    .registration-students .remove-class:hover{background:#fff3f1!important;border-color:#b9685f!important}
    .registration-students .remove-class:disabled{opacity:.5;cursor:wait}
    #list-result:empty{display:none!important}
    @media(max-width:800px){.registration-students .student-actions{grid-column:1/-1;justify-content:flex-start}}
  </style>
  <script is:inline>
    const $=id=>document.getElementById(id);const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'})[c]);let classes=[];
    const loadClasses=async()=>{const r=await fetch('/api/admin/classes');if(r.status===401){location='/admin-login';return}classes=(await r.json()).classes||[];const opts='<option value="">Select a class</option>'+classes.map(c=>`<option value="${esc(c.id)}">${esc(c.title)} · ${esc(c.start_date)}</option>`).join('');['class-select','manual-class','email-class'].forEach(id=>$(id).innerHTML=opts)};
    const loadStudents=async id=>{if(!id){$('list').innerHTML='<div class="admin-empty">Select a class to view registrations.</div>';$('count').textContent='0 students';$('list-count').textContent='';return}const r=await fetch('/api/class-students/'+encodeURIComponent(id));if(!r.ok){let message='Unable to load registrations.';try{const d=await r.json();if(d.error)message=d.error}catch{}$('list').innerHTML=`<div class="admin-empty">${esc(message)}</div>`;return}const d=await r.json();const students=d.students||[];$('count').textContent=`${students.length} student${students.length===1?'':'s'}`;$('list-count').textContent=`${students.length} registered`;$('list').innerHTML=students.length?students.map((s,i)=>`<article class="student-card"><div class="student-summary"><div class="student-identity"><strong>${esc(s.name)}</strong><span>${esc(s.email)}</span></div><span class="status-pill">${esc(s.status||'registered')}</span><span class="student-payment">${esc(s.payment_status||'pending')}</span><div class="student-actions"><button type="button" class="button outline details" data-index="${i}" aria-expanded="false">View details</button><button type="button" class="button outline remove-class" data-registration-id="${esc(s.registration_id)}" data-class-id="${esc(id)}">Remove from class</button></div></div><div class="student-details" hidden>${[['Phone',s.phone],['Address',s.address],['Date of birth',s.date_of_birth],['Marital status',s.marital_status],['Church',s.church],['Sr. Pastor',s.sr_pastor],['How heard',s.how_heard],['Diagnosis',s.diagnosis],['Learning restrictions',s.learning_restrictions],['Adopted',s.adopted],['Major trauma',s.major_trauma],['Grief / loss',s.grief],['In ministry',s.in_ministry],['Dietary restrictions / food allergies',s.dietary_restrictions],['Current crisis',s.current_crisis],['Self-harm history',s.self_harm_history],['Goals',s.goals,'wide'],['Smoking / drinking concern',s.smoking_drinking,'wide'],['Anything else',s.anything_else,'wide'],['Verification code',s.verification_code]].map(([k,v,w])=>`<div class="student-detail ${w||''}"><strong>${k}</strong><span class="${v?'':'not-answered'}">${esc(v||'Not answered')}</span></div>`).join('')}</div></article>`).join(''):'<div class="admin-empty">No registrations for this class.</div>';$('list').querySelectorAll('.details').forEach(b=>b.addEventListener('click',()=>{const p=b.closest('.student-card').querySelector('.student-details');p.hidden=!p.hidden;b.setAttribute('aria-expanded',String(!p.hidden));b.textContent=p.hidden?'View details':'Hide details'}))};
    $('list').addEventListener('click',async e=>{
      const button=e.target.closest('.remove-class');if(!button)return;
      const classId=button.dataset.classId;const registrationId=button.dataset.registrationId;
      const name=button.closest('.student-card')?.querySelector('.student-identity strong')?.textContent||'this student';
      const title=classes.find(c=>c.id===classId)?.title||'this class';
      if(!confirm(`Remove ${name} from ${title}? Their attendee profile and registration history will be kept.`))return;
      const label=button.textContent;button.disabled=true;button.textContent='Removing…';$('list-result').textContent='';
      try{
        const r=await fetch('/api/admin/registrations/remove',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({classId,registrationId})});
        const data=await r.json().catch(()=>({}));
        if(!r.ok)throw new Error(data.error||'Could not remove this registration.');
        if($('class-select').value===classId)await loadStudents(classId);
        $('list-result').textContent=`${name} removed from ${title}. Their attendee profile and registration history are still saved.`;
      }catch(error){$('list-result').textContent=error.message||'Could not remove this registration.';button.disabled=false;button.textContent=label;}
    });
    $('class-select').addEventListener('change',e=>{$('list-result').textContent='';$('manual-class').value=e.target.value;$('email-class').value=e.target.value;loadStudents(e.target.value)});
    $('student-form').addEventListener('submit',async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(e.target));const r=await fetch('/api/admin/students',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(data)});const d=await r.json();$('student-result').textContent=r.ok?'Student added.':(d.error||'Unable to add student.');if(r.ok){e.target.reset();loadStudents($('class-select').value)}});
    $('email-form').addEventListener('submit',async e=>{e.preventDefault();const r=await fetch('/api/admin/send-email',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({classId:$('email-class').value,templateId:$('email-template').value})});const d=await r.json();$('email-result').textContent=r.ok?`Sent ${d.sentCount||0} emails.`:(d.error||'Unable to send email.')});
    (async()=>{await loadClasses();const r=await fetch('/api/admin/templates');if(r.ok){const d=await r.json();$('email-template').innerHTML='<option value="">Select a template</option>'+(d.templates||[]).map(t=>`<option value="${esc(t.id)}">${esc(t.name)}</option>`).join('')}})();
  </script>
</BaseLayout>
