---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAdminRequest } from '../../lib/server';
if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
---
<BaseLayout title="Attendee Directory | Healing the Heart Admin">
  <section class="admin-shell"><div class="admin-header"><div><p class="eyebrow">People</p><h1>Attendee directory</h1><p>Your ongoing record of everyone who has registered or attended.</p></div><a class="button outline" href="/admin">← Dashboard</a></div><div class="directory-toolbar"><input id="search" placeholder="Search name, email, or phone…" /><span id="count" class="status-pill"></span></div><div id="people" class="people"><div class="admin-empty">Loading…</div></div></section>
  <script is:inline>
    const people=document.querySelector('#people'),search=document.querySelector('#search'),count=document.querySelector('#count');const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let rows=[];
    function render(){const q=search.value.toLowerCase();const filtered=rows.filter(s=>`${s.name} ${s.email} ${s.phone||''}`.toLowerCase().includes(q));count.textContent=`${filtered.length} people`;people.innerHTML=filtered.map(s=>`<details class="person"><summary><span><strong>${esc(s.name)}</strong><small>${esc(s.email)}</small></span><span class="person-meta">${Number(s.registration_count)||0} registration${Number(s.registration_count)==1?'':'s'} · ${s.mass_email_opt_out?'Mass email off':'Mass email on'} <b>›</b></span></summary><form class="person-form" data-id="${esc(s.id)}"><div class="form-grid">${[['name','Name','text'],['email','Email','email'],['phone','Phone','text'],['date_of_birth','Date of birth','text'],['marital_status','Marital status','text'],['church','Church','text'],['sr_pastor','Senior pastor','text'],['how_heard','How they heard','text']].map(([n,l,t])=>`<label>${l}<input name="${n}" type="${t}" value="${esc(s[n])}"></label>`).join('')}</div><label>Address<input name="address" value="${esc(s.address)}"></label><label>Goals / what they hoped to gain<textarea name="goals">${esc(s.goals)}</textarea></label><label>Anything else<textarea name="anything_else">${esc(s.anything_else)}</textarea></label><label class="check"><input type="checkbox" name="mass_email_opt_out" ${s.mass_email_opt_out?'checked':''}> Do not include this person in mass/blast emails</label><button class="button primary" type="submit">Save profile</button><span class="save-result field-note"></span></form></details>`).join('')||'<div class="admin-empty">No matching attendees.</div>';people.querySelectorAll('form').forEach(f=>f.addEventListener('submit',save));}
    async function load(){const r=await fetch('/api/admin/attendees');if(r.status===401){location='/admin-login';return;}const d=await r.json();rows=d.students||[];render();}
    async function save(e){e.preventDefault();const f=e.currentTarget;const data=Object.fromEntries(new FormData(f));data.id=f.dataset.id;data.mass_email_opt_out=f.querySelector('[name="mass_email_opt_out"]').checked?1:0;const r=await fetch('/api/admin/attendees',{method:'PUT',headers:{'content-type':'application/json'},body:JSON.stringify(data)});f.querySelector('.save-result').textContent=r.ok?'Saved.':'Save failed.';if(r.ok)load();}
    search.addEventListener('input',render);load();
  </script>
  <style>.directory-toolbar{display:flex;gap:1rem;align-items:center;margin:1rem 0}.directory-toolbar input{flex:1;padding:.9rem 1rem;border:1px solid rgba(0,0,0,.15);border-radius:12px}.people{display:grid;gap:.7rem}.person{background:#fff;border:1px solid rgba(0,0,0,.1);border-radius:16px;overflow:hidden}.person summary{cursor:pointer;list-style:none;display:flex;justify-content:space-between;gap:1rem;align-items:center;padding:1.1rem 1.2rem}.person summary::-webkit-details-marker{display:none}.person summary span:first-child{display:grid;gap:.25rem}.person summary small{opacity:.65}.person-meta{font-size:.85rem;opacity:.7}.person-meta b{font-size:1.3rem;margin-left:.5rem}.person[open] .person-meta b{display:inline-block;transform:rotate(90deg)}.person-form{padding:1.2rem;border-top:1px solid rgba(0,0,0,.08);background:#faf9f6;display:grid;gap:1rem}.person-form textarea{min-height:90px}.check{display:flex;gap:.6rem;align-items:center}.check input{width:auto}@media(max-width:700px){.directory-toolbar{align-items:stretch;flex-direction:column}.person summary{align-items:flex-start;flex-direction:column}.person-meta{font-size:.78rem}}</style>
</BaseLayout>
