---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAdminRequest } from '../../lib/server';
if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
---
<BaseLayout title="Attendee Directory | Healing the Heart Admin">
  <section class="admin-shell directory-shell">
    <div class="admin-header">
      <div><p class="eyebrow">People</p><h1>Attendee directory</h1><p>Your ongoing rolodex of everyone who has registered or attended.</p></div>
      <a class="button outline" href="/admin">← Dashboard</a>
    </div>
    <div class="directory-toolbar"><div class="search-wrap"><span>⌕</span><input id="search" placeholder="Search name, email, or phone…" /></div><span id="count" class="status-pill"></span></div>
    <div class="directory-help">Click a person to open their profile. You can update their information, control mass-emailing, or merge a duplicate profile when someone returns.</div>
    <div id="people" class="people"><div class="admin-empty">Loading…</div></div>
    <div id="merge-panel" class="merge-panel" hidden></div>
  </section>
  <script is:inline>
    const people=document.querySelector('#people'),search=document.querySelector('#search'),count=document.querySelector('#count'),mergePanel=document.querySelector('#merge-panel');
    const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));let rows=[];
    function render(){const q=search.value.toLowerCase().trim();const filtered=rows.filter(s=>`${s.name} ${s.email} ${s.phone||''}`.toLowerCase().includes(q));count.textContent=`${filtered.length} ${filtered.length===1?'person':'people'}`;
      people.innerHTML=filtered.map(s=>`<details class="person"><summary><span class="avatar">${esc((s.name||'?').trim().charAt(0).toUpperCase())}</span><span class="person-main"><strong>${esc(s.name)}</strong><small>${esc(s.email)}</small></span><span class="person-meta"><b>${Number(s.registration_count)||0}</b> registrations <em class="${s.mass_email_opt_out?'off':''}">${s.mass_email_opt_out?'Mass email off':'Mass email on'}</em><i>›</i></span></summary><form class="person-form" data-id="${esc(s.id)}"><div class="profile-heading"><div><p class="eyebrow">Profile</p><h2>${esc(s.name)}</h2></div><button class="button outline merge-start" type="button" data-id="${esc(s.id)}">Merge duplicate</button></div><div class="form-grid">${[['name','Name','text'],['email','Email','email'],['phone','Phone','text'],['date_of_birth','Date of birth','text'],['marital_status','Marital status','text'],['church','Church','text'],['sr_pastor','Senior pastor','text'],['how_heard','How they heard','text']].map(([n,l,t])=>`<label>${l}<input name="${n}" type="${t}" value="${esc(s[n])}"></label>`).join('')}</div><label>Address<input name="address" value="${esc(s.address)}"></label><label>Goals / what they hoped to gain<textarea name="goals">${esc(s.goals)}</textarea></label><label>Smoking / drinking concerns<textarea name="smoking_drinking">${esc(s.smoking_drinking)}</textarea></label><label>Anything else<textarea name="anything_else">${esc(s.anything_else)}</textarea></label><label class="check"><input type="checkbox" name="mass_email_opt_out" ${s.mass_email_opt_out?'checked':''}> Do not include this person in mass/blast emails</label><div class="profile-footer"><span class="save-result field-note"></span><button class="button primary" type="submit">Save profile</button></div></form></details>`).join('')||'<div class="admin-empty">No matching attendees.</div>';
      people.querySelectorAll('form').forEach(f=>f.addEventListener('submit',save));people.querySelectorAll('.merge-start').forEach(b=>b.addEventListener('click',()=>openMerge(b.dataset.id)));
    }
    async function load(){const r=await fetch('/api/admin/attendees');if(r.status===401){location='/admin-login';return;}const d=await r.json();rows=d.students||[];render();}
    async function save(e){e.preventDefault();const f=e.currentTarget;const data=Object.fromEntries(new FormData(f));data.id=f.dataset.id;data.mass_email_opt_out=f.querySelector('[name="mass_email_opt_out"]').checked?1:0;const r=await fetch('/api/admin/attendees',{method:'PUT',headers:{'content-type':'application/json'},body:JSON.stringify(data)});f.querySelector('.save-result').textContent=r.ok?'Saved.':'Save failed.';if(r.ok)load();}
    function openMerge(id){const target=rows.find(x=>x.id===id);if(!target)return;const options=rows.filter(x=>x.id!==id).slice(0,100);mergePanel.hidden=false;mergePanel.innerHTML=`<div class="merge-card"><div><p class="eyebrow">Merge profiles</p><h2>Is this person a duplicate?</h2><p>Registrations from the duplicate will be moved to the selected profile. If both profiles have the same class, the existing registration is kept.</p></div><label>Duplicate profile<select id="merge-duplicate"><option value="">Choose a person…</option>${options.map(x=>`<option value="${esc(x.id)}">${esc(x.name)} · ${esc(x.email)}</option>`).join('')}</select></label><fieldset><legend>Profile information to keep</legend><label><input type="radio" name="profile-source" value="primary" checked> Keep ${esc(target.name)}'s current profile</label><label><input type="radio" name="profile-source" value="duplicate"> Use the duplicate profile's newer information</label></fieldset><div class="merge-actions"><button id="merge-cancel" class="button outline" type="button">Cancel</button><button id="merge-confirm" class="button primary" type="button">Merge profiles</button></div><p id="merge-result" class="field-note"></p></div>`;document.querySelector('#merge-cancel').onclick=()=>mergePanel.hidden=true;document.querySelector('#merge-confirm').onclick=async()=>{const dup=document.querySelector('#merge-duplicate').value;if(!dup){document.querySelector('#merge-result').textContent='Choose the duplicate profile first.';return;}const useDup=document.querySelector('[name="profile-source"]:checked').value==='duplicate';if(!confirm('Merge these profiles? The duplicate profile will be removed after its registrations are transferred.'))return;const r=await fetch('/api/admin/attendees/merge',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({survivorId:id,duplicateId:dup,useDuplicateProfile:useDup})});const d=await r.json();document.querySelector('#merge-result').textContent=r.ok?'Profiles merged.':(d.error||'Merge failed.');if(r.ok){mergePanel.hidden=true;load();}};}
    search.addEventListener('input',render);load();
  </script>
  <style>
    .directory-shell{max-width:1100px}.directory-toolbar{display:flex;gap:1rem;align-items:center;margin:1.4rem 0 .8rem}.search-wrap{position:relative;flex:1}.search-wrap span{position:absolute;left:1rem;top:50%;transform:translateY(-50%);opacity:.5}.search-wrap input{width:100%;box-sizing:border-box;padding:1rem 1rem 1rem 2.6rem;border:1px solid rgba(0,0,0,.12);border-radius:14px;background:#fff}.directory-help{padding:.85rem 1rem;border-radius:12px;background:#f6f3ed;font-size:.9rem;line-height:1.5;opacity:.85;margin-bottom:1rem}.people{display:grid;gap:.8rem}.person{background:#fff;border:1px solid rgba(0,0,0,.1);border-radius:18px;overflow:hidden;box-shadow:0 3px 16px rgba(0,0,0,.035)}.person summary{cursor:pointer;list-style:none;display:grid;grid-template-columns:auto 1fr auto;gap:.9rem;align-items:center;padding:1rem 1.1rem}.person summary::-webkit-details-marker{display:none}.avatar{width:42px;height:42px;border-radius:50%;display:grid;place-items:center;background:#eee8df;font-weight:700}.person-main{display:grid;gap:.22rem;min-width:0}.person-main strong{font-size:1rem}.person-main small{opacity:.6;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.person-meta{display:flex;align-items:center;gap:.55rem;font-size:.78rem;opacity:.7}.person-meta b{font-size:.9rem;opacity:1}.person-meta em{font-style:normal;padding:.28rem .5rem;border-radius:999px;background:#edf3ed}.person-meta em.off{background:#f3eaea}.person-meta i{font-style:normal;font-size:1.5rem;transition:transform .2s}.person[open] .person-meta i{transform:rotate(90deg)}.person-form{padding:1.3rem;border-top:1px solid rgba(0,0,0,.08);background:#fbfaf7;display:grid;gap:1rem}.profile-heading{display:flex;align-items:center;justify-content:space-between;gap:1rem}.profile-heading h2{margin:.15rem 0}.person-form textarea{min-height:80px}.check{display:flex;gap:.6rem;align-items:center;padding:.75rem .85rem;background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:10px}.check input{width:auto}.profile-footer{display:flex;justify-content:flex-end;align-items:center;gap:1rem}.merge-panel{position:sticky;bottom:1rem;z-index:5;margin-top:1rem}.merge-card{padding:1.3rem;border:1px solid rgba(0,0,0,.12);border-radius:18px;background:#fff;box-shadow:0 12px 35px rgba(0,0,0,.12);display:grid;gap:1rem}.merge-card h2{margin:.15rem 0}.merge-card fieldset{border:0;padding:0;display:grid;gap:.65rem}.merge-card legend{font-weight:700;margin-bottom:.4rem}.merge-actions{display:flex;justify-content:flex-end;gap:.7rem}@media(max-width:700px){.directory-toolbar{flex-direction:column;align-items:stretch}.person summary{grid-template-columns:auto 1fr auto}.person-meta{grid-column:2/-1}.profile-heading{align-items:flex-start;flex-direction:column}.profile-footer{flex-direction:column-reverse;align-items:stretch}.merge-actions{flex-direction:column-reverse}}
  </style>
</BaseLayout>
