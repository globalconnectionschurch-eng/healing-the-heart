---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAdminRequest } from '../../lib/server';
if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
---
<BaseLayout title="Attendee Directory | Healing the Heart Admin">
  <section class="admin-shell directory-shell">
    <header class="directory-header">
      <div><p class="eyebrow">People</p><h1>Attendee directory</h1><p class="lede">One clear profile for every person who has registered or attended Healing the Heart.</p></div>
      <a class="button outline" href="/admin">← Dashboard</a>
    </header>
    <section class="directory-toolbar" aria-label="Directory tools">
      <div class="search-wrap"><span aria-hidden="true">⌕</span><input id="search" placeholder="Search name, email, or phone" autocomplete="off" /></div>
      <div class="directory-stats"><span id="count" class="stat"><b>0</b> people</span><span id="opt-in-count" class="stat muted">0 available for mass email</span></div>
    </section>
    <div id="people" class="people"><div class="admin-empty">Loading…</div></div>
  </section>

  <div id="merge-panel" class="merge-overlay" hidden aria-hidden="true">
    <div class="merge-backdrop"></div>
    <section class="merge-dialog" role="dialog" aria-modal="true" aria-labelledby="merge-title">
      <button id="merge-close" class="merge-close" type="button" aria-label="Close">×</button>
      <p class="eyebrow">Merge profiles</p><h2 id="merge-title">Combine duplicate attendee records</h2>
      <p class="merge-description">Choose the duplicate profile. Its registrations will be moved to the person you are keeping, and the duplicate record will then be removed.</p>
      <label class="field-label">Duplicate profile<select id="merge-duplicate"><option value="">Choose a person…</option></select></label>
      <fieldset><legend>Profile information to keep</legend>
        <label class="radio-row"><input type="radio" name="profile-source" value="primary" checked><span><strong>Keep the selected person's information</strong><small>Use the current profile as the source.</small></span></label>
        <label class="radio-row"><input type="radio" name="profile-source" value="duplicate"><span><strong>Use the duplicate person's information</strong><small>Useful when the returning attendee has newer contact details.</small></span></label>
      </fieldset>
      <div class="merge-actions"><button id="merge-cancel" class="button outline" type="button">Cancel</button><button id="merge-confirm" class="button primary" type="button">Merge profiles</button></div>
      <p id="merge-result" class="field-note"></p>
    </section>
  </div>

  <script is:inline>
    const people=document.querySelector('#people'),search=document.querySelector('#search'),count=document.querySelector('#count'),optInCount=document.querySelector('#opt-in-count'),mergePanel=document.querySelector('#merge-panel');
    const mergeDuplicate=document.querySelector('#merge-duplicate'),mergeResult=document.querySelector('#merge-result');
    const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    let rows=[],mergeTarget=null;
    function render(){
      const q=search.value.toLowerCase().trim(),filtered=rows.filter(s=>`${s.name} ${s.email} ${s.phone||''}`.toLowerCase().includes(q));
      count.innerHTML=`<b>${filtered.length}</b> ${filtered.length===1?'person':'people'}`;optInCount.textContent=`${rows.filter(s=>!s.mass_email_opt_out).length} available for mass email`;
      people.innerHTML=filtered.map(s=>`<details class="person"><summary><span class="avatar">${esc((s.name||'?').trim().charAt(0).toUpperCase())}</span><span class="person-main"><strong>${esc(s.name||'Unnamed')}</strong><small>${esc(s.email||'No email on file')}</small></span><span class="person-count"><b>${Number(s.registration_count)||0}</b><small>${Number(s.registration_count)===1?'registration':'registrations'}</small></span><span class="person-status ${s.mass_email_opt_out?'off':''}">${s.mass_email_opt_out?'Mass email off':'Mass email on'}</span><span class="chevron" aria-hidden="true">›</span></summary>
      <form class="person-form" data-id="${esc(s.id)}"><div class="profile-top"><div><p class="eyebrow">Person profile</p><h2>${esc(s.name||'Unnamed')}</h2><p class="profile-subline">${Number(s.registration_count)||0} ${Number(s.registration_count)===1?'registration':'registrations'}${s.last_registration_date?` · Last registered ${esc(s.last_registration_date)}`:''}</p></div><button class="button outline merge-start" type="button" data-id="${esc(s.id)}">Merge duplicate</button></div>
      <section class="profile-section"><div class="section-heading"><span>01</span><div><strong>Contact information</strong><small>How to reach this person</small></div></div><div class="field-grid four">${[['name','Name','text'],['email','Email','email'],['phone','Phone','text'],['date_of_birth','Date of birth','text']].map(([n,l,t])=>`<label class="field-label">${l}<input name="${n}" type="${t}" value="${esc(s[n])}"></label>`).join('')}</div><label class="field-label">Address<input name="address" value="${esc(s.address)}"></label></section>
      <section class="profile-section"><div class="section-heading"><span>02</span><div><strong>Background</strong><small>Personal and church information</small></div></div><div class="field-grid four">${[['marital_status','Marital status','text'],['church','Church','text'],['sr_pastor','Senior pastor','text'],['how_heard','How they heard','text']].map(([n,l,t])=>`<label class="field-label">${l}<input name="${n}" type="${t}" value="${esc(s[n])}"></label>`).join('')}</div></section>
      <section class="profile-section"><div class="section-heading"><span>03</span><div><strong>Healing journey</strong><small>Information they shared during registration</small></div></div><div class="field-grid three"><label class="field-label">Goals / what they hoped to gain<textarea name="goals">${esc(s.goals)}</textarea></label><label class="field-label">Smoking / drinking concerns<textarea name="smoking_drinking">${esc(s.smoking_drinking)}</textarea></label><label class="field-label">Anything else they shared<textarea name="anything_else">${esc(s.anything_else)}</textarea></label></div></section>
      <section class="preference-row"><label class="check"><input type="checkbox" name="mass_email_opt_out" ${s.mass_email_opt_out?'checked':''}><span><strong>Do not include in mass/blast emails</strong><small>Direct class and registration emails can still be sent.</small></span></label></section><footer class="profile-footer"><span class="save-result field-note"></span><button class="button primary" type="submit">Save profile</button></footer></form></details>`).join('')||'<div class="admin-empty">No matching attendees.</div>';
      people.querySelectorAll('form').forEach(f=>f.addEventListener('submit',save));people.querySelectorAll('.merge-start').forEach(b=>b.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();openMerge(b.dataset.id);}));
    }
    async function load(){const r=await fetch('/api/admin/attendees');if(r.status===401){location='/admin-login';return;}const d=await r.json();rows=d.students||[];render();}
    async function save(e){e.preventDefault();const f=e.currentTarget,result=f.querySelector('.save-result');result.textContent='Saving…';const data=Object.fromEntries(new FormData(f));data.id=f.dataset.id;data.mass_email_opt_out=f.querySelector('[name="mass_email_opt_out"]').checked?1:0;const r=await fetch('/api/admin/attendees',{method:'PUT',headers:{'content-type':'application/json'},body:JSON.stringify(data)});result.textContent=r.ok?'Saved.':'Save failed.';if(r.ok)load();}
    function openMerge(id){mergeTarget=rows.find(x=>x.id===id);if(!mergeTarget)return;mergeDuplicate.innerHTML='<option value="">Choose a person…</option>'+rows.filter(x=>x.id!==id).map(x=>`<option value="${esc(x.id)}">${esc(x.name||'Unnamed')} · ${esc(x.email||'No email')}</option>`).join('');mergeResult.textContent='';mergePanel.hidden=false;mergePanel.setAttribute('aria-hidden','false');document.body.classList.add('modal-open');setTimeout(()=>mergeDuplicate.focus(),0);}
    function closeMerge(){mergePanel.hidden=true;mergePanel.setAttribute('aria-hidden','true');document.body.classList.remove('modal-open');mergeTarget=null;}
    document.querySelector('#merge-close').onclick=closeMerge;document.querySelector('#merge-cancel').onclick=closeMerge;document.querySelector('.merge-backdrop').onclick=closeMerge;
    document.querySelector('#merge-confirm').onclick=async()=>{const dup=mergeDuplicate.value;if(!dup){mergeResult.textContent='Choose the duplicate profile first.';return;}const useDup=document.querySelector('[name="profile-source"]:checked').value==='duplicate';if(!confirm('Merge these profiles? The duplicate profile will be removed after its registrations are transferred.'))return;mergeResult.textContent='Merging…';const r=await fetch('/api/admin/attendees/merge',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({survivorId:mergeTarget.id,duplicateId:dup,useDuplicateProfile:useDup})});const d=await r.json();mergeResult.textContent=r.ok?'Profiles merged.':(d.error||'Merge failed.');if(r.ok){closeMerge();load();}};
    document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!mergePanel.hidden)closeMerge();});search.addEventListener('input',render);load();
  </script>
  <style>
    :global(body.modal-open){overflow:hidden}.directory-shell{max-width:1180px;padding-bottom:5rem}.directory-header{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;margin-bottom:1.5rem}.directory-header h1{margin:.15rem 0 .45rem;letter-spacing:-.03em}.lede{margin:0;max-width:680px;line-height:1.6;opacity:.64}
    .directory-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:center;padding:1rem;background:#f7f5f1;border:1px solid rgba(0,0,0,.08);border-radius:16px;margin-bottom:1rem}.search-wrap{position:relative}.search-wrap span{position:absolute;left:1rem;top:50%;transform:translateY(-50%);font-size:1.15rem;opacity:.4}.search-wrap input{width:100%;box-sizing:border-box;padding:.82rem 1rem .82rem 2.55rem;border:1px solid rgba(0,0,0,.12);border-radius:10px;background:#fff;font:inherit;outline:none}.search-wrap input:focus{border-color:rgba(0,0,0,.3);box-shadow:0 0 0 3px rgba(0,0,0,.04)}.directory-stats{display:flex;gap:.55rem;align-items:center;justify-content:flex-end}.stat{padding:.55rem .75rem;border:1px solid rgba(0,0,0,.08);border-radius:9px;background:#fff;font-size:.78rem;white-space:nowrap}.stat b{font-size:.9rem}.stat.muted{opacity:.65}
    .people{display:grid;gap:.6rem}.person{border:1px solid rgba(0,0,0,.1);border-radius:14px;background:#fff;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.025)}.person[open]{border-color:rgba(0,0,0,.18);box-shadow:0 8px 26px rgba(0,0,0,.06)}.person summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:44px minmax(0,1fr) 110px 120px 24px;gap:1rem;align-items:center;padding:.8rem 1rem}.person summary::-webkit-details-marker{display:none}.avatar{width:44px;height:44px;display:grid;place-items:center;border-radius:10px;background:#eee9e0;font-weight:700}.person-main{min-width:0;display:grid;gap:.2rem}.person-main strong{font-size:.95rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.person-main small{font-size:.78rem;opacity:.56;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.person-count{display:grid;gap:.1rem;text-align:right;border-left:1px solid rgba(0,0,0,.07);padding-left:1rem}.person-count b{font-size:.9rem}.person-count small{font-size:.7rem;opacity:.55}.person-status{font-size:.7rem;text-align:center;padding:.35rem .45rem;border-radius:999px;background:#edf3ed;white-space:nowrap}.person-status.off{background:#f3eaea}.chevron{font-size:1.45rem;line-height:1;opacity:.35;text-align:center;transition:transform .18s}.person[open] .chevron{transform:rotate(90deg)}
    .person-form{border-top:1px solid rgba(0,0,0,.08);background:#faf9f6;padding:1.5rem;display:grid;gap:1.5rem}.profile-top{display:flex;justify-content:space-between;align-items:flex-start;gap:1rem}.profile-top h2{margin:.1rem 0 .15rem;letter-spacing:-.02em}.profile-subline{margin:0;font-size:.78rem;opacity:.55}.profile-section{display:grid;gap:1rem;padding-top:.15rem}.section-heading{display:flex;gap:.8rem;align-items:center;border-bottom:1px solid rgba(0,0,0,.08);padding-bottom:.75rem}.section-heading>span{font-size:.7rem;font-weight:700;letter-spacing:.08em;opacity:.4}.section-heading div{display:grid;gap:.12rem}.section-heading strong{font-size:.86rem}.section-heading small{font-size:.72rem;opacity:.5}.field-grid{display:grid;gap:1rem}.field-grid.four{grid-template-columns:repeat(4,minmax(0,1fr))}.field-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.field-label{display:grid;gap:.4rem;font-size:.7rem;font-weight:700;letter-spacing:.01em;color:rgba(0,0,0,.62)}.field-label input,.field-label textarea,.field-label select{width:100%;box-sizing:border-box;border:1px solid rgba(0,0,0,.12);border-radius:9px;background:#fff;padding:.7rem .75rem;font:inherit;font-size:.84rem;font-weight:400;color:#222;outline:none}.field-label input:focus,.field-label textarea:focus,.field-label select:focus{border-color:rgba(0,0,0,.3);box-shadow:0 0 0 3px rgba(0,0,0,.035)}.field-label textarea{min-height:100px;resize:vertical;line-height:1.5}
    .preference-row{border:1px solid rgba(0,0,0,.08);background:#fff;border-radius:10px;padding:.9rem}.check{display:flex;gap:.7rem;align-items:flex-start}.check>input{width:auto;margin-top:.2rem}.check span{display:grid;gap:.2rem}.check strong{font-size:.78rem}.check small{font-size:.7rem;opacity:.55;line-height:1.4}.profile-footer{display:flex;justify-content:flex-end;align-items:center;gap:1rem;padding-top:.1rem}.field-note{font-size:.75rem;opacity:.6}
    .merge-overlay[hidden]{display:none}.merge-overlay{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:1.25rem}.merge-backdrop{position:absolute;inset:0;background:rgba(20,18,15,.5);backdrop-filter:blur(3px)}.merge-dialog{position:relative;z-index:1;width:min(620px,100%);max-height:calc(100vh - 2.5rem);overflow:auto;box-sizing:border-box;background:#fff;border-radius:18px;padding:1.7rem;box-shadow:0 24px 70px rgba(0,0,0,.24);display:grid;gap:1rem}.merge-dialog h2{margin:.05rem 0 .1rem;letter-spacing:-.025em}.merge-description{margin:0;line-height:1.55;font-size:.84rem;opacity:.65}.merge-close{position:absolute;right:1rem;top:.85rem;border:0;background:transparent;font-size:1.7rem;line-height:1;opacity:.45;cursor:pointer}.merge-dialog fieldset{border:0;margin:0;padding:1rem 0 0;border-top:1px solid rgba(0,0,0,.08);display:grid;gap:.65rem}.merge-dialog legend{font-size:.75rem;font-weight:700;margin-bottom:.25rem}.radio-row{display:flex;gap:.65rem;align-items:flex-start;padding:.75rem;border:1px solid rgba(0,0,0,.08);border-radius:10px;cursor:pointer}.radio-row>input{margin-top:.2rem}.radio-row span{display:grid;gap:.15rem}.radio-row strong{font-size:.78rem}.radio-row small{font-size:.7rem;opacity:.55;line-height:1.4}.merge-actions{display:flex;justify-content:flex-end;gap:.65rem;padding-top:.3rem}
    @media(max-width:900px){.person summary{grid-template-columns:44px minmax(0,1fr) 90px 24px}.person-status{grid-column:3}.person-count{grid-column:3;grid-row:1;text-align:left;border-left:0;padding-left:0}.field-grid.four{grid-template-columns:repeat(2,minmax(0,1fr))}.field-grid.three{grid-template-columns:1fr}.directory-toolbar{grid-template-columns:1fr}.directory-stats{justify-content:flex-start}}
    @media(max-width:640px){.directory-header{align-items:flex-start;flex-direction:column}.directory-header .button{width:100%;text-align:center}.person summary{grid-template-columns:38px minmax(0,1fr) 22px;padding:.75rem;gap:.7rem}.avatar{width:38px;height:38px}.person-count,.person-status{display:none}.chevron{grid-column:3}.person-form{padding:1rem;gap:1.2rem}.profile-top{flex-direction:column}.profile-top .button{width:100%;text-align:center}.field-grid.four{grid-template-columns:1fr}.profile-footer{flex-direction:column-reverse;align-items:stretch}.profile-footer .button{width:100%}.merge-dialog{padding:1.35rem;border-radius:15px}.merge-actions{flex-direction:column-reverse}.merge-actions .button{width:100%;text-align:center}}
  </style>
</BaseLayout>
