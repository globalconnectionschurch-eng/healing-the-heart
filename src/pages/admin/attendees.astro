---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAdminRequest } from '../../lib/server';
if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
---
<BaseLayout title="Attendee Directory | Healing the Heart Admin">
  <main class="directory">
    <header class="directory-head">
      <div><span class="kicker">People</span><h1>Attendee directory</h1><p>One private record for every person who has registered with Healing the Heart.</p></div>
      <a class="button outline" href="/admin">← Dashboard</a>
    </header>

    <section class="directory-bar">
      <label class="search"><span>⌕</span><input id="search" placeholder="Search people…" autocomplete="off" /></label>
      <div class="stats"><div><strong id="count-number">0</strong><span>People</span></div><div><strong id="opt-number">0</strong><span>Email eligible</span></div></div>
    </section>

    <div id="people" class="people"><div class="loading">Loading attendee directory…</div></div>
  </main>

  <div id="edit-panel" class="overlay" hidden aria-hidden="true">
    <div class="backdrop edit-backdrop"></div>
    <aside class="drawer" role="dialog" aria-modal="true" aria-labelledby="edit-title">
      <header class="drawer-head"><div><span class="kicker">Edit attendee</span><h2 id="edit-title">Person details</h2><p>Update this person's record.</p></div><button id="edit-close" class="icon-button" type="button" aria-label="Close">×</button></header>
      <form id="edit-form" class="drawer-form"><input type="hidden" name="id" />
        <section class="drawer-section"><div class="drawer-title"><b>01</b><div><strong>Contact</strong><span>How to reach this person</span></div></div><div class="form-grid"><label>Full name<input name="name" required></label><label>Email address<input name="email" type="email" required></label><label>Phone<input name="phone"></label><label>Date of birth<input name="date_of_birth"></label></div><label>Address<input name="address"></label></section>
        <section class="drawer-section"><div class="drawer-title"><b>02</b><div><strong>Background</strong><span>Personal and church information</span></div></div><div class="form-grid"><label>Marital status<input name="marital_status"></label><label>Church<input name="church"></label><label>Senior pastor<input name="sr_pastor"></label><label>How they heard<input name="how_heard"></label></div></section>
        <section class="drawer-section"><div class="drawer-title"><b>03</b><div><strong>Healing journey</strong><span>Information shared during registration</span></div></div><label>Goals / what they hoped to gain<textarea name="goals"></textarea></label><label>Smoking / drinking concerns<textarea name="smoking_drinking"></textarea></label><label>Anything else they shared<textarea name="anything_else"></textarea></label></section>
        <section class="email-setting"><label class="toggle-row"><input type="checkbox" name="mass_email_opt_out"><span class="toggle-ui"></span><span><strong>Exclude from mass emails</strong><small>This person will not receive blast emails. Direct class emails are unaffected.</small></span></label></section>
        <footer class="drawer-footer"><span id="save-result"></span><button class="button outline" id="edit-cancel" type="button">Cancel</button><button class="button primary" type="submit">Save changes</button></footer>
      </form>
    </aside>
  </div>

  <div id="merge-panel" class="overlay merge-overlay" hidden aria-hidden="true">
    <div class="backdrop merge-backdrop"></div>
    <section class="merge-dialog" role="dialog" aria-modal="true" aria-labelledby="merge-title"><button id="merge-close" class="icon-button merge-close" type="button" aria-label="Close">×</button><div class="merge-icon">⇄</div><span class="kicker">Merge profiles</span><h2 id="merge-title">Combine duplicate records</h2><p>Move registrations from a duplicate record into this person and remove the duplicate profile.</p><label class="select-label">Duplicate profile<select id="merge-duplicate"><option value="">Choose a person…</option></select></label><fieldset><legend>Profile information to keep</legend><label class="choice"><input type="radio" name="profile-source" value="primary" checked><span><strong>Keep this person's information</strong><small>Use the profile you opened as the source.</small></span></label><label class="choice"><input type="radio" name="profile-source" value="duplicate"><span><strong>Use the duplicate's information</strong><small>Use the duplicate when it contains newer details.</small></span></label></fieldset><div class="merge-actions"><button id="merge-cancel" class="button outline" type="button">Cancel</button><button id="merge-confirm" class="button primary" type="button">Merge profiles</button></div><div id="merge-result"></div></section>
  </div>

  <script is:inline>
    const people=document.querySelector('#people'),search=document.querySelector('#search'),countNumber=document.querySelector('#count-number'),optNumber=document.querySelector('#opt-number');
    const editPanel=document.querySelector('#edit-panel'),editForm=document.querySelector('#edit-form'),saveResult=document.querySelector('#save-result');
    const mergePanel=document.querySelector('#merge-panel'),mergeDuplicate=document.querySelector('#merge-duplicate'),mergeResult=document.querySelector('#merge-result');
    const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const display=v=>v?esc(v):'<span class="empty">Not provided</span>';
    const initials=name=>{const p=String(name||'?').trim().split(/\s+/);return esc(((p[0]?.[0]||'')+(p.length>1?p[p.length-1][0]:'')).toUpperCase())};
    const dataRow=(label,value)=>`<div class="data-row"><span>${label}</span><strong>${display(value)}</strong></div>`;
    const story=(label,value)=>`<div class="story"><span>${label}</span><p>${display(value)}</p></div>`;
    let rows=[],mergeTarget=null;

    function render(){
      const q=search.value.toLowerCase().trim(),filtered=rows.filter(s=>`${s.name||''} ${s.email||''} ${s.phone||''}`.toLowerCase().includes(q));
      countNumber.textContent=filtered.length; optNumber.textContent=rows.filter(s=>!s.mass_email_opt_out).length;
      people.innerHTML=filtered.map(s=>`<article class="person-card" data-id="${esc(s.id)}">
        <button class="person-summary" type="button" aria-expanded="false">
          <span class="avatar">${initials(s.name)}</span><span class="person-name"><strong>${esc(s.name||'Unnamed')}</strong><small>${esc(s.email||'No email on file')}</small></span><span class="registrations"><b>${Number(s.registration_count)||0}</b><small>${Number(s.registration_count)===1?'registration':'registrations'}</small></span><span class="email-status ${s.mass_email_opt_out?'off':''}"><i></i>${s.mass_email_opt_out?'Email off':'Email on'}</span><span class="arrow">⌄</span>
        </button>
        <div class="person-detail" hidden>
          <div class="profile-top"><div class="identity"><span class="large-avatar">${initials(s.name)}</span><div><span class="kicker">Attendee profile</span><h2>${esc(s.name||'Unnamed')}</h2><p>${Number(s.registration_count)||0} ${Number(s.registration_count)===1?'registration':'registrations'}${s.last_registration_date?` <em>•</em> Last registered ${esc(s.last_registration_date)}`:''}</p></div></div><div class="profile-actions"><button class="button soft edit-start" type="button">Edit profile</button><button class="button soft merge-start" type="button" data-id="${esc(s.id)}">Merge duplicate</button></div></div>
          <div class="profile-layout">
            <section class="profile-section contact-section"><header><span class="section-index">01</span><div><h3>Contact</h3><p>Current contact information</p></div></header><div class="data-list">${dataRow('Full name',s.name)}${dataRow('Email address',s.email)}${dataRow('Phone',s.phone)}${dataRow('Date of birth',s.date_of_birth)}${dataRow('Address',s.address)}</div></section>
            <section class="profile-section background-section"><header><span class="section-index">02</span><div><h3>Background</h3><p>Personal and church information</p></div></header><div class="data-list">${dataRow('Marital status',s.marital_status)}${dataRow('Church',s.church)}${dataRow('Senior pastor',s.sr_pastor)}${dataRow('How they heard',s.how_heard)}</div></section>
            <section class="profile-section journey-section"><header><span class="section-index">03</span><div><h3>Healing journey</h3><p>Information shared during registration</p></div></header><div class="story-list">${story('Goals / what they hoped to gain',s.goals)}${story('Smoking / drinking concerns',s.smoking_drinking)}${story('Anything else they shared',s.anything_else)}</div></section>
            <section class="preference"><div class="preference-main"><span class="preference-icon">✉</span><div><strong>Mass email preference</strong><p>${s.mass_email_opt_out?'This person is excluded from mass/blast emails.':'This person can receive mass/blast emails.'}</p></div></div><span class="preference-pill ${s.mass_email_opt_out?'off':''}">${s.mass_email_opt_out?'Excluded':'Included'}</span></section>
          </div>
        </div>
      </article>`).join('')||'<div class="empty-state"><strong>No attendees found</strong><span>Try a different name, email, or phone number.</span></div>';
      people.querySelectorAll('.person-summary').forEach(btn=>btn.addEventListener('click',()=>{const card=btn.closest('.person-card'),detail=card.querySelector('.person-detail'),open=!card.classList.contains('open');document.querySelectorAll('.person-card.open').forEach(x=>{x.classList.remove('open');x.querySelector('.person-detail').hidden=true;x.querySelector('.person-summary').setAttribute('aria-expanded','false')});if(open){card.classList.add('open');detail.hidden=false;btn.setAttribute('aria-expanded','true')}}));
      people.querySelectorAll('.edit-start').forEach(b=>b.addEventListener('click',()=>openEdit(b.closest('.person-card').dataset.id)));
      people.querySelectorAll('.merge-start').forEach(b=>b.addEventListener('click',e=>{e.stopPropagation();openMerge(b.dataset.id)}));
    }
    async function load(){const r=await fetch('/api/admin/attendees');if(r.status===401){location='/admin-login';return}const d=await r.json();rows=d.students||[];render()}
    function openEdit(id){const s=rows.find(x=>x.id===id);if(!s)return;editForm.reset();editForm.dataset.id=s.id;for(const n of ['name','email','phone','date_of_birth','address','marital_status','church','sr_pastor','how_heard','goals','smoking_drinking','anything_else'])editForm.elements[n].value=s[n]||'';editForm.elements.mass_email_opt_out.checked=!!s.mass_email_opt_out;document.querySelector('#edit-title').textContent=s.name||'Person details';saveResult.textContent='';editPanel.hidden=false;editPanel.setAttribute('aria-hidden','false');document.body.classList.add('modal-open');setTimeout(()=>editForm.elements.name.focus(),40)}
    function closeEdit(){editPanel.hidden=true;editPanel.setAttribute('aria-hidden','true');document.body.classList.remove('modal-open')}
    async function save(e){e.preventDefault();saveResult.textContent='Saving…';const data=Object.fromEntries(new FormData(editForm));data.id=editForm.dataset.id;data.mass_email_opt_out=editForm.elements.mass_email_opt_out.checked?1:0;const r=await fetch('/api/admin/attendees',{method:'PUT',headers:{'content-type':'application/json'},body:JSON.stringify(data)});if(r.ok){closeEdit();await load()}else saveResult.textContent='Unable to save changes.'}
    function openMerge(id){mergeTarget=rows.find(x=>x.id===id);if(!mergeTarget)return;mergeDuplicate.innerHTML='<option value="">Choose a person…</option>'+rows.filter(x=>x.id!==id).map(x=>`<option value="${esc(x.id)}">${esc(x.name||'Unnamed')} · ${esc(x.email||'No email')}</option>`).join('');mergeResult.textContent='';mergePanel.hidden=false;mergePanel.setAttribute('aria-hidden','false');document.body.classList.add('modal-open')}
    function closeMerge(){mergePanel.hidden=true;mergePanel.setAttribute('aria-hidden','true');document.body.classList.remove('modal-open');mergeTarget=null}
    async function doMerge(){const dup=mergeDuplicate.value;if(!dup){mergeResult.textContent='Choose the duplicate profile first.';return}if(!confirm('Merge these profiles? The duplicate profile will be removed after its registrations are transferred.'))return;mergeResult.textContent='Merging…';const r=await fetch('/api/admin/attendees/merge',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({survivorId:mergeTarget.id,duplicateId:dup,useDuplicateProfile:document.querySelector('[name="profile-source"]:checked').value==='duplicate'})});const d=await r.json();if(r.ok){closeMerge();load()}else mergeResult.textContent=d.error||'Merge failed.'}
    document.querySelector('#edit-close').onclick=closeEdit;document.querySelector('#edit-cancel').onclick=closeEdit;document.querySelector('.edit-backdrop').onclick=closeEdit;document.querySelector('#merge-close').onclick=closeMerge;document.querySelector('#merge-cancel').onclick=closeMerge;document.querySelector('.merge-backdrop').onclick=closeMerge;document.querySelector('#merge-confirm').onclick=doMerge;editForm.addEventListener('submit',save);search.addEventListener('input',render);document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(!editPanel.hidden)closeEdit();if(!mergePanel.hidden)closeMerge()}});load();
  </script>

  <style>
    :global(body.modal-open){overflow:hidden}
    .directory{max-width:1240px;margin:0 auto;padding:4.5rem 2rem 7rem;color:#202522}.directory-head{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;margin-bottom:2.5rem}.directory-head h1{font-size:clamp(2.2rem,4vw,3.35rem);letter-spacing:-.045em;margin:.35rem 0 .5rem}.directory-head p{margin:0;max-width:680px;color:#737a75;line-height:1.65}.kicker{display:block;font-size:.64rem;text-transform:uppercase;letter-spacing:.14em;font-weight:800;color:#818781}.directory-bar{display:flex;gap:1rem;align-items:center;margin-bottom:1.25rem}.search{position:relative;flex:1}.search span{position:absolute;left:1.05rem;top:50%;transform:translateY(-50%);font-size:1.25rem;color:#9aa09b}.search input{width:100%;height:58px;box-sizing:border-box;border:1px solid #dedfdb;border-radius:16px;padding:0 1rem 0 2.8rem;background:#fff;font:inherit;font-size:.9rem;outline:0;box-shadow:0 5px 20px rgba(20,25,22,.035);transition:.2s}.search input:focus{border-color:#aeb4ae;box-shadow:0 0 0 4px rgba(40,48,43,.05)}.stats{display:flex;gap:.7rem}.stats div{height:58px;min-width:125px;box-sizing:border-box;padding:0 .95rem;border:1px solid #dedfdb;border-radius:16px;background:#fff;display:flex;align-items:center;gap:.45rem}.stats strong{font-size:1.1rem}.stats span{font-size:.68rem;color:#858b86}
    .people{display:grid;gap:.8rem}.person-card{background:#fff;border:1px solid #dddeda;border-radius:20px;overflow:hidden;box-shadow:0 3px 18px rgba(20,25,22,.025);transition:.25s}.person-card.open{border-color:#cfd2cd;box-shadow:0 18px 50px rgba(20,25,22,.09)}.person-summary{width:100%;border:0;background:#fff;display:grid;grid-template-columns:50px minmax(0,1fr) 115px 110px 24px;gap:1.1rem;align-items:center;padding:1.05rem 1.25rem;text-align:left;color:inherit;font:inherit;cursor:pointer}.person-summary:hover{background:#fdfdfb}.avatar,.large-avatar{display:grid;place-items:center;background:#eeece7;color:#454b47;font-weight:800}.avatar{width:50px;height:50px;border-radius:15px;font-size:.82rem}.person-name{min-width:0;display:grid;gap:.25rem}.person-name strong{font-size:.94rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.person-name small{font-size:.74rem;color:#858b86;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.registrations{border-left:1px solid #e5e6e2;padding-left:1rem;display:grid;gap:.08rem}.registrations b{font-size:.88rem}.registrations small{font-size:.65rem;color:#8b918c}.email-status{justify-content:center;display:flex;align-items:center;gap:.4rem;border-radius:999px;background:#edf4ee;color:#4d6752;padding:.45rem .5rem;font-size:.64rem;font-weight:700}.email-status.off{background:#f5eded;color:#795656}.email-status i{width:6px;height:6px;border-radius:50%;background:currentColor}.arrow{color:#969b96;font-size:1.1rem;text-align:center;transition:.2s}.person-card.open .arrow{transform:rotate(180deg)}
    .person-detail{border-top:1px solid #e2e3df;background:#f5f5f2;padding:1.5rem}.profile-top{display:flex;justify-content:space-between;align-items:center;gap:2rem;padding:.1rem .15rem 1.5rem}.identity{display:flex;align-items:center;gap:1rem}.large-avatar{width:62px;height:62px;border-radius:18px;font-size:.95rem}.identity h2{margin:.2rem 0 .25rem;font-size:1.4rem;letter-spacing:-.035em}.identity p{margin:0;color:#858b86;font-size:.7rem}.identity em{font-style:normal;padding:0 .25rem;color:#b0b4b0}.profile-actions{display:flex;gap:.55rem}.button.soft{background:#fff;border:1px solid #d8dad6;color:#303632}.button.soft:hover{background:#f0f0ec}
    .profile-layout{display:grid;grid-template-columns:1fr 1fr;gap:1rem}.profile-section{background:#fff;border:1px solid #e0e1dd;border-radius:17px;padding:1.25rem 1.3rem}.profile-section header{display:flex;align-items:center;gap:.8rem;margin-bottom:1.2rem}.section-index{font-size:.62rem;font-weight:900;letter-spacing:.1em;color:#9a9f9a}.profile-section h3{margin:0 0 .18rem;font-size:.86rem}.profile-section header p{margin:0;color:#929791;font-size:.67rem}.data-list{border-top:1px solid #e9eae7}.data-row{display:grid;grid-template-columns:145px minmax(0,1fr);gap:1rem;padding:.78rem 0;border-bottom:1px solid #e9eae7;align-items:baseline}.data-row:last-child{border-bottom:0}.data-row span,.story>span{font-size:.61rem;text-transform:uppercase;letter-spacing:.065em;font-weight:800;color:#929791}.data-row strong{font-size:.79rem;line-height:1.5;font-weight:600;color:#303632;overflow-wrap:anywhere}.empty{font-size:.75rem!important;font-weight:500!important;color:#b0b4b0!important;font-style:italic}.journey-section{grid-column:1/-1}.story-list{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid #e9eae7}.story{padding:1rem 1rem 0 0}.story+.story{border-left:1px solid #e9eae7;padding-left:1rem}.story p{margin:.45rem 0 0;font-size:.79rem;line-height:1.7;color:#3d433f;white-space:pre-wrap}.preference{grid-column:1/-1;background:#fff;border:1px solid #e0e1dd;border-radius:17px;padding:1rem 1.2rem;display:flex;align-items:center;justify-content:space-between;gap:1rem}.preference-main{display:flex;align-items:center;gap:.8rem}.preference-icon{width:38px;height:38px;border-radius:12px;background:#f0efeb;display:grid;place-items:center;font-size:.78rem}.preference strong{display:block;font-size:.77rem}.preference p{margin:.18rem 0 0;font-size:.66rem;color:#8b918c}.preference-pill{font-size:.62rem;font-weight:800;border-radius:999px;padding:.42rem .65rem;background:#edf4ee;color:#4d6752}.preference-pill.off{background:#f5eded;color:#795656}
    .loading,.empty-state{text-align:center;padding:5rem 1rem;color:#8b918c}.empty-state{display:grid;gap:.3rem}.empty-state strong{color:#303632}
    .overlay{position:fixed;inset:0;z-index:3000}.overlay[hidden]{display:none}.backdrop{position:absolute;inset:0;background:rgba(20,24,22,.47);backdrop-filter:blur(6px)}.drawer{position:absolute;right:0;top:0;height:100%;width:min(720px,100%);background:#f5f5f2;box-shadow:-22px 0 65px rgba(0,0,0,.18);display:flex;flex-direction:column}.drawer-head{background:#fff;border-bottom:1px solid #e0e1dd;padding:1.7rem 1.8rem 1.35rem;display:flex;justify-content:space-between;gap:1rem}.drawer-head h2{margin:.25rem 0 .2rem;font-size:1.4rem;letter-spacing:-.03em}.drawer-head p{margin:0;color:#8b918c;font-size:.7rem}.icon-button{width:40px;height:40px;border:1px solid #dfe0dc;border-radius:12px;background:#fff;color:#777d78;font-size:1.4rem;cursor:pointer}.drawer-form{overflow:auto;padding:1.25rem 1.5rem 1.5rem;display:grid;gap:1rem}.drawer-section,.email-setting{background:#fff;border:1px solid #dfe0dc;border-radius:17px;padding:1.2rem}.drawer-title{display:flex;gap:.8rem;align-items:center;border-bottom:1px solid #e7e8e5;padding-bottom:.9rem;margin-bottom:1rem}.drawer-title>b{font-size:.61rem;letter-spacing:.1em;color:#9ca19c}.drawer-title div{display:grid;gap:.16rem}.drawer-title strong{font-size:.8rem}.drawer-title span{font-size:.65rem;color:#929791}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:.85rem}.drawer-section label{display:grid;gap:.4rem;font-size:.64rem;font-weight:800;color:#737a75;margin-top:.85rem}.form-grid label{margin-top:0}.drawer-section input,.drawer-section textarea{width:100%;box-sizing:border-box;border:1px solid #d4d6d2;border-radius:12px;background:#fbfbfa;padding:.75rem .8rem;font:inherit;font-size:.82rem;color:#303632;outline:0;box-shadow:0 1px 2px rgba(20,25,22,.025);transition:.18s}.drawer-section input{height:46px}.drawer-section input:focus,.drawer-section textarea:focus{border-color:#9ea59f;background:#fff;box-shadow:0 0 0 4px rgba(40,48,43,.055)}.drawer-section textarea{min-height:115px;resize:vertical;line-height:1.55}.toggle-row{display:grid;grid-template-columns:0 30px 1fr;align-items:start;gap:.7rem;cursor:pointer}.toggle-row input{position:absolute;opacity:0}.toggle-ui{width:30px;height:18px;border-radius:99px;background:#d4d6d2;position:relative}.toggle-ui:after{content:'';position:absolute;left:3px;top:3px;width:12px;height:12px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.15);transition:.2s}.toggle-row input:checked+.toggle-ui{background:#59635b}.toggle-row input:checked+.toggle-ui:after{transform:translateX(12px)}.toggle-row strong{font-size:.76rem}.toggle-row small{display:block;margin-top:.2rem;font-size:.65rem;line-height:1.45;color:#8b918c}.drawer-footer{position:sticky;bottom:0;margin:0 -1.5rem -1.5rem;padding:1rem 1.5rem;background:rgba(245,245,242,.97);border-top:1px solid #dedfdb;display:flex;align-items:center;gap:.6rem}.drawer-footer #save-result{margin-right:auto;font-size:.68rem;color:#777d78}
    .merge-overlay{display:grid;place-items:center;padding:1rem}.merge-dialog{position:relative;width:min(600px,100%);max-height:calc(100vh - 2rem);overflow:auto;background:#fff;border-radius:22px;padding:1.8rem;box-shadow:0 30px 90px rgba(0,0,0,.25)}.merge-close{position:absolute;right:1rem;top:1rem}.merge-icon{width:44px;height:44px;border-radius:14px;background:#f0efeb;display:grid;place-items:center;margin-bottom:1rem}.merge-dialog h2{margin:.25rem 0 .4rem;font-size:1.5rem;letter-spacing:-.035em}.merge-dialog>p{font-size:.78rem;line-height:1.6;color:#808680;margin:0 0 1.3rem}.select-label{display:grid;gap:.4rem;font-size:.64rem;font-weight:800;color:#737a75}.select-label select{height:47px;border:1px solid #d4d6d2;border-radius:12px;background:#fbfbfa;padding:0 .8rem;font:inherit;font-size:.82rem}.merge-dialog fieldset{border:0;border-top:1px solid #e4e5e2;padding:1.2rem 0 0;margin:1.3rem 0 0;display:grid;gap:.65rem}.merge-dialog legend{font-size:.67rem;font-weight:800;margin-bottom:.15rem}.choice{display:flex;gap:.7rem;align-items:flex-start;border:1px solid #e0e1dd;border-radius:13px;padding:.85rem;cursor:pointer}.choice:has(input:checked){border-color:#b9bdb8;background:#fafaf8}.choice input{margin-top:.2rem}.choice span{display:grid;gap:.18rem}.choice strong{font-size:.74rem}.choice small{font-size:.65rem;color:#858b86;line-height:1.45}.merge-actions{display:flex;justify-content:flex-end;gap:.6rem;margin-top:1.2rem}.merge-dialog #merge-result{font-size:.68rem;color:#8a4d4d;min-height:1em;margin-top:.6rem}
    @media(max-width:900px){.directory{padding:3rem 1.1rem 5rem}.directory-bar{align-items:stretch;flex-direction:column}.stats div{flex:1}.person-summary{grid-template-columns:48px minmax(0,1fr) 24px}.registrations,.email-status{display:none}.profile-top{align-items:flex-start;flex-direction:column}.profile-actions{width:100%}.profile-actions .button{flex:1}.profile-layout{grid-template-columns:1fr}.journey-section,.preference{grid-column:auto}.story-list{grid-template-columns:1fr}.story{padding:1rem 0}.story+.story{border-left:0;border-top:1px solid #e9eae7;padding-left:0}.data-row{grid-template-columns:125px minmax(0,1fr)}}
