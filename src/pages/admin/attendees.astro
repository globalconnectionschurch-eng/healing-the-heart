---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAdminRequest } from '../../lib/server';
if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
---
<BaseLayout title="Attendee Directory | Healing the Heart Admin">
  <section class="admin-shell directory-shell">
    <header class="directory-header">
      <div>
        <p class="eyebrow">People</p>
        <h1>Attendee directory</h1>
        <p class="lede">One clear profile for every person who has registered or attended Healing the Heart.</p>
      </div>
      <a class="button outline" href="/admin">← Dashboard</a>
    </header>

    <section class="directory-toolbar" aria-label="Directory tools">
      <div class="search-wrap"><span aria-hidden="true">⌕</span><input id="search" placeholder="Search name, email, or phone" autocomplete="off" /></div>
      <div class="directory-stats"><span id="count" class="stat"><b>0</b> people</span><span id="opt-in-count" class="stat muted">0 available for mass email</span></div>
    </section>

    <div id="people" class="people"><div class="admin-empty">Loading…</div></div>
  </section>

  <div id="merge-panel" class="merge-overlay" hidden aria-hidden="true">
    <div class="merge-backdrop"></div>
    <section class="merge-dialog" role="dialog" aria-modal="true" aria-labelledby="merge-title">
      <button id="merge-close" class="merge-close" type="button" aria-label="Close">×</button>
      <p class="eyebrow">Merge profiles</p>
      <h2 id="merge-title">Combine duplicate attendee records</h2>
      <p class="merge-description">Choose the duplicate profile. Its registrations will be moved to the person you are keeping, and the duplicate record will then be removed.</p>
      <label class="field-label">Duplicate profile<select id="merge-duplicate"><option value="">Choose a person…</option></select></label>
      <fieldset><legend>Profile information to keep</legend>
        <label class="radio-row"><input type="radio" name="profile-source" value="primary" checked><span><strong>Keep the selected person's information</strong><small>Use the current profile as the source.</small></span></label>
        <label class="radio-row"><input type="radio" name="profile-source" value="duplicate"><span><strong>Use the duplicate person's information</strong><small>Useful when the returning attendee has newer contact details.</small></span></label>
      </fieldset>
      <div class="merge-actions"><button id="merge-cancel" class="button outline" type="button">Cancel</button><button id="merge-confirm" class="button primary" type="button">Merge profiles</button></div>
      <p id="merge-result" class="field-note"></p>
    </section>
  </div>

  <script is:inline>
    const people=document.querySelector('#people'),search=document.querySelector('#search'),count=document.querySelector('#count'),optInCount=document.querySelector('#opt-in-count'),mergePanel=document.querySelector('#merge-panel');
    const mergeDuplicate=document.querySelector('#merge-duplicate'),mergeResult=document.querySelector('#merge-result');
    const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    const val=v=>v?esc(v):'<span class="empty-value">Not provided</span>';
    let rows=[],mergeTarget=null;
    const field=(label,name,value,type='text')=>`<label class="edit-field"><span>${label}</span><input name="${name}" type="${type}" value="${esc(value||'')}"></label>`;
    const info=(label,value,wide=false)=>`<div class="info-item${wide?' wide':''}"><span>${label}</span><strong>${val(value)}</strong></div>`;

    function render(){
      const q=search.value.toLowerCase().trim(),filtered=rows.filter(s=>`${s.name} ${s.email} ${s.phone||''}`.toLowerCase().includes(q));
      count.innerHTML=`<b>${filtered.length}</b> ${filtered.length===1?'person':'people'}`;
      optInCount.textContent=`${rows.filter(s=>!s.mass_email_opt_out).length} available for mass email`;
      people.innerHTML=filtered.map(s=>`<details class="person">
        <summary>
          <span class="avatar">${esc((s.name||'?').trim().charAt(0).toUpperCase())}</span>
          <span class="person-main"><strong>${esc(s.name||'Unnamed')}</strong><small>${esc(s.email||'No email on file')}</small></span>
          <span class="person-count"><b>${Number(s.registration_count)||0}</b><small>${Number(s.registration_count)===1?'registration':'registrations'}</small></span>
          <span class="person-status ${s.mass_email_opt_out?'off':''}">${s.mass_email_opt_out?'Mass email off':'Mass email on'}</span>
          <span class="chevron" aria-hidden="true">›</span>
        </summary>

        <div class="profile-body" data-id="${esc(s.id)}">
          <header class="profile-head">
            <div class="profile-identity"><span class="large-avatar">${esc((s.name||'?').trim().charAt(0).toUpperCase())}</span><div><p class="eyebrow">Attendee profile</p><h2>${esc(s.name||'Unnamed')}</h2><p>${Number(s.registration_count)||0} ${Number(s.registration_count)===1?'registration':'registrations'}${s.last_registration_date?` · Last registered ${esc(s.last_registration_date)}`:''}</p></div></div>
            <div class="profile-actions"><button class="button outline edit-start" type="button">Edit profile</button><button class="button outline merge-start" type="button" data-id="${esc(s.id)}">Merge duplicate</button></div>
          </header>

          <div class="view-mode">
            <section class="profile-card">
              <div class="card-heading"><span class="section-number">01</span><div><h3>Contact</h3><p>Current contact information</p></div></div>
              <div class="info-grid four">${info('Name',s.name)}${info('Email',s.email)}${info('Phone',s.phone)}${info('Date of birth',s.date_of_birth)}${info('Address',s.address,true)}</div>
            </section>

            <section class="profile-card">
              <div class="card-heading"><span class="section-number">02</span><div><h3>Background</h3><p>Personal and church information</p></div></div>
              <div class="info-grid four">${info('Marital status',s.marital_status)}${info('Church',s.church)}${info('Senior pastor',s.sr_pastor)}${info('How they heard',s.how_heard)}</div>
            </section>

            <section class="profile-card">
              <div class="card-heading"><span class="section-number">03</span><div><h3>Healing journey</h3><p>Information shared during registration</p></div></div>
              <div class="story-grid"><div class="story-item"><span>Goals / what they hoped to gain</span><p>${val(s.goals)}</p></div><div class="story-item"><span>Smoking / drinking concerns</span><p>${val(s.smoking_drinking)}</p></div><div class="story-item"><span>Anything else they shared</span><p>${val(s.anything_else)}</p></div></div>
            </section>

            <section class="profile-card preference-card">
              <div><h3>Email preference</h3><p>${s.mass_email_opt_out?'This person is excluded from mass/blast emails.':'This person can receive mass/blast emails.'}</p></div>
              <span class="preference-pill ${s.mass_email_opt_out?'off':''}">${s.mass_email_opt_out?'Mass email off':'Mass email on'}</span>
            </section>
          </div>

          <form class="edit-mode" data-id="${esc(s.id)}">
            <div class="edit-note"><strong>Edit attendee</strong><span>Make changes below, then save. Everything else remains read-only until you choose to edit.</span></div>
            <section class="profile-card edit-card"><div class="card-heading"><span class="section-number">01</span><div><h3>Contact</h3><p>Current contact information</p></div></div><div class="edit-grid four">${field('Name','name',s.name)}${field('Email','email',s.email,'email')}${field('Phone','phone',s.phone)}${field('Date of birth','date_of_birth',s.date_of_birth)}</div>${field('Address','address',s.address)}</section>
            <section class="profile-card edit-card"><div class="card-heading"><span class="section-number">02</span><div><h3>Background</h3><p>Personal and church information</p></div></div><div class="edit-grid four">${field('Marital status','marital_status',s.marital_status)}${field('Church','church',s.church)}${field('Senior pastor','sr_pastor',s.sr_pastor)}${field('How they heard','how_heard',s.how_heard)}</div></section>
            <section class="profile-card edit-card"><div class="card-heading"><span class="section-number">03</span><div><h3>Healing journey</h3><p>Information shared during registration</p></div></div><div class="edit-grid three"><label class="edit-field"><span>Goals / what they hoped to gain</span><textarea name="goals">${esc(s.goals||'')}</textarea></label><label class="edit-field"><span>Smoking / drinking concerns</span><textarea name="smoking_drinking">${esc(s.smoking_drinking||'')}</textarea></label><label class="edit-field"><span>Anything else they shared</span><textarea name="anything_else">${esc(s.anything_else||'')}</textarea></label></div></section>
            <section class="profile-card preference-card edit-preference"><label class="check"><input type="checkbox" name="mass_email_opt_out" ${s.mass_email_opt_out?'checked':''}><span><strong>Do not include in mass/blast emails</strong><small>Direct class and registration emails can still be sent.</small></span></label></section>
            <footer class="edit-footer"><span class="save-result field-note"></span><button class="button outline edit-cancel" type="button">Cancel</button><button class="button primary" type="submit">Save changes</button></footer>
          </form>
        </div>
      </details>`).join('')||'<div class="admin-empty">No matching attendees.</div>';
      people.querySelectorAll('.edit-start').forEach(b=>b.addEventListener('click',()=>{const body=b.closest('.profile-body');body.classList.add('editing');}));
      people.querySelectorAll('.edit-cancel').forEach(b=>b.addEventListener('click',()=>b.closest('.profile-body').classList.remove('editing')));
      people.querySelectorAll('form.edit-mode').forEach(f=>f.addEventListener('submit',save));
      people.querySelectorAll('.merge-start').forEach(b=>b.addEventListener('click',e=>{e.preventDefault();e.stopPropagation();openMerge(b.dataset.id);}));
    }
    async function load(){const r=await fetch('/api/admin/attendees');if(r.status===401){location='/admin-login';return;}const d=await r.json();rows=d.students||[];render();}
    async function save(e){e.preventDefault();const f=e.currentTarget,result=f.querySelector('.save-result');result.textContent='Saving…';const data=Object.fromEntries(new FormData(f));data.id=f.dataset.id;data.mass_email_opt_out=f.querySelector('[name="mass_email_opt_out"]').checked?1:0;const r=await fetch('/api/admin/attendees',{method:'PUT',headers:{'content-type':'application/json'},body:JSON.stringify(data)});result.textContent=r.ok?'Saved.':'Save failed.';if(r.ok)load();}
    function openMerge(id){mergeTarget=rows.find(x=>x.id===id);if(!mergeTarget)return;mergeDuplicate.innerHTML='<option value="">Choose a person…</option>'+rows.filter(x=>x.id!==id).map(x=>`<option value="${esc(x.id)}">${esc(x.name||'Unnamed')} · ${esc(x.email||'No email')}</option>`).join('');mergeResult.textContent='';mergePanel.hidden=false;mergePanel.setAttribute('aria-hidden','false');document.body.classList.add('modal-open');setTimeout(()=>mergeDuplicate.focus(),0);}
    function closeMerge(){mergePanel.hidden=true;mergePanel.setAttribute('aria-hidden','true');document.body.classList.remove('modal-open');mergeTarget=null;}
    document.querySelector('#merge-close').onclick=closeMerge;document.querySelector('#merge-cancel').onclick=closeMerge;document.querySelector('.merge-backdrop').onclick=closeMerge;
    document.querySelector('#merge-confirm').onclick=async()=>{const dup=mergeDuplicate.value;if(!dup){mergeResult.textContent='Choose the duplicate profile first.';return;}const useDup=document.querySelector('[name="profile-source"]:checked').value==='duplicate';if(!confirm('Merge these profiles? The duplicate profile will be removed after its registrations are transferred.'))return;mergeResult.textContent='Merging…';const r=await fetch('/api/admin/attendees/merge',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({survivorId:mergeTarget.id,duplicateId:dup,useDuplicateProfile:useDup})});const d=await r.json();mergeResult.textContent=r.ok?'Profiles merged.':(d.error||'Merge failed.');if(r.ok){closeMerge();load();}};
    document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!mergePanel.hidden)closeMerge();});search.addEventListener('input',render);load();
  </script>

  <style>
    :global(body.modal-open){overflow:hidden}
    .directory-shell{max-width:1180px;padding-bottom:5rem}
    .directory-header{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;margin-bottom:1.75rem}.directory-header h1{margin:.15rem 0 .45rem;letter-spacing:-.035em}.lede{margin:0;max-width:680px;line-height:1.6;opacity:.64}
    .directory-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1rem;align-items:center;padding:1rem;background:#f7f5f1;border:1px solid rgba(0,0,0,.08);border-radius:14px;margin-bottom:1rem}.search-wrap{position:relative}.search-wrap span{position:absolute;left:1rem;top:50%;transform:translateY(-50%);font-size:1.15rem;opacity:.4}.search-wrap input{width:100%;box-sizing:border-box;padding:.82rem 1rem .82rem 2.55rem;border:1px solid rgba(0,0,0,.12);border-radius:10px;background:#fff;font:inherit;outline:none}.search-wrap input:focus{border-color:rgba(0,0,0,.3);box-shadow:0 0 0 3px rgba(0,0,0,.04)}.directory-stats{display:flex;gap:.55rem;align-items:center;justify-content:flex-end}.stat{padding:.55rem .75rem;border:1px solid rgba(0,0,0,.08);border-radius:9px;background:#fff;font-size:.78rem;white-space:nowrap}.stat b{font-size:.9rem}.stat.muted{opacity:.65}
    .people{display:grid;gap:.65rem}.person{border:1px solid rgba(0,0,0,.1);border-radius:14px;background:#fff;overflow:hidden;box-shadow:0 2px 10px rgba(0,0,0,.025)}.person[open]{border-color:rgba(0,0,0,.16);box-shadow:0 8px 26px rgba(0,0,0,.055)}.person summary{list-style:none;cursor:pointer;display:grid;grid-template-columns:44px minmax(0,1fr) 110px 120px 24px;gap:1rem;align-items:center;padding:.85rem 1rem}.person summary::-webkit-details-marker{display:none}.avatar{width:44px;height:44px;display:grid;place-items:center;border-radius:11px;background:#eee9e0;font-weight:700}.person-main{min-width:0;display:grid;gap:.18rem}.person-main strong{font-size:.95rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.person-main small{font-size:.78rem;opacity:.56;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.person-count{display:grid;gap:.08rem;text-align:right;border-left:1px solid rgba(0,0,0,.07);padding-left:1rem}.person-count b{font-size:.9rem}.person-count small{font-size:.7rem;opacity:.55}.person-status{font-size:.7rem;text-align:center;padding:.35rem .45rem;border-radius:999px;background:#edf3ed;white-space:nowrap}.person-status.off{background:#f3eaea}.chevron{font-size:1.45rem;line-height:1;opacity:.35;text-align:center;transition:transform .18s}.person[open] .chevron{transform:rotate(90deg)}
    .profile-body{border-top:1px solid rgba(0,0,0,.08);background:#f8f7f4;padding:1.35rem;display:grid;gap:1rem}.profile-head{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.2rem .15rem .6rem}.profile-identity{display:flex;align-items:center;gap:.85rem}.large-avatar{width:52px;height:52px;display:grid;place-items:center;border-radius:14px;background:#e9e3d8;font-size:1.1rem;font-weight:700}.profile-head h2{margin:.05rem 0 .15rem;letter-spacing:-.025em;font-size:1.3rem}.profile-head p{margin:0;font-size:.75rem;opacity:.55}.profile-actions{display:flex;gap:.55rem;flex-wrap:wrap}.profile-card{background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:12px;padding:1.1rem 1.2rem}.card-heading{display:flex;align-items:center;gap:.7rem;padding-bottom:.85rem;margin-bottom:.9rem;border-bottom:1px solid rgba(0,0,0,.07)}.section-number{font-size:.65rem;font-weight:800;letter-spacing:.08em;opacity:.35}.card-heading h3{margin:0 0 .12rem;font-size:.86rem;letter-spacing:-.01em}.card-heading p{margin:0;font-size:.7rem;opacity:.5}.info-grid{display:grid;gap:0}.info-grid.four{grid-template-columns:repeat(4,minmax(0,1fr))}.info-item{min-width:0;padding:.15rem 1rem .65rem 0}.info-item.wide{grid-column:1/-1;padding-top:.25rem;border-top:1px solid rgba(0,0,0,.055);margin-top:.15rem}.info-item span,.story-item>span{display:block;font-size:.65rem;font-weight:700;letter-spacing:.02em;text-transform:uppercase;opacity:.42;margin-bottom:.3rem}.info-item strong{display:block;font-size:.82rem;font-weight:500;line-height:1.4;overflow-wrap:anywhere}.empty-value{opacity:.38;font-weight:400}.story-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1rem}.story-item{min-width:0}.story-item p{margin:0;font-size:.8rem;line-height:1.55;white-space:pre-wrap}.preference-card{display:flex;align-items:center;justify-content:space-between;gap:1rem}.preference-card h3{margin:0 0 .2rem;font-size:.82rem}.preference-card p{margin:0;font-size:.72rem;opacity:.55}.preference-pill{font-size:.68rem;font-weight:700;padding:.4rem .6rem;border-radius:999px;background:#edf3ed;white-space:nowrap}.preference-pill.off{background:#f3eaea}
    .edit-mode{display:none;gap:1rem}.profile-body.editing .view-mode{display:none}.profile-body.editing .edit-mode{display:grid}.edit-note{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:.2rem .15rem .3rem}.edit-note strong{font-size:.82rem}.edit-note span{font-size:.7rem;opacity:.5}.edit-grid{display:grid;gap:1rem}.edit-grid.four{grid-template-columns:repeat(4,minmax(0,1fr))}.edit-grid.three{grid-template-columns:repeat(3,minmax(0,1fr))}.edit-field{display:grid;gap:.4rem}.edit-field>span{font-size:.65rem;font-weight:700;letter-spacing:.02em;text-transform:uppercase;opacity:.5}.edit-field input,.edit-field textarea{width:100%;box-sizing:border-box;border:1px solid rgba(0,0,0,.12);border-radius:8px;background:#fff;padding:.68rem .72rem;font:inherit;font-size:.8rem;color:#222;outline:none}.edit-field input:focus,.edit-field textarea:focus{border-color:rgba(0,0,0,.3);box-shadow:0 0 0 3px rgba(0,0,0,.035)}.edit-field textarea{min-height:105px;resize:vertical;line-height:1.5}.edit-card>.edit-field{margin-top:.9rem}.edit-preference{padding:.9rem 1rem}.check{display:flex;gap:.7rem;align-items:flex-start}.check>input{margin-top:.18rem}.check span{display:grid;gap:.18rem}.check strong{font-size:.78rem}.check small{font-size:.7rem;opacity:.52;line-height:1.4}.edit-footer{display:flex;justify-content:flex-end;align-items:center;gap:.65rem}.field-note{font-size:.72rem;opacity:.6;margin-right:auto}
    .merge-overlay[hidden]{display:none}.merge-overlay{position:fixed;inset:0;z-index:1000;display:grid;place-items:center;padding:1.25rem}.merge-backdrop{position:absolute;inset:0;background:rgba(20,18,15,.5);backdrop-filter:blur(3px)}.merge-dialog{position:relative;z-index:1;width:min(620px,100%);max-height:calc(100vh - 2.5rem);overflow:auto;box-sizing:border-box;background:#fff;border-radius:18px;padding:1.7rem;box-shadow:0 24px 70px rgba(0,0,0,.24);display:grid;gap:1rem}.merge-dialog h2{margin:.05rem 0 .1rem;letter-spacing:-.025em}.merge-description{margin:0;line-height:1.55;font-size:.84rem;opacity:.65}.merge-close{position:absolute;right:1rem;top:.85rem;border:0;background:transparent;font-size:1.7rem;line-height:1;opacity:.45;cursor:pointer}.merge-dialog fieldset{border:0;margin:0;padding:1rem 0 0;border-top:1px solid rgba(0,0,0,.08);display:grid;gap:.65rem}.merge-dialog legend{font-size:.75rem;font-weight:700;margin-bottom:.25rem}.radio-row{display:flex;gap:.65rem;align-items:flex-start;padding:.75rem;border:1px solid rgba(0,0,0,.08);border-radius:10px;cursor:pointer}.radio-row>input{margin-top:.2rem}.radio-row span{display:grid;gap:.15rem}.radio-row strong{font-size:.78rem}.radio-row small{font-size:.7rem;opacity:.55;line-height:1.4}.merge-actions{display:flex;justify-content:flex-end;gap:.65rem;padding-top:.3rem}
    @media(max-width:900px){.person summary{grid-template-columns:44px minmax(0,1fr) 90px 24px}.person-status{grid-column:3}.person-count{grid-column:3;grid-row:1;text-align:left;border-left:0;padding-left:0}.info-grid.four,.edit-grid.four{grid-template-columns:repeat(2,minmax(0,1fr))}.story-grid,.edit-grid.three{grid-template-columns:1fr}.directory-toolbar{grid-template-columns:1fr}.directory-stats{justify-content:flex-start}}
    @media(max-width:640px){.directory-header{align-items:flex-start;flex-direction:column}.directory-header .button{width:100%;text-align:center}.person summary{grid-template-columns:38px minmax(0,1fr) 22px;padding:.75rem;gap:.7rem}.avatar{width:38px;height:38px}.person-count,.person-status{display:none}.chevron{grid-column:3}.profile-body{padding:1rem}.profile-head{align-items:flex-start;flex-direction:column}.profile-actions{width:100%}.profile-actions .button{flex:1;text-align:center}.info-grid.four,.edit-grid.four{grid-template-columns:1fr}.info-item{padding-right:0}.story-grid{grid-template-columns:1fr}.profile-card{padding:1rem}.edit-note{align-items:flex-start;flex-direction:column}.edit-footer{flex-wrap:wrap}.edit-footer .field-note{width:100%;margin-right:0}.edit-footer .button{flex:1;text-align:center}.preference-card{align-items:flex-start;flex-direction:column}.merge-dialog{padding:1.35rem;border-radius:15px}.merge-actions{flex-direction:column-reverse}.merge-actions .button{width:100%;text-align:center}}
  </style>
</BaseLayout>
