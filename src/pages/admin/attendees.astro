---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAdminRequest } from '../../lib/server';
if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
---
<BaseLayout title="Attendee Directory | Healing the Heart Admin">
  <section class="admin-shell directory-shell">
    <div class="admin-header directory-header">
      <div>
        <p class="eyebrow">People</p>
        <h1>Attendee directory</h1>
        <p>A living record of everyone who has registered or attended Healing the Heart.</p>
      </div>
      <div class="header-actions">
        <a class="button outline" href="/admin">← Dashboard</a>
      </div>
    </div>

    <div class="directory-intro">
      <div class="intro-mark">◎</div>
      <div>
        <strong>One profile per person.</strong>
        <p>Keep contact information current, see how many times someone has registered, manage mass-email preferences, and merge duplicate profiles when someone returns.</p>
      </div>
    </div>

    <div class="directory-toolbar">
      <div class="search-wrap">
        <span aria-hidden="true">⌕</span>
        <input id="search" placeholder="Search by name, email, or phone…" autocomplete="off" />
      </div>
      <div class="directory-stats">
        <span id="count" class="status-pill">0 people</span>
        <span id="opt-in-count" class="status-pill soft">0 available for mass email</span>
      </div>
    </div>

    <div id="people" class="people"><div class="admin-empty">Loading…</div></div>
    <div id="merge-panel" class="merge-panel" hidden></div>
  </section>

  <script is:inline>
    const people=document.querySelector('#people'),search=document.querySelector('#search'),count=document.querySelector('#count'),optInCount=document.querySelector('#opt-in-count'),mergePanel=document.querySelector('#merge-panel');
    const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    let rows=[];
    function render(){
      const q=search.value.toLowerCase().trim();
      const filtered=rows.filter(s=>`${s.name} ${s.email} ${s.phone||''}`.toLowerCase().includes(q));
      count.textContent=`${filtered.length} ${filtered.length===1?'person':'people'}`;
      optInCount.textContent=`${rows.filter(s=>!s.mass_email_opt_out).length} available for mass email`;
      people.innerHTML=filtered.map(s=>`<details class="person">
        <summary>
          <span class="avatar">${esc((s.name||'?').trim().charAt(0).toUpperCase())}</span>
          <span class="person-main"><strong>${esc(s.name||'Unnamed')}</strong><small>${esc(s.email||'No email on file')}</small></span>
          <span class="person-meta"><span><b>${Number(s.registration_count)||0}</b> ${Number(s.registration_count)===1?'registration':'registrations'}</span><em class="${s.mass_email_opt_out?'off':''}">${s.mass_email_opt_out?'Mass email off':'Mass email on'}</em><i aria-hidden="true">›</i></span>
        </summary>
        <form class="person-form" data-id="${esc(s.id)}">
          <div class="profile-heading">
            <div><p class="eyebrow">Person profile</p><h2>${esc(s.name||'Unnamed')}</h2><p class="profile-subline">${Number(s.registration_count)||0} ${Number(s.registration_count)===1?'registration':'registrations'}${s.last_registration_date?` · Last registered ${esc(s.last_registration_date)}`:''}</p></div>
            <button class="button outline merge-start" type="button" data-id="${esc(s.id)}">Merge duplicate</button>
          </div>
          <div class="profile-section"><p class="section-label">Contact</p><div class="form-grid">${[['name','Name','text'],['email','Email','email'],['phone','Phone','text'],['date_of_birth','Date of birth','text']].map(([n,l,t])=>`<label>${l}<input name="${n}" type="${t}" value="${esc(s[n])}"></label>`).join('')}</div><label>Address<input name="address" value="${esc(s.address)}"></label></div>
          <div class="profile-section"><p class="section-label">Background</p><div class="form-grid">${[['marital_status','Marital status','text'],['church','Church','text'],['sr_pastor','Senior pastor','text'],['how_heard','How they heard','text']].map(([n,l,t])=>`<label>${l}<input name="${n}" type="${t}" value="${esc(s[n])}"></label>`).join('')}</div></div>
          <div class="profile-section"><p class="section-label">Healing journey</p><label>Goals / what they hoped to gain<textarea name="goals">${esc(s.goals)}</textarea></label><label>Smoking / drinking concerns<textarea name="smoking_drinking">${esc(s.smoking_drinking)}</textarea></label><label>Anything else they shared<textarea name="anything_else">${esc(s.anything_else)}</textarea></label></div>
          <div class="profile-preferences"><label class="check"><input type="checkbox" name="mass_email_opt_out" ${s.mass_email_opt_out?'checked':''}> <span><strong>Do not include in mass/blast emails</strong><small>This person can still receive direct class or registration emails.</small></span></label></div>
          <div class="profile-footer"><span class="save-result field-note"></span><button class="button primary" type="submit">Save profile</button></div>
        </form>
      </details>`).join('')||'<div class="admin-empty">No matching attendees.</div>';
      people.querySelectorAll('form').forEach(f=>f.addEventListener('submit',save));
      people.querySelectorAll('.merge-start').forEach(b=>b.addEventListener('click',()=>openMerge(b.dataset.id)));
    }
    async function load(){const r=await fetch('/api/admin/attendees');if(r.status===401){location='/admin-login';return;}const d=await r.json();rows=d.students||[];render();}
    async function save(e){e.preventDefault();const f=e.currentTarget;const result=f.querySelector('.save-result');result.textContent='Saving…';const data=Object.fromEntries(new FormData(f));data.id=f.dataset.id;data.mass_email_opt_out=f.querySelector('[name="mass_email_opt_out"]').checked?1:0;const r=await fetch('/api/admin/attendees',{method:'PUT',headers:{'content-type':'application/json'},body:JSON.stringify(data)});result.textContent=r.ok?'Saved.':'Save failed.';if(r.ok)load();}
    function openMerge(id){const target=rows.find(x=>x.id===id);if(!target)return;const options=rows.filter(x=>x.id!==id).slice(0,100);mergePanel.hidden=false;mergePanel.innerHTML=`<div class="merge-card"><div><p class="eyebrow">Merge profiles</p><h2>Is this person a duplicate?</h2><p>Registrations from the duplicate will be moved to the selected profile. If both profiles have the same class, the existing registration is kept.</p></div><label>Duplicate profile<select id="merge-duplicate"><option value="">Choose a person…</option>${options.map(x=>`<option value="${esc(x.id)}">${esc(x.name)} · ${esc(x.email)}</option>`).join('')}</select></label><fieldset><legend>Profile information to keep</legend><label><input type="radio" name="profile-source" value="primary" checked> Keep ${esc(target.name)}'s current profile</label><label><input type="radio" name="profile-source" value="duplicate"> Use the duplicate profile's newer information</label></fieldset><div class="merge-actions"><button id="merge-cancel" class="button outline" type="button">Cancel</button><button id="merge-confirm" class="button primary" type="button">Merge profiles</button></div><p id="merge-result" class="field-note"></p></div>`;document.querySelector('#merge-cancel').onclick=()=>mergePanel.hidden=true;document.querySelector('#merge-confirm').onclick=async()=>{const dup=document.querySelector('#merge-duplicate').value;if(!dup){document.querySelector('#merge-result').textContent='Choose the duplicate profile first.';return;}const useDup=document.querySelector('[name="profile-source"]:checked').value==='duplicate';if(!confirm('Merge these profiles? The duplicate profile will be removed after its registrations are transferred.'))return;const r=await fetch('/api/admin/attendees/merge',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({survivorId:id,duplicateId:dup,useDuplicateProfile:useDup})});const d=await r.json();document.querySelector('#merge-result').textContent=r.ok?'Profiles merged.':(d.error||'Merge failed.');if(r.ok){mergePanel.hidden=true;load();}};}
    search.addEventListener('input',render);load();
  </script>

  <style>
    .directory-shell{max-width:1120px}
    .directory-header{margin-bottom:1rem}
    .header-actions{display:flex;align-items:center}
    .directory-intro{display:flex;gap:1rem;align-items:flex-start;padding:1.1rem 1.2rem;border:1px solid rgba(0,0,0,.08);border-radius:18px;background:linear-gradient(135deg,#f7f3ec,#fbfaf7);margin-bottom:1.15rem}
    .intro-mark{width:42px;height:42px;flex:0 0 42px;display:grid;place-items:center;border-radius:50%;background:#fff;border:1px solid rgba(0,0,0,.08);font-size:1.25rem}
    .directory-intro strong{display:block;margin:.1rem 0 .25rem;font-size:.95rem}.directory-intro p{margin:0;max-width:760px;line-height:1.55;font-size:.88rem;opacity:.72}
    .directory-toolbar{display:flex;gap:.8rem;align-items:center;margin:1.25rem 0 .9rem}.search-wrap{position:relative;flex:1}.search-wrap span{position:absolute;left:1rem;top:50%;transform:translateY(-50%);opacity:.45;font-size:1.1rem}.search-wrap input{width:100%;box-sizing:border-box;padding:.9rem 1rem .9rem 2.7rem;border:1px solid rgba(0,0,0,.12);border-radius:13px;background:#fff;font:inherit;outline:none}.search-wrap input:focus{border-color:rgba(0,0,0,.28);box-shadow:0 0 0 3px rgba(0,0,0,.045)}
    .directory-stats{display:flex;gap:.5rem;flex-wrap:wrap;justify-content:flex-end}.status-pill.soft{background:#f5f3ef;color:inherit}
    .people{display:grid;gap:.75rem}.person{background:#fff;border:1px solid rgba(0,0,0,.095);border-radius:17px;overflow:hidden;box-shadow:0 3px 16px rgba(0,0,0,.035);transition:box-shadow .2s,border-color .2s}.person[open]{border-color:rgba(0,0,0,.16);box-shadow:0 10px 30px rgba(0,0,0,.07)}
    .person summary{cursor:pointer;list-style:none;display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:1rem;align-items:center;padding:1rem 1.15rem}.person summary::-webkit-details-marker{display:none}.avatar{width:44px;height:44px;border-radius:13px;display:grid;place-items:center;background:#eee8df;font-weight:700;font-size:1rem}.person-main{display:grid;gap:.2rem;min-width:0}.person-main strong{font-size:1rem}.person-main small{opacity:.58;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.person-meta{display:flex;align-items:center;gap:.6rem;font-size:.78rem;opacity:.68}.person-meta b{font-size:.88rem;opacity:1}.person-meta em{font-style:normal;padding:.28rem .5rem;border-radius:999px;background:#edf3ed;white-space:nowrap}.person-meta em.off{background:#f3eaea}.person-meta i{font-style:normal;font-size:1.45rem;transition:transform .2s}.person[open] .person-meta i{transform:rotate(90deg)}
    .person-form{padding:1.4rem 1.35rem 1.25rem;border-top:1px solid rgba(0,0,0,.08);background:#fbfaf7;display:grid;gap:1rem}.profile-heading{display:flex;align-items:flex-start;justify-content:space-between;gap:1rem}.profile-heading h2{margin:.12rem 0 .1rem}.profile-subline{margin:0;opacity:.58;font-size:.83rem}.profile-section{display:grid;gap:.85rem;padding-top:.15rem}.section-label{margin:0;font-size:.72rem;text-transform:uppercase;letter-spacing:.1em;font-weight:700;opacity:.52}.person-form textarea{min-height:82px}.profile-preferences{padding-top:.15rem}.check{display:flex;gap:.7rem;align-items:flex-start;padding:.8rem .9rem;background:#fff;border:1px solid rgba(0,0,0,.08);border-radius:12px}.check>input{width:auto;margin-top:.2rem}.check span{display:grid;gap:.18rem}.check small{opacity:.58;line-height:1.4}.profile-footer{display:flex;justify-content:flex-end;align-items:center;gap:1rem;padding-top:.2rem}.merge-panel{position:sticky;bottom:1rem;z-index:5;margin-top:1rem}.merge-card{padding:1.35rem;border:1px solid rgba(0,0,0,.12);border-radius:18px;background:#fff;box-shadow:0 14px 40px rgba(0,0,0,.14);display:grid;gap:1rem}.merge-card h2{margin:.15rem 0 .2rem}.merge-card>div:first-child p:last-child{margin-bottom:0;max-width:760px;line-height:1.5;opacity:.7}.merge-card fieldset{border:0;padding:0;display:grid;gap:.65rem}.merge-card legend{font-weight:700;margin-bottom:.4rem}.merge-actions{display:flex;justify-content:flex-end;gap:.7rem}
    @media(max-width:760px){.directory-toolbar{flex-direction:column;align-items:stretch}.directory-stats{justify-content:flex-start}.person summary{grid-template-columns:auto minmax(0,1fr) auto;gap:.75rem}.person-meta{grid-column:2/-1;justify-content:flex-start;flex-wrap:wrap}.profile-heading{flex-direction:column}.profile-footer{flex-direction:column-reverse;align-items:stretch}.merge-actions{flex-direction:column-reverse}.directory-intro{padding:1rem}.intro-mark{width:38px;height:38px;flex-basis:38px}}
  </style>
</BaseLayout>
