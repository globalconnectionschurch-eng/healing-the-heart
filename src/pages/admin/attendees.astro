---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAdminRequest } from '../../lib/server';
if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
---
<BaseLayout title="Attendee Directory | Healing the Heart Admin">
  <section class="admin-shell directory-shell">
    <header class="directory-header">
      <div><p class="eyebrow">People</p><h1>Attendee directory</h1><p class="lede">A private, organized record of everyone who has registered with Healing the Heart.</p></div>
      <a class="button outline" href="/admin">← Dashboard</a>
    </header>
    <section class="directory-toolbar"><label class="search-box"><span>⌕</span><input id="search" placeholder="Search by name, email, or phone" autocomplete="off" /></label><div class="directory-stats"><div><b id="count-number">0</b><span>People</span></div><div><b id="opt-number">0</b><span>Email eligible</span></div></div></section>
    <div id="people" class="people"><div class="loading-state">Loading attendee directory…</div></div>
  </section>

  <div id="edit-panel" class="edit-overlay" hidden aria-hidden="true"><div class="edit-backdrop"></div><aside class="edit-drawer" role="dialog" aria-modal="true" aria-labelledby="edit-title">
    <header class="drawer-header"><div><p class="eyebrow">Edit attendee</p><h2 id="edit-title">Person details</h2><p>Update this person's record.</p></div><button id="edit-close" class="icon-button" type="button" aria-label="Close">×</button></header>
    <form id="edit-form" class="drawer-form"><input type="hidden" name="id" />
      <section class="drawer-section"><div class="drawer-section-title"><span>01</span><div><strong>Contact</strong><small>How to reach this person</small></div></div><div class="form-grid two"><label>Full name<input name="name" required></label><label>Email address<input name="email" type="email" required></label><label>Phone<input name="phone"></label><label>Date of birth<input name="date_of_birth"></label></div><label>Address<input name="address"></label></section>
      <section class="drawer-section"><div class="drawer-section-title"><span>02</span><div><strong>Background</strong><small>Personal and church information</small></div></div><div class="form-grid two"><label>Marital status<input name="marital_status"></label><label>Church<input name="church"></label><label>Senior pastor<input name="sr_pastor"></label><label>How they heard<input name="how_heard"></label></div></section>
      <section class="drawer-section"><div class="drawer-section-title"><span>03</span><div><strong>Healing journey</strong><small>Information shared during registration</small></div></div><label>Goals / what they hoped to gain<textarea name="goals"></textarea></label><label>Smoking / drinking concerns<textarea name="smoking_drinking"></textarea></label><label>Anything else they shared<textarea name="anything_else"></textarea></label></section>
      <section class="email-setting"><label class="toggle-row"><input type="checkbox" name="mass_email_opt_out"><span class="toggle-ui"></span><span><strong>Exclude from mass emails</strong><small>This person will not receive blast emails. Direct class emails are unaffected.</small></span></label></section>
      <footer class="drawer-footer"><span id="save-result"></span><button class="button outline" id="edit-cancel" type="button">Cancel</button><button class="button primary" type="submit">Save changes</button></footer>
    </form>
  </aside></div>

  <div id="merge-panel" class="merge-overlay" hidden aria-hidden="true"><div class="merge-backdrop"></div><section class="merge-dialog" role="dialog" aria-modal="true" aria-labelledby="merge-title"><button id="merge-close" class="icon-button merge-x" type="button" aria-label="Close">×</button><div class="merge-symbol">⇄</div><p class="eyebrow">Merge profiles</p><h2 id="merge-title">Combine duplicate attendee records</h2><p class="merge-description">Move registrations from a duplicate record into this person and remove the duplicate profile.</p><label class="select-label">Duplicate profile<select id="merge-duplicate"><option value="">Choose a person…</option></select></label><fieldset><legend>Profile information to keep</legend><label class="choice"><input type="radio" name="profile-source" value="primary" checked><span><strong>Keep this person's information</strong><small>Use the profile you opened as the source.</small></span></label><label class="choice"><input type="radio" name="profile-source" value="duplicate"><span><strong>Use the duplicate's information</strong><small>Use the duplicate when it contains newer details.</small></span></label></fieldset><div class="merge-actions"><button id="merge-cancel" class="button outline" type="button">Cancel</button><button id="merge-confirm" class="button primary" type="button">Merge profiles</button></div><p id="merge-result"></p></section></div>

  <script is:inline>
    const people=document.querySelector('#people'),search=document.querySelector('#search'),countNumber=document.querySelector('#count-number'),optNumber=document.querySelector('#opt-number');const editPanel=document.querySelector('#edit-panel'),editForm=document.querySelector('#edit-form'),saveResult=document.querySelector('#save-result');const mergePanel=document.querySelector('#merge-panel'),mergeDuplicate=document.querySelector('#merge-duplicate'),mergeResult=document.querySelector('#merge-result');
    const esc=v=>String(v??'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));const display=v=>v?esc(v):'<span class="not-provided">Not provided</span>';const initials=name=>{const p=String(name||'?').trim().split(/\s+/);return esc(((p[0]?.[0]||'')+(p.length>1?p[p.length-1][0]:'')).toUpperCase())};const field=(label,value,wide=false)=>`<div class="data-field ${wide?'wide':''}"><span>${label}</span><strong>${display(value)}</strong></div>`;let rows=[],mergeTarget=null;
    function render(){const q=search.value.toLowerCase().trim(),filtered=rows.filter(s=>`${s.name||''} ${s.email||''} ${s.phone||''}`.toLowerCase().includes(q));countNumber.textContent=filtered.length;optNumber.textContent=rows.filter(s=>!s.mass_email_opt_out).length;people.innerHTML=filtered.map(s=>`<article class="person-card" data-id="${esc(s.id)}"><button class="person-summary" type="button" aria-expanded="false"><span class="avatar">${initials(s.name)}</span><span class="person-identity"><strong>${esc(s.name||'Unnamed')}</strong><span>${esc(s.email||'No email on file')}</span></span><span class="summary-meta"><b>${Number(s.registration_count)||0}</b><span>${Number(s.registration_count)===1?'registration':'registrations'}</span></span><span class="email-badge ${s.mass_email_opt_out?'off':''}"><i></i>${s.mass_email_opt_out?'Email off':'Email on'}</span><span class="expand-mark">⌄</span></button><div class="person-detail" hidden><div class="profile-banner"><div class="profile-title"><span class="large-avatar">${initials(s.name)}</span><div><p class="eyebrow">Attendee profile</p><h2>${esc(s.name||'Unnamed')}</h2><span>${Number(s.registration_count)||0} ${Number(s.registration_count)===1?'registration':'registrations'}${s.last_registration_date?` · Last registered ${esc(s.last_registration_date)}`:''}</span></div></div><div class="profile-actions"><button class="button soft edit-start" type="button">Edit profile</button><button class="button soft merge-start" type="button" data-id="${esc(s.id)}">Merge duplicate</button></div></div><div class="profile-grid"><section class="info-card"><header><span class="card-number">01</span><div><h3>Contact</h3><p>Current contact information</p></div></header><div class="data-grid">${field('Full name',s.name)}${field('Email address',s.email)}${field('Phone',s.phone)}${field('Date of birth',s.date_of_birth)}${field('Address',s.address,true)}</div></section><section class="info-card"><header><span class="card-number">02</span><div><h3>Background</h3><p>Personal and church information</p></div></header><div class="data-grid">${field('Marital status',s.marital_status)}${field('Church',s.church)}${field('Senior pastor',s.sr_pastor)}${field('How they heard',s.how_heard)}</div></section><section class="info-card full"><header><span class="card-number">03</span><div><h3>Healing journey</h3><p>Information shared during registration</p></div></header><div class="story-grid"><div><span>Goals / what they hoped to gain</span><p>${display(s.goals)}</p></div><div><span>Smoking / drinking concerns</span><p>${display(s.smoking_drinking)}</p></div><div><span>Anything else they shared</span><p>${display(s.anything_else)}</p></div></div></section><section class="email-card full"><div><span class="email-card-icon">✉</span><div><strong>Mass email preference</strong><p>${s.mass_email_opt_out?'This person is excluded from mass/blast emails.':'This person can receive mass/blast emails.'}</p></div></div><span class="preference-status ${s.mass_email_opt_out?'off':''}">${s.mass_email_opt_out?'Excluded':'Included'}</span></section></div></div></article>`).join('')||'<div class="empty-state"><strong>No attendees found</strong><span>Try a different name, email, or phone number.</span></div>';people.querySelectorAll('.person-summary').forEach(btn=>btn.addEventListener('click',()=>{const card=btn.closest('.person-card'),detail=card.querySelector('.person-detail'),open=!card.classList.contains('open');document.querySelectorAll('.person-card.open').forEach(x=>{x.classList.remove('open');x.querySelector('.person-detail').hidden=true;x.querySelector('.person-summary').setAttribute('aria-expanded','false')});if(open){card.classList.add('open');detail.hidden=false;btn.setAttribute('aria-expanded','true')}}));people.querySelectorAll('.edit-start').forEach(b=>b.addEventListener('click',()=>openEdit(b.closest('.person-card').dataset.id)));people.querySelectorAll('.merge-start').forEach(b=>b.addEventListener('click',e=>{e.stopPropagation();openMerge(b.dataset.id)}))}
    async function load(){const r=await fetch('/api/admin/attendees');if(r.status===401){location='/admin-login';return}const d=await r.json();rows=d.students||[];render()}
    function openEdit(id){const s=rows.find(x=>x.id===id);if(!s)return;editForm.reset();editForm.dataset.id=s.id;for(const n of ['name','email','phone','date_of_birth','address','marital_status','church','sr_pastor','how_heard','goals','smoking_drinking','anything_else'])editForm.elements[n].value=s[n]||'';editForm.elements.mass_email_opt_out.checked=!!s.mass_email_opt_out;document.querySelector('#edit-title').textContent=s.name||'Person details';saveResult.textContent='';editPanel.hidden=false;editPanel.setAttribute('aria-hidden','false');document.body.classList.add('modal-open');setTimeout(()=>editForm.elements.name.focus(),40)}
    function closeEdit(){editPanel.hidden=true;editPanel.setAttribute('aria-hidden','true');document.body.classList.remove('modal-open')}
    async function save(e){e.preventDefault();saveResult.textContent='Saving…';const data=Object.fromEntries(new FormData(editForm));data.id=editForm.dataset.id;data.mass_email_opt_out=editForm.elements.mass_email_opt_out.checked?1:0;const r=await fetch('/api/admin/attendees',{method:'PUT',headers:{'content-type':'application/json'},body:JSON.stringify(data)});if(r.ok){closeEdit();await load()}else saveResult.textContent='Unable to save changes.'}
    function openMerge(id){mergeTarget=rows.find(x=>x.id===id);if(!mergeTarget)return;mergeDuplicate.innerHTML='<option value="">Choose a person…</option>'+rows.filter(x=>x.id!==id).map(x=>`<option value="${esc(x.id)}">${esc(x.name||'Unnamed')} · ${esc(x.email||'No email')}</option>`).join('');mergeResult.textContent='';mergePanel.hidden=false;mergePanel.setAttribute('aria-hidden','false');document.body.classList.add('modal-open')};function closeMerge(){mergePanel.hidden=true;mergePanel.setAttribute('aria-hidden','true');document.body.classList.remove('modal-open');mergeTarget=null};async function doMerge(){const dup=mergeDuplicate.value;if(!dup){mergeResult.textContent='Choose the duplicate profile first.';return}if(!confirm('Merge these profiles? The duplicate profile will be removed after its registrations are transferred.'))return;mergeResult.textContent='Merging…';const r=await fetch('/api/admin/attendees/merge',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify({survivorId:mergeTarget.id,duplicateId:dup,useDuplicateProfile:document.querySelector('[name="profile-source"]:checked').value==='duplicate'})});const d=await r.json();if(r.ok){closeMerge();load()}else mergeResult.textContent=d.error||'Merge failed.'}
    document.querySelector('#edit-close').onclick=closeEdit;document.querySelector('#edit-cancel').onclick=closeEdit;document.querySelector('.edit-backdrop').onclick=closeEdit;document.querySelector('#merge-close').onclick=closeMerge;document.querySelector('#merge-cancel').onclick=closeMerge;document.querySelector('.merge-backdrop').onclick=closeMerge;document.querySelector('#merge-confirm').onclick=doMerge;editForm.addEventListener('submit',save);search.addEventListener('input',render);document.addEventListener('keydown',e=>{if(e.key==='Escape'){if(!editPanel.hidden)closeEdit();if(!mergePanel.hidden)closeMerge()}});load();
  </script>

  <style>
    :global(body.modal-open){overflow:hidden}.directory-shell{max-width:1240px;padding:3.5rem 2rem 6rem}.directory-header{display:flex;justify-content:space-between;align-items:flex-end;gap:2rem;margin-bottom:2rem}.directory-header h1{margin:.15rem 0 .45rem;letter-spacing:-.04em;font-size:clamp(2rem,4vw,3rem)}.lede{margin:0;max-width:680px;line-height:1.6;color:rgba(20,24,22,.58)}
    .directory-toolbar{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:1.2rem;align-items:center;margin-bottom:1rem}.search-box{position:relative;display:block}.search-box span{position:absolute;left:1.05rem;top:50%;transform:translateY(-50%);font-size:1.2rem;color:rgba(20,24,22,.4)}.search-box input{width:100%;height:54px;box-sizing:border-box;padding:0 1.1rem 0 2.8rem;border:1px solid rgba(20,24,22,.1);border-radius:15px;background:#fff;box-shadow:0 3px 16px rgba(20,24,22,.035);font:inherit;font-size:.9rem;outline:none}.search-box input:focus{border-color:rgba(20,24,22,.28);box-shadow:0 0 0 4px rgba(20,24,22,.045)}.directory-stats{display:flex;gap:.65rem}.directory-stats div{min-width:125px;padding:.72rem .95rem;border:1px solid rgba(20,24,22,.09);border-radius:13px;background:#fff;display:flex;align-items:baseline;gap:.45rem;box-shadow:0 3px 16px rgba(20,24,22,.025)}.directory-stats b{font-size:1.05rem}.directory-stats span{font-size:.67rem;color:rgba(20,24,22,.52)}
    .people{display:grid;gap:.7rem}.person-card{border:1px solid rgba(20,24,22,.1);border-radius:18px;background:#fff;overflow:hidden;box-shadow:0 2px 14px rgba(20,24,22,.025);transition:.2s}.person-card.open{border-color:rgba(20,24,22,.17);box-shadow:0 14px 40px rgba(20,24,22,.08)}.person-summary{appearance:none;width:100%;border:0;background:#fff;display:grid;grid-template-columns:48px minmax(0,1fr) 110px 115px 24px;gap:1.1rem;align-items:center;padding:1rem 1.15rem;text-align:left;cursor:pointer;font:inherit;color:inherit}.person-summary:hover{background:#fcfcfa}.avatar,.large-avatar{display:grid;place-items:center;background:#ece9e2;color:#262b28;font-weight:700}.avatar{width:48px;height:48px;border-radius:13px;font-size:.8rem}.person-identity{min-width:0;display:grid;gap:.25rem}.person-identity strong{font-size:.95rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.person-identity span{font-size:.76rem;color:rgba(20,24,22,.5);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.summary-meta{display:grid;gap:.05rem;border-left:1px solid rgba(20,24,22,.08);padding-left:1rem}.summary-meta b{font-size:.88rem}.summary-meta span{font-size:.67rem;color:rgba(20,24,22,.48)}.email-badge{font-size:.66rem;display:flex;justify-content:center;align-items:center;gap:.35rem;padding:.42rem .5rem;border-radius:999px;background:#eef4ee;color:#3f6249;white-space:nowrap}.email-badge.off{background:#f4eded;color:#765151}.email-badge i{width:6px;height:6px;border-radius:50%;background:currentColor}.expand-mark{font-size:1.1rem;text-align:center;color:rgba(20,24,22,.35);transition:.2s}.person-card.open .expand-mark{transform:rotate(180deg)}
    .person-detail{border-top:1px solid rgba(20,24,22,.08);background:#f5f4f0;padding:1.35rem}.profile-banner{display:flex;justify-content:space-between;align-items:center;gap:1.5rem;padding:.35rem .2rem 1.25rem}.profile-title{display:flex;align-items:center;gap:.9rem}.large-avatar{width:58px;height:58px;border-radius:16px;font-size:.95rem}.profile-title h2{margin:.08rem 0 .2rem;font-size:1.25rem;letter-spacing:-.025em}.profile-title>div>span{font-size:.72rem;color:rgba(20,24,22,.48)}.profile-actions{display:flex;gap:.5rem}.button.soft{background:#fff;border:1px solid rgba(20,24,22,.11);color:#202521}.button.soft:hover{background:#f0efeb}.profile-grid{display:grid;grid-template-columns:1fr 1fr;gap:.8rem}.info-card,.email-card{background:#fff;border:1px solid rgba(20,24,22,.08);border-radius:15px}.info-card{padding:1.2rem}.info-card.full,.email-card.full{grid-column:1/-1}.info-card header{display:flex;gap:.75rem;align-items:center;margin-bottom:1rem}.card-number{font-size:.63rem;font-weight:800;letter-spacing:.08em;color:rgba(20,24,22,.36)}.info-card h3{margin:0 0 .15rem;font-size:.85rem}.info-card header p{margin:0;font-size:.68rem;color:rgba(20,24,22,.45)}.data-grid{display:grid;grid-template-columns:1fr 1fr;border-top:1px solid rgba(20,24,22,.07)}.data-field{min-width:0;padding:.8rem .75rem;border-bottom:1px solid rgba(20,24,22,.06)}.data-field:nth-child(odd){border-right:1px solid rgba(20,24,22,.06);padding-left:0}.data-field.wide{grid-column:1/-1;border-right:0;padding-left:0}.data-field span,.story-grid>div>span{display:block;font-size:.61rem;text-transform:uppercase;letter-spacing:.055em;font-weight:700;color:rgba(20,24,22,.42);margin-bottom:.32rem}.data-field strong{display:block;font-size:.8rem;line-height:1.5;color:#252a27;font-weight:600;overflow-wrap:anywhere}.not-provided{font-weight:500!important;color:rgba(20,24,22,.32)!important;font-style:italic}.story-grid{display:grid;grid-template-columns:1fr 1fr 1fr;border-top:1px solid rgba(20,24,22,.07)}.story-grid>div{padding:.85rem .9rem}.story-grid>div:first-child{padding-left:0}.story-grid>div+div{border-left:1px solid rgba(20,24,22,.07)}.story-grid p{margin:0;font-size:.8rem;line-height:1.65;color:#313632;white-space:pre-wrap}.email-card{display:flex;justify-content:space-between;align-items:center;gap:1rem;padding:1rem 1.1rem}.email-card>div{display:flex;align-items:center;gap:.75rem}.email-card-icon{width:34px;height:34px;border-radius:10px;background:#f0eee8;display:grid;place-items:center;font-size:.8rem}.email-card strong{display:block;font-size:.78rem}.email-card p{margin:.18rem 0 0;font-size:.67rem;color:rgba(20,24,22,.48)}.preference-status{font-size:.63rem;font-weight:700;padding:.38rem .6rem;border-radius:999px;background:#edf3ed;color:#4a654e}.preference-status.off{background:#f4eded;color:#765151}
    .loading-state,.empty-state{text-align:center;padding:4rem 1rem;color:rgba(20,24,22,.48)}.empty-state{display:grid;gap:.35rem}.empty-state strong{color:#252a27}
    .edit-overlay,.merge-overlay{position:fixed;inset:0;z-index:2000}.edit-overlay[hidden],.merge-overlay[hidden]{display:none}.edit-backdrop,.merge-backdrop{position:absolute;inset:0;background:rgba(18,21,19,.46);backdrop-filter:blur(5px)}.edit-drawer{position:absolute;right:0;top:0;height:100%;width:min(720px,100%);background:#f5f4f0;box-shadow:-18px 0 55px rgba(0,0,0,.16);display:flex;flex-direction:column}.drawer-header{padding:1.7rem 1.8rem 1.35rem;background:#fff;border-bottom:1px solid rgba(20,24,22,.08);display:flex;justify-content:space-between;gap:1rem}.drawer-header h2{margin:.08rem 0 .2rem;font-size:1.35rem;letter-spacing:-.025em}.drawer-header p:last-child{margin:0;font-size:.72rem;color:rgba(20,24,22,.48)}.icon-button{border:1px solid rgba(20,24,22,.09);background:#fff;width:38px;height:38px;border-radius:11px;font-size:1.35rem;line-height:1;cursor:pointer;color:rgba(20,24,22,.55);flex:none}.drawer-form{overflow:auto;padding:1.3rem 1.5rem 1.5rem;display:grid;gap:1rem}.drawer-section,.email-setting{background:#fff;border:1px solid rgba(20,24,22,.08);border-radius:15px;padding:1.2rem}.drawer-section-title{display:flex;gap:.75rem;align-items:center;padding-bottom:.9rem;margin-bottom:1rem;border-bottom:1px solid rgba(20,24,22,.07)}.drawer-section-title>span{font-size:.63rem;font-weight:800;letter-spacing:.08em;color:rgba(20,24,22,.36)}.drawer-section-title div{display:grid;gap:.15rem}.drawer-section-title strong{font-size:.8rem}.drawer-section-title small{font-size:.66rem;color:rgba(20,24,22,.45)}.form-grid{display:grid;gap:.85rem}.form-grid.two{grid-template-columns:1fr 1fr}.drawer-section label{display:grid;gap:.4rem;font-size:.64rem;font-weight:700;color:rgba(20,24,22,.58);margin-top:.85rem}.form-grid label{margin-top:0}.drawer-section input,.drawer-section textarea{width:100%;box-sizing:border-box;border:1px solid rgba(20,24,22,.14);border-radius:12px;background:#fafaf9;padding:.78rem .8rem;font:inherit;font-size:.82rem;color:#252a27;outline:none;box-shadow:0 1px 2px rgba(20,24,22,.025);transition:.15s}.drawer-section input{height:46px}.drawer-section input:focus,.drawer-section textarea:focus{border-color:rgba(20,24,22,.35);box-shadow:0 0 0 4px rgba(20,24,22,.05);background:#fff}.drawer-section textarea{min-height:118px;resize:vertical;line-height:1.55}.email-setting{padding:.95rem 1rem}.toggle-row{display:grid;grid-template-columns:0 30px 1fr;align-items:start;gap:.7rem;cursor:pointer}.toggle-row input{position:absolute;opacity:0}.toggle-ui{width:30px;height:18px;border-radius:999px;background:#d5d5d1;position:relative;margin-top:1px}.toggle-ui:after{content:'';position:absolute;left:3px;top:3px;width:12px;height:12px;border-radius:50%;background:#fff;box-shadow:0 1px 3px rgba(0,0,0,.15);transition:.2s}.toggle-row input:checked+.toggle-ui{background:#5b655d}.toggle-row input:checked+.toggle-ui:after{transform:translateX(12px)}.toggle-row strong{display:block;font-size:.76rem}.toggle-row small{display:block;margin-top:.2rem;font-size:.66rem;line-height:1.4;color:rgba(20,24,22,.48)}.drawer-footer{position:sticky;bottom:0;margin:0 -1.5rem -1.5rem;padding:1rem 1.5rem;background:rgba(245,244,240,.97);border-top:1px solid rgba(20,24,22,.08);display:flex;align-items:center;justify-content:flex-end;gap:.6rem}.drawer-footer #save-result{margin-right:auto;font-size:.68rem;color:rgba(20,24,22,.5)}
