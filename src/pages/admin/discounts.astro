---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAdminRequest } from '../../lib/server';
if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
---
<BaseLayout title="Personal Discounts | Healing the Heart Admin">
  <main class="discount-admin">
    <header class="head"><div><p class="eyebrow">Registration support</p><h1>Personal discounts</h1><p>Create a discount code that only works for one attendee profile.</p></div><a class="button outline" href="/admin">← Dashboard</a></header>
    <section class="panel">
      <h2>Create a discount</h2>
      <form id="form">
        <label>Attendee<select id="student" name="studentId" required><option value="">Loading people…</option></select></label>
        <div class="grid"><label>Discount percentage<input name="percentOff" type="number" min="1" max="100" step="1" value="25" required /></label><label>Code<input name="code" required placeholder="SARAH25" /></label></div>
        <div class="grid"><label>Starts at (optional)<input name="startsAt" type="datetime-local" /></label><label>Expires at (optional)<input name="expiresAt" type="datetime-local" /></label></div>
        <label>Maximum uses (optional)<input name="maxUses" type="number" min="1" step="1" placeholder="Unlimited if blank" /></label>
        <button class="button primary" type="submit">Create discount</button><p id="result" role="status"></p>
      </form>
    </section>
    <section class="panel"><h2>Existing discounts</h2><div id="rows">Loading…</div></section>
  </main>
  <script is:inline>
    const form=document.querySelector('#form'),student=document.querySelector('#student'),rows=document.querySelector('#rows'),result=document.querySelector('#result');
    const safe=v=>String(v??'').replace(/[<>]/g,'');
    async function load(){const a=await fetch('/api/admin/attendees');const d=await a.json();student.innerHTML='<option value="">Choose attendee…</option>'+(d.students||[]).map(s=>`<option value="${safe(s.id)}">${safe(s.name)} — ${safe(s.email)}</option>`).join('');const r=await fetch('/api/admin/discounts');const g=await r.json();rows.innerHTML=(g.discounts||[]).map(d=>`<div class="row"><strong>${safe(d.code)} · ${d.percent_off}% off</strong><span>${safe(d.student_name)} — ${safe(d.student_email)}</span><small>${d.class_title?safe(d.class_title):'All classes'} · ${d.active?'Active':'Inactive'} · Used ${d.used_count||0}${d.expires_at?' · Expires '+safe(d.expires_at):''}</small><button class="button small" data-id="${safe(d.id)}" data-active="${d.active?0:1}">${d.active?'Deactivate':'Activate'}</button></div>`).join('')||'<p>No discounts created yet.</p>';}
    form.addEventListener('submit',async e=>{e.preventDefault();result.textContent='Saving…';const d=Object.fromEntries(new FormData(form));const r=await fetch('/api/admin/discounts',{method:'POST',headers:{'content-type':'application/json'},body:JSON.stringify(d)});const x=await r.json();if(r.ok){result.textContent='Discount created.';form.reset();form.elements.percentOff.value=25;await load()}else result.textContent=x.error||'Unable to create discount.'});
    rows.addEventListener('click',async e=>{const b=e.target.closest('button[data-id]');if(!b)return;b.disabled=true;const r=await fetch('/api/admin/discounts',{method:'PATCH',headers:{'content-type':'application/json'},body:JSON.stringify({id:b.dataset.id,active:b.dataset.active==='1',percentOff:25})});if(!r.ok)alert('Unable to update discount.');await load();});load();
  </script>
  <style>
    .discount-admin{max-width:950px;margin:0 auto;padding:3rem 1rem}.head{display:flex;justify-content:space-between;gap:1rem;align-items:start;margin-bottom:2rem}.panel{padding:2rem;border:1px solid var(--line,#ddd);border-radius:24px;background:#fff;box-shadow:0 15px 45px rgba(0,0,0,.05);margin-bottom:1.5rem}.panel h2{margin-top:0}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem}label{display:grid;gap:.35rem;margin:1rem 0;font-weight:600}input,select{font:inherit;padding:.75rem;border:1px solid #ccd1cb;border-radius:10px}.row{display:grid;gap:.2rem;padding:1rem 0;border-bottom:1px solid #e5e8e3}.row span,.row small{color:#68706a}.row small{font-size:.85rem}.button.small{justify-self:start;margin-top:.55rem;padding:.45rem .75rem;font-size:.8rem}@media(max-width:700px){.head{display:grid}.grid{grid-template-columns:1fr}.panel{padding:1.2rem}}
  </style>
</BaseLayout>
