---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { isAdminRequest } from '../../lib/server';
if (!(await isAdminRequest(Astro.request))) return Astro.redirect('/admin-login');
---
<BaseLayout title="Email | Healing the Heart Admin">
  <section class="admin-shell">
    <div class="admin-header">
      <div>
        <p class="eyebrow">Administration · Communication</p>
        <h1>Email</h1>
        <p>Send welcome messages, contact classes, and manage Healing the Heart email.</p>
      </div>
      <a class="button outline" href="/admin">← Dashboard</a>
    </div>
    <div class="email-sender">
      <span aria-hidden="true">✉</span>
      <div><strong>Healing the Heart &lt;info@healingtheheart.ca&gt;</strong><small>Replies are forwarded to healingtheheartca@gmail.com</small></div>
    </div>

    <section class="admin-section">
      <div class="admin-section-title"><div><p class="eyebrow">Welcome &amp; class messages</p><h2>Send a saved email to a class</h2><p>Choose a class and a saved welcome or follow-up template. Only registered students receive this message.</p></div></div>
      <form id="class-mail-form" class="admin-form">
        <div class="form-grid">
          <label>Class <select id="mail-class" required><option value="">Loading classes…</option></select></label>
          <label>Email template <select id="mail-template" required><option value="">Loading templates…</option></select></label>
        </div>
        <div class="email-preview" id="email-preview" aria-live="polite"><p>Select a template to preview its subject and message.</p></div>
        <button type="submit" class="button primary" id="mail-send" disabled>Review &amp; send to class</button>
        <p class="field-note" id="mail-result" role="status" aria-live="polite"></p>
      </form>
    </section>

    <div class="email-options">
      <a class="admin-action" href="/admin/attendees"><span>◎</span><div><strong>Email one person</strong><small>Select an attendee and send a personal message or template.</small></div><b>→</b></a>
      <a class="admin-action" href="/admin/blast-email"><span>✉</span><div><strong>Broadcast email</strong><small>Compose an email to attendees who have not opted out.</small></div><b>→</b></a>
      <a class="admin-action" href="/admin/templates"><span>✎</span><div><strong>Email templates</strong><small>Edit welcome messages, reminders, and custom templates.</small></div><b>→</b></a>
      <a class="admin-action" href="/admin/email-history"><span>↗</span><div><strong>Email history</strong><small>Review messages accepted by the provider and sending failures.</small></div><b>→</b></a>
    </div>
  </section>
  <script is:inline>
    const cls = document.querySelector('#mail-class');
    const tmpl = document.querySelector('#mail-template');
    const preview = document.querySelector('#email-preview');
    const result = document.querySelector('#mail-result');
    const form = document.querySelector('#class-mail-form');
    const send = document.querySelector('#mail-send');
    let templates = [];
    let classes = [];
    function drawPreview() {
      const t = templates.find(t => t.id === tmpl.value);
      preview.replaceChildren();
      if (!t) { preview.textContent = 'Select a template to preview its subject and message.'; return; }
      const title = document.createElement('strong');
      title.textContent = t.subject;
      const body = document.createElement('p');
      body.textContent = t.body;
      preview.append(title, body);
    }
    async function loadOptions() {
      try {
        const responses = await Promise.all([fetch('/api/admin/classes'), fetch('/api/admin/templates')]);
        if (responses.some(r => r.status === 401)) { location.href = '/admin-login'; return; }
        if (responses.some(r => !r.ok)) throw new Error('Unable to load classes or templates.');
        const [classData, templateData] = await Promise.all(responses.map(r => r.json()));
        classes = classData.classes || [];
        templates = templateData.templates || [];
        cls.replaceChildren(new Option('Select a class', ''));
        tmpl.replaceChildren(new Option('Select a template', ''));
        classes.forEach(c => cls.add(new Option(c.title + ' (' + Number(c.student_count || 0) + ' on roster)', c.id)));
        templates.forEach(t => tmpl.add(new Option(t.name, t.id)));
        if (templates.some(t => t.id === 'eight-week-class-details')) tmpl.value = 'eight-week-class-details';
        send.disabled = !classes.length || !templates.length;
        drawPreview();
        if (!classes.length) result.textContent = 'Create a class first to send welcome emails.';
      } catch (error) {
        result.textContent = error.message || 'Unable to load email options.';
      }
    }
    tmpl.addEventListener('change', drawPreview);
    form.addEventListener('submit', async event => {
      event.preventDefault();
      const selectedClass = classes.find(c => c.id === cls.value);
      const selectedTemplate = templates.find(t => t.id === tmpl.value);
      if (!selectedClass || !selectedTemplate) { result.textContent = 'Choose a class and template.'; return; }
      if (!confirm('Send "' + selectedTemplate.name + '" to all registered students in "' + selectedClass.title + '"?')) return;
      send.disabled = true;
      result.textContent = 'Sending class email…';
      try {
        const response = await fetch('/api/admin/send-email', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ classId: selectedClass.id, templateId: selectedTemplate.id })
        });
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'Unable to send.');
        result.textContent = 'Finished: ' + data.sentCount + ' sent, ' + data.failedCount + ' failed. See Email History for details.';
      } catch (error) {
        result.textContent = error.message || 'Could not send the email.';
      } finally {
        send.disabled = false;
      }
    });
    loadOptions();
  </script>
  <style>
    .email-sender{display:flex;align-items:center;gap:.85rem;padding:1rem 1.2rem;background:#f4f7f4;border:1px solid #dce8dc;border-radius:15px;margin:1.1rem 0 1.5rem}
    .email-sender>span{font-size:1.8rem;color:#376c56}
    .email-sender strong,.email-sender small{display:block}
    .email-sender small{color:#566b60;font-size:.84rem;margin-top:.15rem;overflow-wrap:anywhere}
    .email-sender strong{overflow-wrap:anywhere}
    .email-preview{padding:1rem 1.1rem;background:#fff;border:1px solid #e4e9e2;border-radius:13px;max-height:280px;overflow:auto;line-height:1.6;margin-bottom:1rem}
    .email-preview strong{display:block;margin-bottom:.6rem}
    .email-preview p{white-space:pre-wrap;font-size:.92rem;margin:0;color:#46534c}
    .email-options{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:1rem;margin-top:1.5rem}
    .email-options .admin-action{position:relative;min-height:120px;padding:1.2rem 3rem 1.2rem 1.2rem}
    .email-options .admin-action b{position:absolute;right:1rem;top:45%}
    @media(max-width:700px){.email-options{grid-template-columns:1fr}.email-sender{align-items:flex-start}}
  </style>
</BaseLayout>
